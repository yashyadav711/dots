# vimb — dedicated lightweight browser for the NetrunnersHQ dashboard.
#
# COMMENTS USE '#'. vimb does NOT accept '"' — it reports every such line as an
# invalid command. Learned the hard way 2026-08-21.
#
# WHY VIMB: measured, not assumed. "Lightweight browser" is mostly a label —
# qutebrowser and falkon both depend on qt6-webengine, which IS Chromium, so they
# buy nothing over the Chromium already installed. Epiphany is genuinely lighter
# (WebKitGTK) but its current build needs GLIBC_2.44 against this system's 2.43,
# so it cannot start until a full -Syu. vimb uses webkit2gtk-4.1, already
# installed and glibc-compatible. Numbers, same page and same method (PSS across
# the whole process tree): vimb 230 MB / 3 procs vs chromium --app 242 MB / 9.
# The RAM win is ~5%; the real win is 3 processes and a chromeless window.
#
# KEY DESIGN: Yash asked for doubled letters (dd ii yy qq …). That works even
# where the single letter is a vimb default — verified by test: with `r` still
# bound to reload, a `nnoremap rr` still fired, so vimb waits for the sequence
# rather than firing the single key immediately. So the doubled maps below do NOT
# require unmapping their first letter.

# ── what it opens ────────────────────────────────────────────────────────────
set home-page=http://192.168.31.70:3900/

# Downloads land where the LAN inbox reads from, not in a scratch dir.
set download-path=~/Github/nhq-local-downloads

# ── looks ────────────────────────────────────────────────────────────────────
# Both bars off: the window is nothing but page. `status-bar` is the bottom-left
# URL readout — note the name, `statusbar` is silently rejected.
set status-bar=off
set input-autohide=on
set dark-mode=on
set default-zoom=100

# ── behaviour ────────────────────────────────────────────────────────────────
# The JS setting is `scripts`, NOT `javascript` — the latter is silently rejected
# and on a JS dashboard that means a blank box.
set scripts=on
set cookie-accept=always
set smooth-scrolling=on
set media-playback-requires-user-gesture=on
set webinspector=off
set history-max-items=500

# Home-row hint keys. Kept even though the f/F hint keys are unmapped below, so
# that turning hints back on needs one line, not two.
set hint-keys=asdfghjkl

# Spatial navigation is OFF: it makes the arrow keys move focus between elements,
# which would fight the arrow-key scrolling Yash asked for.
set spatial-navigation=off

# ── removed defaults ─────────────────────────────────────────────────────────
# Yash's call, 2026-08-21. Note what this costs: with f and F gone there is no
# keyboard way to click a link — that needs the mouse now. One line brings it back.
nunmap f
nunmap F
nunmap t
nunmap T
nunmap gh
nunmap ^
nunmap y
nunmap p
nunmap P
nunmap d
nunmap m
nunmap '
nunmap <C-d>
nunmap <C-u>
nunmap <C-f>
nunmap <C-b>
nunmap %

# ── go ───────────────────────────────────────────────────────────────────────
nnoremap dd :open http://192.168.31.70:3900/<CR>
nnoremap ii :open http://192.168.31.70:3900/inbox<CR>

# nn = new window with a URL prompt. `:tabopen` is the command that opens one;
# vimb has no tabs, so "tab" here means a new window.
nnoremap nn :tabopen<Space>

# History. Mapped to the default H/L keys rather than commands, because vimb has
# no :back/:forward commands — the whole command list was checked.
nnoremap kk H
nnoremap ll L

# Reload. Same reason: there is NO :reload command in vimb at all, only these
# keys. This is what my earlier `:reload!` map got wrong.
nnoremap rr r
nnoremap RR R

# ── scroll ───────────────────────────────────────────────────────────────────
# Arrows delegate to the default j/k/h/l, which stay bound so these have
# something to delegate TO. Page Up / Page Down are NOT bindable — vimb accepts
# only Left Up Right Down Tab Esc CR Space BS F1-F12 and Ctrl+A-Z.
nnoremap <Down> j
nnoremap <Up> k
nnoremap <Left> h
nnoremap <Right> l

# ── zoom ─────────────────────────────────────────────────────────────────────
nnoremap ++ zi
nnoremap __ zo
nnoremap == zI
nnoremap -- zO

# Reset both zooms in one press. A multi-key rhs is legal and was verified.
nnoremap 00 zzzZ

# ── do ───────────────────────────────────────────────────────────────────────
# yy copies the URL. `y` itself is unmapped above so this is the only yank.
nnoremap yy :shellcmd echo -n $VIMB_URI | wl-copy<CR>

# kb = this keybinding list, as a floating popup. `:sh!` is the ASYNC form, so
# vimb does not block while it is open. `less` quits on q with no extra binding,
# which is exactly the behaviour Yash asked for. Floating/centred is handled by a
# windowrule on class `vimb-keys` in dots/hypr/userprefs.conf.
nnoremap kb :shellcmd! kitty --class vimb-keys -e less -R ~/Github/dots/vimb/keybindings.txt<CR>

# ── close ────────────────────────────────────────────────────────────────────
# Both do the same thing, deliberately: vimb has one window per page, so closing
# the window IS quitting. Yash asked for both names.
nnoremap xx :quit<CR>
nnoremap qq :quit<CR>
