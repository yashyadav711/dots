/* iOS Spotlight — rofi-wayland. Hyprland blur is active on namespace `rofi`
   (windowrules.conf:97-98); the low window alpha below is what makes it frosted. */
configuration {
    display-drun:         "🔍";
    drun-display-format:  "{name}";
}

* {
    font:                "SF Pro Display 13";
    text-color:          #ffffffee;
    background-color:    transparent;
}

window {
    location:            center;
    anchor:              center;
    width:               640px;
    border-radius:       22px;
    border:              1px;
    border-color:        #ffffff26;
    background-color:    #1c1c1e99;
    padding:             8px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, listview ];
    padding:             0px;
    spacing:             8px;
}

inputbar {
    background-color:    #ffffff1a;
    border-radius:       14px;
    padding:             12px 16px;
    spacing:             12px;
    children:            [ prompt, entry ];
}

prompt {
    enabled:             true;
    font:                "JetBrainsMono Nerd Font 15";
    text-color:          #ffffff8c;
    vertical-align:      0.5;
}

entry {
    background-color:    transparent;
    text-color:          #ffffffee;
    placeholder:         "Search";
    placeholder-color:   #ffffff73;
    cursor:              text;
    vertical-align:      0.5;
}

listview {
    background-color:    transparent;
    padding:             4px 4px 0px 4px;
    spacing:             3px;
    lines:               6;
    columns:             1;
    scrollbar:           false;
    dynamic:             true;
    require-input:       false;   /* show apps on open (no blank box); typing filters */
}

element {
    background-color:    transparent;
    border-radius:       12px;
    padding:             10px 12px;
    spacing:             12px;
    children:            [ element-icon, element-text ];
    orientation:         horizontal;
}

element normal.normal    { background-color: transparent; text-color: #ffffffee; }
element alternate.normal { background-color: transparent; text-color: #ffffffee; }
element selected.normal  { background-color: #ffffff26;   text-color: #ffffff;   }

element-icon {
    size:                26px;
    background-color:    transparent;
    vertical-align:      0.5;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    vertical-align:      0.5;
}
