#!/usr/bin/env bash
# nhq-tell <session|agent> "<message>" — message a running agent mid-task.
#
# Types the message into the live TUI via tmux send-keys (literal), then presses
# Enter. This is how Director/Yash redirect an agent without killing it.
#
# Usage: nhq-tell fleet-heydaddy-add-retry "actually, cap retries at 3"
#        nhq-tell nv "check the vox selftest"
#
# It takes an AGENT NAME as well as a session name (2026-08-13), because the
# caller usually knows who it wants, not which tmux session that person happens
# to be sitting in — and there are two naming schemes in play:
#   fleet-<agent>-<task>   spawned task sessions (nhq-spawn)
#   omp-<dirslug>          Yash's own interactive sessions (ompt)
# Names and aliases come from fleet-registry.json, so `nv`, `envy`, `dir`,
# `builder` all land where you would expect. An exact session name still wins,
# so every existing caller is untouched.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
# shellcheck source=/dev/null
source "$(dirname "$SELF")/nhq-lib.sh"

TARGET="${1:-}"
MESSAGE="${2:-}"

# --where resolves and prints the session without sending anything. The inbox
# web UI uses it to show who is actually live before you type at them, and it
# means the slug rule below has exactly one implementation rather than a second
# copy in Python.
WHERE=0
if [[ "$TARGET" == "--where" ]]; then WHERE=1; TARGET="${2:-}"; MESSAGE="-"; fi

if [[ -z "$TARGET" || -z "$MESSAGE" ]]; then
  echo "usage: nhq-tell <session|agent> \"<message>\"" >&2
  echo "       nhq-tell --where <session|agent>" >&2
  exit 1
fi

# The slug ompt builds from a repo directory. Kept character-for-character in
# step with dots/bin/ompt — if that expression changes, this one must too.
ompt_slug() { basename "$1" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-\+$//'; }

# Every string that can name an agent in a window or pane label: its registry
# key, its aliases, and its repo's BASENAME. The basename earns its place on its
# own — a pane sitting in Github/nhq-agentic-os is Director's, and
# "nhq-agentic-os" is neither his key nor one of his aliases.
AGENT_TOKENS=""
load_agent_tokens() {
  [[ -n "$AGENT_TOKENS" ]] && return 0
  AGENT_TOKENS="$(jq -r '
    .agents | to_entries[] | .key as $k
    | ([$k] + (.value.aliases // []) + [ (.value.repo // "") | split("/") | last ])[]
    | select(. != null and . != "")
    | "\(ascii_downcase)\t\($k)"
  ' "$(nhq_registry)" 2>/dev/null)"
}

# Registry key for a single label token; "" when the token names nobody.
token_agent() {
  local t="${1,,}"
  [[ -z "$t" ]] && { printf ''; return 0; }
  load_agent_tokens
  awk -F'\t' -v t="$t" '$1 == t { print $2; exit }' <<<"$AGENT_TOKENS"
}

# Which agent is sitting in this window/pane, judged by the LABEL Yash reads in
# the status bar? "" when the labels name nobody.
#
# The label is the primary signal on purpose, and the SESSION NAME is deliberately
# not consulted. A tmux session belongs to the operator, not to the fleet: the
# envy seat is a window called `envy` inside a hand-made session called `nHQ`,
# and `nHQ` is DIRECTOR's name — so anything reasoning from the session name
# hands NV's mail to Director. omp sets the window name from the repo it opened
# ("envy"), which is clean, and repeats it at the end of the pane title.
pane_agent() {
  local win="${1:-}" title="${2:-}" hit
  hit="$(token_agent "$win")"
  [[ -n "$hit" ]] && { printf '%s' "$hit"; return 0; }
  # The title is "<spinner> π - <name>" and, while the agent is working,
  # "<spinner> π - <task text> - <name>". The name is always the final " - "
  # segment, so take exactly that instead of scanning every word — a task called
  # "fix the build" must never resolve to Builder.
  printf '%s' "$(token_agent "${title##*- }")"
}

# Where should keys for <token> be typed? Prints a tmux target — a PANE when the
# labels identify one, otherwise a session name.
resolve_target() {
  local tok="$1" key target win title owner slug hit

  key="$(nhq_agent_canon "$tok")"

  # A token that names NO agent can only be a literal tmux target, and a caller
  # that spelled out a session (nhq-spawn's `fleet-…`, `omp-…`) must never be
  # second-guessed by a registry lookup.
  #
  # An AGENT name, though, is never matched against session names — that is the
  # whole correction. `nHQ` is Director's name AND the name of the hand-made
  # session the envy seat happens to live in, so treating it as a session typed
  # Director's mail into NV's pane. An agent resolves to a pane that identifies
  # itself as that agent, or to nothing.
  if [[ -z "$key" ]]; then
    tmux has-session -t "$tok" 2>/dev/null && { printf '%s' "$tok"; return 0; }
    return 1
  fi

  # THE PANE'S OWN LABEL DECIDES, and the answer is a PANE rather than a session:
  # several agents run as separate windows inside one session here, so
  # `send-keys -t <session>` would land on whichever pane happened to be active.
  while IFS=$'\t' read -r target win title; do
    owner="$(pane_agent "$win" "$title")"
    [[ "$owner" == "$key" ]] && { printf '%s' "$target"; return 0; }
  done < <(tmux list-panes -a -F \
      '#{session_name}:#{window_index}.#{pane_index}'$'\t''#{window_name}'$'\t''#{pane_title}' \
      2>/dev/null)

  # A spawned task session carries the agent in its own name and may still be
  # showing a bare shell, so there the NAME is the better answer.
  hit="$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
         | grep -m1 -E "^fleet-${key}(-|$)" || true)"
  [[ -n "$hit" ]] && { printf '%s' "$hit"; return 0; }

  # Last: the session ompt would have built for this agent's own repo. Exact and
  # free, and derived from the agent's registry entry rather than guessed.
  slug="$(ompt_slug "$(nhq_agent_repo "$key")")"
  if [[ -n "$slug" ]] && tmux has-session -t "omp-$slug" 2>/dev/null; then
    printf 'omp-%s' "$slug"; return 0
  fi
  return 1
}

# Remote agents live on another machine's tmux server, so resolve_target here
# could never find them. Dispatch the same command over ssh first. Placed before
# resolution so we never print a misleading "nothing live for: rig".
nhq_remote_dispatch "$TARGET" nhq-tell "$@" || true

DEST="$(resolve_target "$TARGET" || true)"

if [[ -z "$DEST" ]]; then
  echo "nhq-tell: nothing live for: $TARGET" >&2
  echo "  live panes   : $(tmux list-panes -a -F '#{window_name}' 2>/dev/null | paste -sd', ' -)" >&2
  echo "  known agents : $(jq -r '.agents | keys | join(", ")' "$(nhq_registry)" 2>/dev/null)" >&2
  exit 1
fi

if [[ "$WHERE" == "1" ]]; then
  echo "$DEST"
  exit 0
fi

tmux send-keys -t "$DEST" -l -- "$MESSAGE"
sleep 0.3
tmux send-keys -t "$DEST" Enter

# Talking to an agent counts as activity — keep the reaper off its back. The
# marker is per SESSION, so strip the window.pane suffix off a pane target.
nhq_touch_activity "${DEST%%:*}"

echo "sent to $DEST: $MESSAGE"
