#!/usr/bin/env bash
# nhq-resolve <agent> — find a fleet box's CURRENT ip and pin it for ssh.
#
# The problem this fixes: `ssh rig` intermittently died with
#   ssh: Could not resolve hostname rig.local: Temporary failure in name resolution
# even though the box was up and reachable by ip. Cause: this laptop's
# /etc/nsswitch.conf has no mdns entry —
#   hosts: mymachines resolve [!UNAVAIL=return] files myhostname dns
# so `rig.local` only resolves when systemd-resolved happens to answer for mDNS,
# which it does inconsistently. Adding nss-mdns to nsswitch is the proper fix but
# needs root on this laptop; `avahi-resolve` talks to the avahi daemon directly,
# bypasses nsswitch entirely, and answers reliably.
#
# What it does: resolves the ip, verifies port 22 actually answers, then writes
#   ~/.ssh/config.d/10-<agent>.conf   ->   Host <agent> / HostName <ip>
# ssh keeps the FIRST HostName it obtains, and ~/.ssh/config includes that
# directory ABOVE the Host block, so the freshly-resolved ip wins and the
# `.local` name in the main config stays as a last resort.
#
# Prints the ip on success. Safe to run often; it is cheap when the cache is warm.
set -uo pipefail

AGENT="${1:?usage: nhq-resolve <agent> [--quiet]}"
QUIET=0; [[ "${2:-}" == --quiet ]] && QUIET=1
CONF_DIR="$HOME/.ssh/config.d"
CONF="$CONF_DIR/10-$AGENT.conf"
PORT=22

log() { (( QUIET )) || printf '%s\n' "$*" >&2; }
alive() { timeout 3 bash -c "echo >/dev/tcp/$1/$PORT" 2>/dev/null; }

cached=""
[[ -f $CONF ]] && cached=$(awk '/HostName/{print $2; exit}' "$CONF" 2>/dev/null)

# 1. Warm cache. Skip every lookup when the box is still where we last saw it.
if [[ -n $cached ]] && alive "$cached"; then
  log "cached: $cached"
  printf '%s\n' "$cached"; exit 0
fi

ip=""

# 2. avahi directly — the reliable path, independent of nsswitch.
if command -v avahi-resolve >/dev/null; then
  ip=$(timeout 8 avahi-resolve -n "$AGENT.local" 2>/dev/null | awk '{print $2; exit}')
  [[ -n $ip ]] && log "avahi: $ip"
fi

# 3. nsswitch, in case it is wired on this machine.
if [[ -z $ip ]]; then
  ip=$(getent hosts "$AGENT.local" 2>/dev/null | awk '{print $1; exit}')
  [[ -n $ip ]] && log "getent: $ip"
fi

# 4. Tailscale — works from anywhere, not just this LAN.
if [[ -z $ip ]] && command -v tailscale >/dev/null; then
  ip=$(tailscale status --json 2>/dev/null \
       | jq -r --arg a "$AGENT" '.Peer[]? | select(.HostName==$a) | .TailscaleIPs[0] // empty' 2>/dev/null | head -1)
  [[ -n $ip ]] && log "tailscale: $ip"
fi

# 5. Stale cache, unverified — better than nothing if every lookup failed.
if [[ -z $ip && -n $cached ]]; then
  log "all lookups failed; keeping the stale cache $cached"
  printf '%s\n' "$cached"; exit 0
fi

[[ -n $ip ]] || { log "nhq-resolve: cannot find $AGENT (is it powered on?)"; exit 1; }

if ! alive "$ip"; then
  log "nhq-resolve: $AGENT resolves to $ip but port $PORT is not answering"
  exit 1
fi

# Pin it. Written atomically so a half-written include can never break ssh.
mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR"
tmp=$(mktemp)
cat >"$tmp" <<EOF
# Generated by nhq-resolve $(date -Is). Do not edit — rewritten on every resolve.
# ssh keeps the FIRST HostName it obtains, and this file is Included above the
# Host block in ~/.ssh/config, so this pinned ip wins over the .local name.
Host $AGENT
    HostName $ip
EOF
chmod 600 "$tmp"; mv "$tmp" "$CONF"
log "pinned $AGENT -> $ip"
printf '%s\n' "$ip"
