#!/usr/bin/env bash
# nhq-venice-watch — warn BEFORE the Venice balance silences the bot.
#
# Why this exists (2026-08-01):
#   Railway dev and production share ONE Venice API key and therefore ONE
#   balance. That balance was $3.82. The per-account daily cost cap defaults
#   to $5.00 — larger than the entire remaining balance — so the cap cannot
#   protect it. Dev is now capped at $0.50/day, but nothing watched the
#   balance itself.
#
#   When it reaches zero the API returns accessPermitted:false and the bot
#   simply stops replying. No error page, no alert, no deploy failed. A fan
#   messages a creator and gets silence. That is the failure this prevents.
#
#   Topping up is not a quick fix: it goes through Julián and then Ruben, so
#   the warning has to arrive with days of runway left, not hours.
#
# Usage:
#   nhq-venice-watch            # check, notify only if low
#   nhq-venice-watch --always   # check and always print + notify
#   nhq-venice-watch --quiet    # exit code only, no notification
#
# Exit: 0 healthy · 1 warning · 2 critical · 3 could not check

set -uo pipefail

WARN_USD="${NHQ_VENICE_WARN_USD:-2.00}"
CRIT_USD="${NHQ_VENICE_CRIT_USD:-0.75}"
# Measured 2026-08-01: 1.41 Venice calls per reply, ~$0.0017 per reply.
# See ai/COST_PER_MESSAGE_MEASUREMENT_2026-08-01.md in the heydaddy repo.
USD_PER_REPLY="${NHQ_VENICE_USD_PER_REPLY:-0.0017}"

ALWAYS=0; QUIET=0
for a in "$@"; do
  case "$a" in
    --always) ALWAYS=1 ;;
    --quiet)  QUIET=1 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
  esac
done

notify() {  # notify <type> <title> <body>
  (( QUIET )) && return 0
  command -v nhq-notify >/dev/null 2>&1 && nhq-notify "$1" "$2" "$3" || true
}

# The key is read from Railway so this always checks the key production is
# ACTUALLY using, not a stale copy in a local .env. That distinction matters:
# every local .env in this workspace holds a dead key, and reading one of
# those would have reported a false outage.
PROJECT="${NHQ_HEYDADDY_PROJECT:-0a52cb6e-d0da-49d2-b608-ea1fa6b4c68f}"
KEY="$(timeout 60 railway variables \
        --project "$PROJECT" --environment production --service heydaddy --kv 2>/dev/null \
        | sed -n 's/^VENICE_API_KEY=//p' | head -1)"

if [[ -z "$KEY" ]]; then
  echo "venice-watch: could not read VENICE_API_KEY from Railway (not logged in?)" >&2
  notify warden "⚠️ Venice balance unknown" "Could not read the key from Railway — check is not running."
  exit 3
fi

RESP="$(curl -fsS --max-time 30 -H "Authorization: Bearer $KEY" \
        https://api.venice.ai/api/v1/api_keys/rate_limits 2>/dev/null)" || {
  echo "venice-watch: Venice API unreachable" >&2
  notify warden "⚠️ Venice unreachable" "Balance check failed — the bot may be fine, the check is not."
  exit 3
}

read -r USD ACCESS <<<"$(printf '%s' "$RESP" | python3 -c '
import json,sys
d = json.load(sys.stdin).get("data", {})
print(d.get("balances", {}).get("USD", "nan"), d.get("accessPermitted"))
' 2>/dev/null)"

[[ -z "${USD:-}" || "$USD" == "nan" ]] && { echo "venice-watch: unparseable response" >&2; exit 3; }

REPLIES="$(python3 -c "print(int(max(0,float('$USD'))/float('$USD_PER_REPLY')))" 2>/dev/null || echo "?")"
LINE="\$$(printf '%.2f' "$USD") left · ~${REPLIES} replies · dev+prod SHARE this balance"

# accessPermitted:false means the bot is ALREADY silent — that is not a warning.
if [[ "$ACCESS" != "True" ]]; then
  echo "CRITICAL: Venice access DENIED — the bot is not replying. $LINE"
  notify needs-you "🔴 Venice is OUT — the bot is silent" \
    "accessPermitted=false. Every reply is failing right now. Top-up goes through Julián → Ruben, so start it immediately."
  exit 2
fi

if python3 -c "import sys; sys.exit(0 if float('$USD') < float('$CRIT_USD') else 1)"; then
  echo "CRITICAL: $LINE"
  notify needs-you "🔴 Venice almost out" \
    "$LINE. Top-up needs Julián → Ruben, which is slow — start it now, not when it hits zero."
  exit 2
fi

if python3 -c "import sys; sys.exit(0 if float('$USD') < float('$WARN_USD') else 1)"; then
  echo "WARNING: $LINE"
  notify warden "🟠 Venice balance low" \
    "$LINE. Top-up is a slow procedure (Julián → Ruben) — begin it while there is still runway."
  exit 1
fi

(( ALWAYS )) && { echo "OK: $LINE"; notify done "✅ Venice healthy" "$LINE"; }
exit 0
