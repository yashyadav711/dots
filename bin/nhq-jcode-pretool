#!/usr/bin/env bash
# nhq-jcode-pretool — jcode pre_tool gate adapter for the NHQ safety guards.
#
# jcode contract (crates/jcode-base/src/hooks.rs):
#   • tool input JSON arrives on STDIN; JCODE_HOOK_TOOL_NAME / JCODE_HOOK_CWD /
#     JCODE_HOOK_SESSION_ID describe the event.
#   • exit 0 = allow · exit 2 = block (stderr becomes the model-visible reason).
#   • Anything else (timeout, crash) FAILS OPEN — so keep this script fast and
#     simple, and raise [hooks] pre_tool_timeout_ms for the interactive approver.
#
# This adapter re-implements NO policy. It translates the jcode event into the
# Claude-style PreToolUse JSON the hardened NHQ guard binaries already speak,
# runs each one, and converts their deny-JSON into jcode's exit-2 contract:
#   1. dangerous-command-guard.sh  (Bash)  — dangerous/irreversible commands
#   2. nhq-p3-guard                (Bash)  — Protocol-3 commit gate
#   3. mcp-write-guard             (mcp_*) — Railway infra-mutation gate
#   4. fleet push/merge block      (Bash)  — port of the omp p3-guard.ts tier
#      rule: a FLEET-tier caller (NHQ_AGENT!=director or fleet-* session) is
#      hard-blocked from `git push` / `git merge`.
#   5. repo-local guard            (any)   — nearest `<repo>/.nhq/pre-tool-guard`
#      walking up from cwd, same contract as this script (exit 2 blocks). This
#      replaces omp's per-repo `.omp/hooks/pre/` (e.g. HeyDaddy prod backstop).
#
# Wiring: ~/.jcode/config.toml → [hooks] pre_tool = "~/.local/bin/nhq-jcode-pretool"
#         and pre_tool_timeout_ms = 90000 (the GUI approval prompt can take a while).
# Test:   printf '{"command":"eval x"}' | JCODE_HOOK_TOOL_NAME=bash nhq-jcode-pretool
set -uo pipefail

TOOL_RAW="${JCODE_HOOK_TOOL_NAME:-}"
CWD="${JCODE_HOOK_CWD:-$PWD}"
INPUT="$(cat 2>/dev/null || true)"
[[ -z "$TOOL_RAW" ]] && exit 0

# The NHQ guards match Claude Code's capitalized "Bash".
TOOL="$TOOL_RAW"
[[ "${TOOL_RAW,,}" == "bash" ]] && TOOL="Bash"

# ── Audit feed (chained audit.jsonl) ──────────────────────────────────────────
# jcode's post_tool observer does NOT export the tool input (only name/status),
# so the audit append happens HERE, where the input is available. Detached so it
# never slows the gate; nhq-jcode-audit filters to mutating surfaces and
# delegates the chained append to nhq-audit (single source of truth).
if [[ -x "$HOME/.local/bin/nhq-jcode-audit" ]]; then
  JCODE_HOOK_TOOL_INPUT="$INPUT" JCODE_HOOK_TOOL_NAME="$TOOL_RAW" \
    "$HOME/.local/bin/nhq-jcode-audit" >/dev/null 2>&1 &
  disown 2>/dev/null || true
fi

# Claude-style hook JSON the delegate guards expect.
HOOK_JSON="$(jq -cn --arg tn "$TOOL" --arg cwd "$CWD" \
  --argjson ti "${INPUT:-null}" \
  '{tool_name:$tn, tool_input:($ti // {}), cwd:$cwd}' 2>/dev/null || true)"
[[ -z "$HOOK_JSON" ]] && exit 0   # unparseable input → nothing to gate on

# run_guard <binary> — pipe HOOK_JSON through a Claude-style guard; convert a
# deny decision (JSON on stdout, or plain exit 1 with stderr) into exit 2.
run_guard() {
  local bin="$1" out rc reason
  [[ -x "$bin" ]] || return 0
  out="$(printf '%s' "$HOOK_JSON" | "$bin" 2>/dev/null)"; rc=$?
  if printf '%s' "$out" | grep -q '"permissionDecision"[[:space:]]*:[[:space:]]*"deny"'; then
    reason="$(printf '%s' "$out" | jq -r '.hookSpecificOutput.permissionDecisionReason // "blocked"' 2>/dev/null)"
    echo "${reason:-blocked by ${bin##*/}}" >&2
    exit 2
  fi
  # Guards normally exit 0 and carry the decision in JSON; a hard nonzero exit
  # from a guard that emitted no deny JSON is treated as allow (their contract).
  return 0
}

# ── 4. Fleet-tier push/merge block (port of omp p3-guard.ts BRANCHES-ONLY rule) ──
fleet_tier() {
  local agent="${NHQ_AGENT:-}" sess=""
  if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    sess="$(tmux display-message -p '#S' 2>/dev/null || true)"
  fi
  [[ "$sess" == fleet-* ]] && return 0
  [[ -n "$agent" && "${agent,,}" != "director" ]] && return 0
  return 1
}

if [[ "$TOOL" == "Bash" ]]; then
  CMD="$(printf '%s' "$HOOK_JSON" | jq -r '.tool_input.command // empty' 2>/dev/null)"
  if [[ -n "$CMD" ]] && fleet_tier; then
    # Neutralize quoted spans so a literal "git push" inside an echo can't false-fire.
    STRIPPED="$(printf '%s' "$CMD" | sed -e "s/'[^']*'/''/g" -e 's/"[^"]*"/""/g')"
    if printf '%s' "$STRIPPED" | grep -qE '(^|[;&|(`]|&&)[[:space:]]*(([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*)(sudo[[:space:]]+|command[[:space:]]+|exec[[:space:]]+|env[[:space:]]+)*([^[:space:]]*/)?git[[:space:]]+(-[^[:space:]]+[[:space:]]+)*(push|merge)([[:space:]]|$)'; then
      echo "BLOCKED (Protocol-3, fleet tier): git push/merge is branches-only for fleet agents — integration into main/remotes is Yash's keystroke. Report via nhq-done / nhq-blocked instead." >&2
      exit 2
    fi
  fi

  # ── 4b. Director-tier PROD push/merge gate (governance 2026-07-20) ──
  # Director is NOT fleet, so the fleet block above skips it. A Director push/merge
  # that targets a SCOPED prod repo's main/master (heydaddy/mirror) requires Yash's
  # "ok - Yash" signature token (nhq-approve verify). Dev/feature pushes + non-scoped
  # repos pass untouched. Fail-closed toward requiring the signature on ambiguous
  # prod-main targeting; NEVER gate dev/feature pushes.
  if [[ -n "$CMD" ]] && ! fleet_tier; then
    STRIPPED_D="$(printf '%s' "$CMD" | sed -e "s/'[^']*'/''/g" -e 's/"[^"]*"/""/g')"
    if printf '%s' "$STRIPPED_D" | grep -qE '(^|[;&|(`]|&&)[[:space:]]*(([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*)(sudo[[:space:]]+|command[[:space:]]+|exec[[:space:]]+|env[[:space:]]+)*([^[:space:]]*/)?git[[:space:]]+((-C[[:space:]]+[^[:space:]]+|--git-dir=[^[:space:]]+|-[^[:space:]]+)[[:space:]]+)*(push|merge)([[:space:]]|$)'; then
      GCTX="$CWD"
      _gc="$(printf '%s' "$CMD" | grep -oE -- '-C[[:space:]]+[^[:space:]]+' | head -1 | sed -E 's/^-C[[:space:]]+//')"
      [[ -n "$_gc" ]] && GCTX="$_gc"
      _base="$(basename "$(git -C "$GCTX" rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
      _origin="$(git -C "$GCTX" remote get-url origin 2>/dev/null | tr '[:upper:]' '[:lower:]')"
      _branch="$(git -C "$GCTX" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      _scoped=0; _repo="$_base"
      # CANONICALIZE to the scoped prod name (same origin/base match p3_scope uses) so a
      # token granted `--repo heydaddy` also covers a linked worktree dir (heydaddy-wt-*).
      if [[ "$_origin" == *yashyadav711/heydaddy* || "$_base" == heydaddy ]]; then _scoped=1; _repo=heydaddy
      elif [[ "$_origin" == *yashyadav711/mirror* || "$_base" == mirror ]]; then _scoped=1; _repo=mirror; fi
      if [[ $_scoped -eq 1 ]]; then
        _targets_main=0
        # merge → destination is the current branch
        if printf '%s' "$STRIPPED_D" | grep -qw merge; then
          [[ "$_branch" == main || "$_branch" == master ]] && _targets_main=1
        fi
        # push → main named as a ref, or a bare push while on main
        if printf '%s' "$STRIPPED_D" | grep -qw push; then
          printf '%s' "$STRIPPED_D" | grep -qE '(:|[[:space:]])(main|master)([[:space:]]|$)' && _targets_main=1
          if [[ "$_branch" == main || "$_branch" == master ]]; then
            printf '%s' "$STRIPPED_D" | grep -qE 'push[[:space:]]+[^[:space:]-][^[:space:]]*[[:space:]]+[^[:space:]-]' || _targets_main=1
          fi
        fi
        if [[ $_targets_main -eq 1 ]]; then
          _apbin="${NHQ_APPROVE_BIN:-$HOME/.local/bin/nhq-approve}"; [[ -x "$_apbin" ]] || _apbin="$(command -v nhq-approve 2>/dev/null || true)"
          if [[ -z "$_apbin" ]] || ! "$_apbin" verify --repo "$_repo" --target main >/dev/null 2>&1; then
            echo "BLOCKED (Protocol-3): prod push/merge to ${_repo}:main needs Yash's 'ok - Yash' signature. After 'ok - Yash', run: nhq-approve grant --repo ${_repo} --target main  (then retry)." >&2
            exit 2
          fi
        fi
      fi
    fi
  fi
  # 1 + 2. The Bash-scoped guards (each self-filters on tool_name).
  run_guard "$HOME/.claude/hooks/dangerous-command-guard.sh"
  run_guard "$HOME/.local/bin/nhq-p3-guard"
fi

# ── 3. MCP write gate (self-filters on mcp__*railway*; cheap for everything else) ──
case "${TOOL_RAW,,}" in
  mcp*) run_guard "$HOME/.local/bin/mcp-write-guard" ;;
esac

# ── 5. Repo-local guard: nearest .nhq/pre-tool-guard walking up from cwd ──
# Worktree coverage: a linked worktree (e.g. ~/Github/heydaddy-wt-*) lives
# OUTSIDE the main repo dir, so the cwd walk-up misses the repo's .nhq/ guard.
# Resolve the main repo toplevel via git-common-dir and run its guard too —
# the worktree pushes to the same origin, so the same backstop must apply.
run_local_guard() {
  local g="$1"
  [[ -x "$g" ]] || return 0
  printf '%s' "$INPUT" | JCODE_HOOK_TOOL_NAME="$TOOL_RAW" JCODE_HOOK_CWD="$CWD" "$g"
  [[ $? -eq 2 ]] && exit 2
  return 1   # guard existed and allowed → caller stops searching
}
found_guard=0
dir="$CWD"
while [[ -n "$dir" && "$dir" != "/" ]]; do
  if [[ -x "$dir/.nhq/pre-tool-guard" ]]; then
    run_local_guard "$dir/.nhq/pre-tool-guard"; found_guard=1; break
  fi
  dir="${dir%/*}"
done
if [[ $found_guard -eq 0 ]]; then
  common="$(git -C "$CWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  if [[ -n "$common" ]]; then
    main_top="$(dirname "$common")"           # <repo>/.git → <repo>
    run_local_guard "$main_top/.nhq/pre-tool-guard"
  fi
fi

exit 0
