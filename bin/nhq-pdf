HTML_TMPL = """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><style>{css}</style></head>
<body>{cover}
{content}
</body></html>"""

def build_printer(pdf_title):
    footer_left = _html.escape(pdf_title or "")[:70]
    footer = ('<div style="width:100%;height:14mm;margin:0;background:#14130F;'
              'box-sizing:border-box;padding:0 15mm;border-top:0.5px solid #3B392F;'
              '-webkit-print-color-adjust:exact;print-color-adjust:exact;'
              'font-size:7.5px;font-family:Inter,\'Open Sans\',sans-serif;'
              'display:flex;justify-content:space-between;align-items:center;">'
              f'<span style="text-transform:uppercase;letter-spacing:.12em;color:#BDB8AC;">{footer_left}</span>'
              '<span style="color:#BDB8AC;"><span class="pageNumber" style="color:#F2B705;font-weight:700;"></span>'
              ' / <span class="totalPages"></span></span></div>')
    header = '<div></div>'
    return """
const { chromium } = require('playwright');
const [,, htmlPath, pdfPath] = process.argv;
(async () => {
  const browser = await chromium.launch({ args:['--no-sandbox','--disable-setuid-sandbox'] });
  const page = await browser.newPage();
  await page.goto('file://' + htmlPath, { waitUntil:'networkidle', timeout:120000 });
  await page.emulateMedia({ media:'print' });
  await page.pdf({
    path: pdfPath, format:'A4', printBackground:true, displayHeaderFooter:true,
    margin:{ top:'0', bottom:'14mm', left:'0', right:'0' },
    headerTemplate: %s,
    footerTemplate: %s,
  });
  await browser.close();
  console.log('ok');
})().catch(e => { console.error(e); process.exit(1); });
""" % (json.dumps(header), json.dumps(footer))

# ---------------------------------------------------------------- print
def print_pdf(html_path, pdf_path, pdf_title, tmp):
    npath = node_path()
    if npath:
        printer = tmp / "print.cjs"
        printer.write_text(build_printer(pdf_title), encoding="utf-8")
        env = dict(os.environ, NODE_PATH=npath)
        r = subprocess.run(["node", str(printer), str(html_path.resolve()), str(pdf_path.resolve())],
                           capture_output=True, text=True, env=env, timeout=300)
        if r.returncode == 0 and pdf_path.exists():
            return True
        sys.stderr.write((r.stderr or r.stdout or "")[-1200:] + "\n")
        log("   ⚠️  Playwright print failed — trying direct Chromium fallback (no page numbers)")
    chrome = find_chromium()
    if not chrome:
        die("No PDF engine available (need global 'playwright' or a Chromium binary).")
    r = subprocess.run([chrome, "--headless=new", "--no-sandbox", "--disable-setuid-sandbox",
                        "--no-pdf-header-footer", f"--print-to-pdf={pdf_path.resolve()}",
                        html_path.resolve().as_uri()],
                       capture_output=True, text=True, timeout=300)
    if pdf_path.exists() and pdf_path.stat().st_size > 0:
        return True
    sys.stderr.write((r.stderr or r.stdout or "")[-1200:] + "\n")
    return False

def page_count(pdf_path):
    try:
        from pypdf import PdfReader
        return len(PdfReader(str(pdf_path)).pages)
    except Exception:
        try:
            r = subprocess.run(["pdfinfo", str(pdf_path)], capture_output=True, text=True)
            m = re.search(r"Pages:\s*(\d+)", r.stdout)
            return int(m.group(1)) if m else 0
        except Exception:
            return 0

# ---------------------------------------------------------------- main
def main():
    args = [a for a in sys.argv[1:] if a not in ("-h", "--help")]
    if len(sys.argv) == 1 or any(a in ("-h", "--help") for a in sys.argv[1:]):
        print(__doc__.strip()); sys.exit(0 if len(sys.argv) > 1 else 1)
    if not args:
        die("Usage: nhq-pdf \"<input.md>\" [\"<output.pdf>\"]")

    src = Path(args[0]).expanduser()
    if not src.exists():
        die(f"Input not found: {src}")
    out = Path(args[1]).expanduser() if len(args) > 1 else src.with_suffix(".pdf")
    out.parent.mkdir(parents=True, exist_ok=True)

    try:
        import markdown  # noqa: F401
    except ImportError:
        die("Python 'markdown' package required:  pip install --user markdown")

    log(f"📄 nhq-pdf  ·  {src.name}")
    text = src.read_text(encoding="utf-8")

    meta, text = parse_frontmatter(text)
    text = READ_LINE_RE.sub("", text)
    text = transform_callouts(text)
    title, text = extract_h1(text)
    pdf_title = title or meta.get("title") or src.stem

    mmdc = find_mmdc()
    log(f"   🖇  mermaid engine: {mmdc[0] if len(mmdc)==1 else ' '.join(mmdc)}")

    with tempfile.TemporaryDirectory(prefix="nhq-pdf-") as td:
        tmp = Path(td)
        puppeteer_cfg = tmp / "puppeteer.json"
        puppeteer_cfg.write_text(json.dumps({"args": ["--no-sandbox", "--disable-setuid-sandbox"]}),
                                 encoding="utf-8")

        text, n = render_mermaid_blocks(text, tmp, mmdc, puppeteer_cfg)
        if n:
            log(f"   ✅ {n} diagram(s) rendered")
        else:
            log("   ·  no mermaid blocks")

        content_html = md_to_html(text)
        cover_html = build_cover(title or meta.get("title"), meta)
        full = HTML_TMPL.format(css=CSS, cover=cover_html, content=content_html)
        html_path = tmp / "doc.html"
        html_path.write_text(full, encoding="utf-8")

        log("   🖨  printing PDF…")
        ok = print_pdf(html_path, out, pdf_title, tmp)
        if not ok:
            die("PDF generation failed.")

    size = out.stat().st_size
    pages = page_count(out)
    human = f"{size/1024/1024:.1f}MB" if size >= 1024*1024 else f"{size/1024:.0f}KB"
    log(f"\n✅ PDF ready → {out}")
    log(f"   {pages} page(s) · {human}")

if __name__ == "__main__":
    main()
