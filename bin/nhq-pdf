#!/usr/bin/env python3
"""
nhq-pdf — turn a vault markdown doc into a STUNNING, CORRECT PDF.

Usage:
    nhq-pdf "<input.md>" ["<output.pdf>"]

Pipeline:
  1. Read the md; drop YAML frontmatter + the `- [ ] **Read**` tracker line from the body.
  2. Render EVERY ```mermaid block to a hi-res white-bg PNG via mermaid-cli (keeps the
     block's own %%{init}%% theme line) and swap the fence for an <img> in a temp copy.
  3. Convert temp md -> HTML (tables, task-lists, nested lists, blockquotes/callouts,
     code, emoji) and print to PDF with a premium stylesheet via headless Chromium
     (Playwright) — cover page from the H1, page numbers, page-break-safe tables/diagrams.
  4. Clean up temp files.

Generic + reusable: handles N mermaid blocks and any vault doc, not hardcoded to one file.
"""
import base64
import html as _html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
from datetime import date
from pathlib import Path

# ---------------------------------------------------------------- ui helpers
def log(msg):    print(msg, flush=True)
def die(msg):    print(f"\033[31m✗ {msg}\033[0m", file=sys.stderr); sys.exit(1)

# ---------------------------------------------------------------- tool resolution
def find_mmdc():
    """Return an argv prefix that runs mermaid-cli. Prefer a cached binary; else npx."""
    direct = shutil.which("mmdc")
    if direct:
        return [direct]
    cands = sorted(Path.home().glob(".npm/_npx/*/node_modules/.bin/mmdc"))
    # prefer a v11+ build if we can tell
    best = None
    for c in cands:
        if not c.exists():
            continue
        try:
            v = subprocess.run([str(c), "--version"], capture_output=True, text=True, timeout=30)
            ver = (v.stdout or "").strip()
            if ver.startswith("11") or ver.startswith("1"):
                return [str(c)]
            best = best or c
        except Exception:
            best = best or c
    if best:
        return [str(best)]
    return ["npx", "-y", "@mermaid-js/mermaid-cli"]

def node_path():
    """Where global node modules (playwright) live."""
    try:
        r = subprocess.run(["npm", "root", "-g"], capture_output=True, text=True, timeout=20)
        p = r.stdout.strip()
        if p and Path(p, "playwright").exists():
            return p
    except Exception:
        pass
    for guess in ("~/.npm-global/lib/node_modules", "/usr/lib/node_modules",
                  "/usr/local/lib/node_modules"):
        g = Path(guess).expanduser()
        if (g / "playwright").exists():
            return str(g)
    return ""

def find_chromium():
    """Fallback Chromium binary (Playwright / puppeteer caches)."""
    for pat in (".cache/ms-playwright/chromium-*/chrome-linux*/chrome",
                ".cache/puppeteer/chrome/*/chrome-linux*/chrome",
                ".cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux*/chrome-headless-shell"):
        hits = sorted(Path.home().glob(pat))
        if hits:
            return str(hits[-1])
    for name in ("chromium", "chromium-browser", "google-chrome", "chrome"):
        w = shutil.which(name)
        if w:
            return w
    return ""

# ---------------------------------------------------------------- markdown prep
FRONTMATTER_RE = re.compile(r"^---\s*\n.*?\n---\s*\n", re.DOTALL)
READ_LINE_RE   = re.compile(r"^\s*[-*]\s*\[[ xX]\]\s*\*{0,2}Read\*{0,2}\s*$", re.MULTILINE)
CALLOUT_RE     = re.compile(r"^>\s*\[!([A-Za-z]+)\]([+-]?)\s*(.*)$")

CALLOUT_EMOJI = {
    "note": "📝", "info": "ℹ️", "tip": "💡", "hint": "💡", "important": "❗",
    "warning": "⚠️", "caution": "⚠️", "danger": "🚫", "error": "🚫",
    "success": "✅", "check": "✅", "done": "✅", "question": "❓", "faq": "❓",
    "example": "🔎", "quote": "❝", "abstract": "📄", "summary": "📄", "todo": "🗒️",
    "bug": "🐛", "failure": "❌",
}

def parse_frontmatter(text):
    meta = {}
    m = FRONTMATTER_RE.match(text)
    if not m:
        return meta, text
    block = m.group(0)
    for line in block.splitlines():
        fm = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if fm:
            key, val = fm.group(1).strip(), fm.group(2).strip()
            if val and not val.startswith("|") and not val.startswith(">"):
                meta[key.lower()] = val.strip().strip('"').strip("'")
    return meta, text[m.end():]

def transform_callouts(text):
    """Turn Obsidian `> [!type] Title` headers into clean bold blockquote headers."""
    out = []
    for line in text.splitlines():
        m = CALLOUT_RE.match(line)
        if m:
            typ = m.group(1).lower()
            title = m.group(3).strip()
            emoji = CALLOUT_EMOJI.get(typ, "🔹")
            label = title if title else typ.upper()
            out.append(f"> **{emoji} {label}**")
        else:
            out.append(line)
    return "\n".join(out)

def extract_h1(text):
    """Pull the first level-1 heading for the cover; strip it from the body."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = re.match(r"^#\s+(.*\S)\s*$", line)
        if m:
            title = m.group(1).strip()
            del lines[i]
            return title, "\n".join(lines)
    return None, text

# ---------------------------------------------------------------- mermaid render
def render_mermaid_blocks(text, tmp, mmdc, puppeteer_cfg):
    """Replace each ```mermaid fence with a rendered <img> figure. Returns (text, count)."""
    lines = text.splitlines()
    out, i, n, rendered = [], 0, len(lines), 0
    open_re  = re.compile(r"^(\s*)```+\s*mermaid\s*$", re.IGNORECASE)
    close_re = re.compile(r"^\s*```+\s*$")
    total = sum(1 for ln in lines if open_re.match(ln))
    while i < n:
        mo = open_re.match(lines[i])
        if not mo:
            out.append(lines[i]); i += 1; continue
        # capture until closing fence
        body, j = [], i + 1
        while j < n and not close_re.match(lines[j]):
            body.append(lines[j]); j += 1
        j += 1  # consume closing fence
        rendered += 1
        code = textwrap.dedent("\n".join(body)).strip() + "\n"
        mmd = tmp / f"diagram-{rendered}.mmd"
        png = tmp / f"diagram-{rendered}.png"
        mmd.write_text(code, encoding="utf-8")
        log(f"   🎨 diagram {rendered}/{total} → rendering…")
        cmd = mmdc + ["-i", str(mmd), "-o", str(png), "-s", "3", "-b", "#1a1c1f",
                      "-p", str(puppeteer_cfg)]
        ok = False
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
            ok = (r.returncode == 0 and png.exists() and png.stat().st_size > 0)
            if not ok:
                sys.stderr.write((r.stderr or r.stdout or "")[-800:] + "\n")
        except Exception as e:
            sys.stderr.write(f"{e}\n")
        if ok:
            uri = png.resolve().as_uri()
            out += ["", f'<figure class="diagram"><img src="{uri}" alt="diagram {rendered}"/></figure>', ""]
        else:
            log(f"   ⚠️  diagram {rendered} failed to render — keeping source block")
            out += ["", "```mermaid", *body, "```", ""]
        i = j
    return "\n".join(out), rendered

# ---------------------------------------------------------------- html assembly
def md_to_html(md_text):
    import markdown
    html = markdown.markdown(
        md_text,
        extensions=["tables", "fenced_code", "sane_lists", "attr_list",
                    "md_in_html", "def_list", "footnotes"],
        output_format="html5",
    )
    # task-list checkboxes (generic; the tracker line is already stripped)
    html = re.sub(r"<li>(\s*<p>)?\s*\[ \]\s*",
                  lambda m: '<li class="task">' + (m.group(1) or "") + '<span class="chk"></span> ',
                  html)
    html = re.sub(r"<li>(\s*<p>)?\s*\[[xX]\]\s*",
                  lambda m: '<li class="task done">' + (m.group(1) or "") + '<span class="chk">✓</span> ',
                  html)
    return html

def build_cover(title, meta):
    if not title:
        return ""
    kicker = (meta.get("project") or meta.get("type") or "").strip()
    subtitle_bits = []
    if meta.get("type"):    subtitle_bits.append(meta["type"].replace("-", " ").title())
    if meta.get("project"): subtitle_bits.append(meta["project"])
    subtitle = " · ".join(dict.fromkeys(subtitle_bits))
    meta_bits = []
    if meta.get("status"):  meta_bits.append(f"Status — {meta['status']}")
    created = meta.get("created") or meta.get("date")
    if created:             meta_bits.append(f"Created — {created}")
    meta_bits.append(f"Rendered — {date.today().isoformat()}")
    e = _html.escape
    parts = ['<section class="cover">']
    if kicker:
        parts.append(f'<div class="kicker">{e(kicker)}</div>')
    parts.append(f'<h1 class="title">{e(title)}</h1>')
    parts.append('<div class="rule"></div>')
    if subtitle:
        parts.append(f'<div class="subtitle">{e(subtitle)}</div>')
    parts.append(f'<div class="meta">{" &nbsp;·&nbsp; ".join(e(b) for b in meta_bits)}</div>')
    parts.append("</section>")
    return "\n".join(parts)

