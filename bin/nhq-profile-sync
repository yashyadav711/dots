#!/usr/bin/env node
// nhq-profile-sync — one source of truth for "everything about Yash", fanned out
// to every place that has to stay in step.
//
//   SOURCE   ~/Github/Personal/portfolio/src/data/{site,profile,stack,projects}.ts
//   TARGETS  portfolio/github-profile/README.md          (GitHub profile)
//            ~/Obsidian/nHQ/Synced/Career/Yash Yadav — full profile pack.md
//                                                        (upload-anywhere brief:
//                                                         Gemini Spark, ChatGPT, recruiters)
//
// WORKFLOW — when Yash says "we added <project>":
//   1. Add ONE entry to portfolio/src/data/projects.ts (tier 1 flagship / 2 selected / 3 also).
//      Add any genuinely new language or tool to stack.ts at the same time.
//   2. Run `nhq-profile-sync`.
//   3. That is it. Every target below is regenerated — never hand-edit them.
//
// The résumé PDF is a separate build (`pnpm build` in the portfolio) because it
// needs the Astro toolchain; this script prints the reminder rather than guessing.
//
// --check exits non-zero if a target is out of date, for use in a hook or CI.

import { readFileSync, writeFileSync, mkdirSync, existsSync, copyFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { homedir } from "node:os";

const HOME = homedir();
const PORTFOLIO = join(HOME, "Github/Personal/portfolio");
const DATA = join(PORTFOLIO, "src/data");
const CHECK = process.argv.includes("--check");

const TARGETS = {
	githubProfile: join(PORTFOLIO, "github-profile/README.md"),
	profilePack: join(HOME, "Obsidian/nHQ/Synced/Career/Yash Yadav — full profile pack.md"),
};

if (!existsSync(DATA)) {
	console.error(`nhq-profile-sync: source data not found at ${DATA}`);
	process.exit(1);
}

const { site } = await import(join(DATA, "site.ts"));
const { skillGroups, experience, education, certifications, foundationStats } = await import(
	join(DATA, "profile.ts")
);
const { headlineStack, stackGroups } = await import(join(DATA, "stack.ts"));
const { projects, flagships, selected, also } = await import(join(DATA, "projects.ts"));

const today = new Date().toISOString().slice(0, 10);
const group = (label) => skillGroups.find((g) => g.label === label)?.items.join(" · ") ?? "";

/* ---------------------------------------------------------------- GitHub profile */

const chips = (items, n = 99) => items.slice(0, n).map((s) => `\`${s}\``).join(" ");

const flagshipBlock = (p) =>
	[
		`### ${p.name}`,
		`**${p.tagline}** &nbsp;·&nbsp; \`${p.status}\`${p.confidential ? " `confidential`" : ""}`,
		"",
		...p.highlights.slice(0, 3).map((h) => `- ${h}`),
		"",
		chips(p.stack),
		"",
	].join("\n");

const githubProfile = `<!--
  GENERATED by nhq-profile-sync — do not hand-edit.
  Source: portfolio/src/data/*.ts · regenerate with \`nhq-profile-sync\`.

  To publish: create a public repo named exactly \`yashyadav711\`
  (github.com/yashyadav711/yashyadav711) and copy BOTH this README.md and
  banner.png into it. Then pin your public repos.
-->

<div align="center">

<img src="banner.png" alt="${site.name} — ${site.role}" width="100%">

<br>

[![LinkedIn](https://img.shields.io/badge/LinkedIn-yash--yadav711-2dd4bf?style=flat-square&labelColor=0a0a0b)](${site.socials.linkedin})
[![Email](https://img.shields.io/badge/Email-${site.email.replace(/@/g, "%40").replace(/\./g, ".")}-2dd4bf?style=flat-square&labelColor=0a0a0b)](mailto:${site.email})
[![GitHub](https://img.shields.io/badge/GitHub-yashyadav711-2dd4bf?style=flat-square&labelColor=0a0a0b)](${site.socials.github})
[![TryHackMe](https://img.shields.io/badge/TryHackMe-top%201%25-2dd4bf?style=flat-square&labelColor=0a0a0b)](https://tryhackme.com/p/yashyadav711)

</div>

---

${site.summary}

<table>
<tr>
${foundationStats.map((s) => `<td align="center"><b>${s.value}</b><br><sub>${s.label}</sub></td>`).join("\n")}
</tr>
</table>

---

## What I'm building

${flagships.map(flagshipBlock).join("\n")}
---

## Selected work

| Project | What it is | Built with |
|---|---|---|
${selected.map((p) => `| **${p.name}** | ${p.tagline.replace(/\\.$/, "")} | ${chips(p.stack, 4)} |`).join("\n")}

<details>
<summary><b>Everything else</b> — ${also.length} more projects</summary>

<br>

| Project | What it is | Built with |
|---|---|---|
${also.map((p) => `| **${p.name}** | ${p.tagline.replace(/\\.$/, "")} | ${chips(p.stack, 4)} |`).join("\n")}

</details>

---

## Stack

| | |
|---|---|
${stackGroups.map((g) => `| **${g.label}** | ${chips(g.items)} |`).join("\n")}

---

## Before AI: security & DevSecOps

${experience[experience.length - 1].points.map((p) => `- ${p}`).join("\n")}

${certifications.map((c) => `\`${c}\``).join(" · ")}

---

<div align="center">
<sub>${education.degree} · ${education.school}</sub><br>
<sub>${site.location} · <a href="mailto:${site.email}">${site.email}</a></sub>
</div>
`;

/* ------------------------------------------------------------------ Profile pack */

const projectBlock = (p) =>
	[
		`#### ${p.name} · **${p.status}**${p.confidential ? " *(confidential)*" : ""}`,
		p.blurb,
		...p.highlights.map((h) => `- ${h}`),
		`- *Stack:* ${p.stack.join(" · ")}`,
		"",
	].join("\n");

const profilePack = `# Yash Yadav — Complete Profile Pack

> Single-file brief for an AI assistant or a recruiter. **Generated ${today} by \`nhq-profile-sync\`
> from \`portfolio/src/data/*.ts\` — do not hand-edit; edit the source and re-run.**

---

## 1. Identity & contact

| | |
|---|---|
| **Name** | ${site.name} |
| **Title** | ${site.role} |
| **Also positions as** | ${site.roleAlt} |
| **Location** | Mhow, Madhya Pradesh, India · remote-first |
| **Email** | ${site.email} *(the only current address — ignore any older one)* |
| **Phone** | +91 91651 64162 |
| **LinkedIn** | ${site.socials.linkedin} |
| **GitHub** | ${site.socials.github} |
| **GitLab** | https://gitlab.com/yashyadav711 (level 10/13) |
| **TryHackMe** | https://tryhackme.com/p/yashyadav711 (rank 10621 / 1,070,797) |

**One-liner:** ${site.tagline}

**Summary:** ${site.summary}

---

## 2. Experience

${experience
	.map(
		(e) =>
			`### ${e.role}${e.company && e.company !== "Independent" && e.company !== "COMPANY_TBD" ? ` — ${e.company}` : ""} · ${e.period}\n${e.points.map((p) => `- ${p}`).join("\n")}`,
	)
	.join("\n\n")}

---

## 3. Education

- **${education.degree}**
  ${education.school} · ${education.period} · CGPA 7.44
- **XII** — Shri Sai Academy, Mhow · 2017 · 60.02%
- **X** — Shri Sai Academy, Mhow · 2015 · 8.2 CGPA

---

## 4. Certifications & training

${certifications.map((c) => `- ${c}`).join("\n")}
- Mastering the AWS Well-Architected Framework (A Cloud Guru)
- Learn Ansible by Doing (A Cloud Guru)
- TryHackMe paths: Complete Beginner · Pre Security · CompTIA Pentest+ · Offensive Pentesting
- Advent of Cyber 2020 (TryHackMe) · The Great AppSec Hackathon 2021

**Internships**
- Data Structures & Algorithms — GeeksforGeeks · Apr–Aug 2020
- Cyber Security & Ethical Hacking — Coincent.ai · Jul–Nov 2022

---

## 5. Skills

${skillGroups.map((g) => `**${g.label}** — ${g.items.join(" · ")}`).join("\n\n")}

**Security specifics** — web app & network pentesting · Active Directory · SOC / SIEM · ELK log analysis · configuration audit · system hardening (CIS) · CAPEv2 · report writing

**Scripting** — Bash · Python · SQL · regex / sed / awk · PowerShell · YAML

---

## 6. Full technology stack

*Extracted from real dependency manifests across every project — not aspirational.*

**Headline:** ${headlineStack.join(" · ")}

| Area | Technologies |
|---|---|
${stackGroups.map((g) => `| **${g.label}** | ${g.items.join(" · ")} |`).join("\n")}

---

## 7. Projects (${projects.length})

### Tier 1 — Flagship

${flagships.map(projectBlock).join("\n")}
### Tier 2 — Selected

${selected.map(projectBlock).join("\n")}
### Tier 3 — Also

| Project | What it is | Stack |
|---|---|---|
${also.map((p) => `| **${p.name}** | ${p.blurb.replace(/\n/g, " ")} | ${p.stack.join(" · ")} |`).join("\n")}

---

## 8. Earlier engineering work (security era)

Magento 2 on AWS EC2 (PHP, MySQL, Nginx, Elasticsearch, Varnish) · static site hosting on S3 ·
WordPress on EC2 + RDS · 5+ customized Docker images of major Linux distributions ·
Wiz integration with AWS S3, SNS and GCP Pub/Sub · Jenkins + Docker automated container build and
deploy · Kubernetes orchestration of multiple web servers · EC2 + ALB deployment with IP
whitelisting · AWS WAF setup · CAPEv2 deployment for automated malware analysis with automated
feeds and signature updates · Bash hardening script for Ubuntu CIS compliance · Jenkins + GitLab
push-triggered builds.

**Academic / hobby:** Snake game on Arduino ATmega328p (joystick + 8×8 LED) · Red-Arcade game-selling
site (HTML/CSS) · Twitter sentiment analysis in Python · animated space robot in Unity 3D (rig,
diffuse + normal maps) · Kay0S, an x86-64 Linux distribution based on Arch.

---

## 9. Working style & preferences

- Works solo across the whole stack — from Linux/infra up to UI — and prefers shipping real products over prototypes.
- Multi-agent native: builds systems where agents supervise and orchestrate other agents, with governance and audit built in, not bolted on.
- Security-first instincts carried over from the DevSecOps years: RLS, encrypted secrets, audit logs, dependency scanning, human gates on sensitive changes.
- Resource-conscious engineering — much of the above runs on a 7.5 GB laptop.
- Communicates in Hinglish; prefers short, direct, evidence-backed answers.

---

## 10. Known gaps

${experience.some((e) => e.company === "COMPANY_TBD") ? "- **Employer name for the Information Security Consultant role is still `COMPANY_TBD`** in `profile.ts`. Fill it in before sending this anywhere.\n" : ""}- Home street address deliberately left out (it is in the CV PDF if needed).
- Portfolio site has no deployed URL yet.
`;

/* ------------------------------------------------------------------------ write */

let stale = 0;
for (const [name, path] of Object.entries(TARGETS)) {
	const next = name === "githubProfile" ? githubProfile : profilePack;
	const prev = existsSync(path) ? readFileSync(path, "utf8") : "";
	// The pack stamps today's date, so compare everything except that line.
	const strip = (s) => s.replace(/\*\*Generated \d{4}-\d{2}-\d{2}/, "**Generated");
	if (strip(prev) === strip(next)) {
		console.log(`  ok    ${path}`);
		continue;
	}
	stale += 1;
	if (CHECK) {
		console.log(`  STALE ${path}`);
		continue;
	}
	mkdirSync(dirname(path), { recursive: true });
	writeFileSync(path, next);
	console.log(`  wrote ${path}`);
}

// Publish: the live GitHub profile is a separate repo (github.com/yashyadav711/
// yashyadav711) holding just README.md + banner.png. Keep it in step here so
// "add a project" stays one command all the way to the public page.
const PROFILE_REPO = join(HOME, "Github/Personal/yashyadav711");
if (!CHECK && existsSync(join(PROFILE_REPO, ".git"))) {
	const banner = join(PORTFOLIO, "github-profile/banner.png");
	copyFileSync(TARGETS.githubProfile, join(PROFILE_REPO, "README.md"));
	if (existsSync(banner)) copyFileSync(banner, join(PROFILE_REPO, "banner.png"));
	const git = (args) =>
		spawnSync("git", args, { cwd: PROFILE_REPO, encoding: "utf8" }).stdout?.trim() ?? "";
	if (git(["status", "--porcelain"])) {
		spawnSync("git", ["add", "-A"], { cwd: PROFILE_REPO });
		spawnSync("git", ["commit", "-m", `profile: sync ${today}`], { cwd: PROFILE_REPO });
		const push = spawnSync("git", ["push"], { cwd: PROFILE_REPO, encoding: "utf8" });
		console.log(push.status === 0 ? "  pushed github.com/yashyadav711" : "  PUSH FAILED — push by hand");
	} else {
		console.log("  ok    github.com/yashyadav711 (already live)");
	}
}

console.log(
	`\n${projects.length} projects · ${flagships.length} flagship · ${selected.length} selected · ${also.length} also`,
);
if (!CHECK) console.log("Résumé PDF is a separate build: cd ~/Github/Personal/portfolio && pnpm build");
if (CHECK && stale) process.exit(1);
