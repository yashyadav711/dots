#!/usr/bin/env bash
# nhq-heydaddy-local-remote — branch-independent, no-Docker local runner for HeyDaddy.
#
# Runs the LOCAL backend (:8000) + frontend (:3000) pointed at the REMOTE dev
# Supabase (real dev data + existing accounts). Self-contained: does NOT source
# the repo's scripts/local-dev.sh, so it works on ANY git branch checked out in
# the repo. No Docker, no `supabase start`.
#
# Env source of truth: ~/.config/heydaddy/dev-remote.env (pulled from the dev
# Railway backend service; FRONTEND_URL overridden to http://localhost:3000 so
# CORS + CSRF allow the local frontend).
#
# Usage:
#   hd-dev up        start backend + frontend, health-check, print URLs
#   hd-dev down      stop both (by pidfile AND by port), verify ports free
#   hd-dev status    show whether backend/frontend are up + the URLs
#   hd-dev logs [backend|frontend]   tail the log (default: backend)
set -uo pipefail

REPO=/home/yash/Github/Work/heydaddy
CFG="$HOME/.config/heydaddy"
ENV_FILE="$CFG/dev-remote.env"
LOGDIR="$REPO/.local-dev"
BACKEND_LOG="$LOGDIR/backend.log"
FRONTEND_LOG="$LOGDIR/frontend.log"
BACKEND_PID="$CFG/backend.pid"
FRONTEND_PID="$CFG/frontend.pid"
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_URL="http://localhost:${BACKEND_PORT}"
FRONTEND_URL="http://localhost:${FRONTEND_PORT}"

c_grn=$'\033[32m'; c_red=$'\033[31m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s!%s %s\n' "$c_yel" "$c_off" "$*"; }
err()  { printf '%s✗%s %s\n' "$c_red" "$c_off" "$*" >&2; }

# --- helpers ---------------------------------------------------------------

port_pids() { # pids listening on $1
  ss -ltnp 2>/dev/null | grep ":$1 " | grep -oP 'pid=\K[0-9]+' | sort -u
}

port_up() { [ -n "$(port_pids "$1")" ]; }

http_ok() { # returns 0 if $1 returns HTTP 200
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$1" 2>/dev/null)
  [ "$code" = "200" ]
}

kill_pidfile() { # graceful kill of the process GROUP recorded in $1
  local f="$1" pid
  [ -f "$f" ] || return 0
  pid=$(cat "$f" 2>/dev/null)
  if [ -n "${pid:-}" ]; then
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$f"
}

kill_port() { # kill anything listening on $1 (uvicorn --reload spawns a child)
  local port="$1" pids
  pids=$(port_pids "$port")
  [ -n "$pids" ] && kill -TERM $pids 2>/dev/null || true
}

load_env() {
  if [ ! -f "$ENV_FILE" ]; then
    err "env file missing: $ENV_FILE"
    err "recreate with: railway variables --service heydaddy --environment dev --kv > $ENV_FILE"
    exit 1
  fi
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  # Local adaptations (env file stays verbatim-from-dev; these are box-local):
  #  - DATA_DIR/PERSONAS_DIR: dev uses Railway paths (/app/data) that don't
  #    exist locally -> point at a local dir so startup + storage work.
  #  - MIGRATION_AUTO=false: the deployed dev backend already keeps the dev
  #    Supabase schema current; a local preview box must not mutate it on boot.
  export DATA_DIR="$LOGDIR/data"
  export PERSONAS_DIR="$LOGDIR/data/personas"
  export MIGRATION_AUTO=false
  mkdir -p "$DATA_DIR" "$PERSONAS_DIR"
}

render_frontend_env() {
  local sb_url sb_anon fe="$REPO/frontend/.env.development.local"
  sb_url="${SUPABASE_URL:-}"
  sb_anon="${SUPABASE_ANON_KEY:-}"
  if [ -z "$sb_url" ] || [ -z "$sb_anon" ]; then
    err "SUPABASE_URL / SUPABASE_ANON_KEY not found in $ENV_FILE"
    exit 1
  fi
  cat > "$fe" <<EOF
# Generated by hd-dev — local frontend pointed at the REMOTE dev Supabase.
# Do not commit (gitignored). Re-rendered on every 'hd-dev up'.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=${BACKEND_URL}
NEXT_PUBLIC_SITE_URL=${FRONTEND_URL}
NEXT_PUBLIC_SUPABASE_URL=${sb_url}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${sb_anon}
EOF
  ok "rendered frontend/.env.development.local"
}

wait_http() { # $1=url $2=label $3=timeout_s
  local url="$1" label="$2" timeout="${3:-60}" i=0
  printf '  waiting for %s ' "$label"
  while [ "$i" -lt "$timeout" ]; do
    if http_ok "$url"; then printf ' %sup%s\n' "$c_grn" "$c_off"; return 0; fi
    printf '.'; sleep 1; i=$((i+1))
  done
  printf ' %stimeout%s\n' "$c_red" "$c_off"; return 1
}

# --- commands --------------------------------------------------------------

cmd_up() {
  mkdir -p "$LOGDIR" "$CFG"
  # Idempotent: if both already healthy, no-op (re-render env only).
  if http_ok "$BACKEND_URL/health" && http_ok "$FRONTEND_URL"; then
    load_env >/dev/null 2>&1
    render_frontend_env
    ok "already up — nothing to do"
    cmd_status
    return 0
  fi
  # Otherwise ensure a clean slate (frees ports, kills half-started stacks).
  say "→ clearing any existing stack…"
  cmd_down >/dev/null 2>&1 || true

  load_env
  render_frontend_env

  say "→ starting backend on :${BACKEND_PORT} (remote dev Supabase)…"
  ( cd "$REPO" && setsid uvicorn backend.main:app \
      --host 0.0.0.0 --port "$BACKEND_PORT" \
      --reload --reload-dir backend --reload-dir src \
      </dev/null >"$BACKEND_LOG" 2>&1 & echo $! >"$BACKEND_PID" )

  say "→ starting frontend on :${FRONTEND_PORT}…"
  ( cd "$REPO/frontend" && setsid env API_PROXY_TARGET="$BACKEND_URL" npm run dev -- --webpack \
      </dev/null >"$FRONTEND_LOG" 2>&1 & echo $! >"$FRONTEND_PID" )

  local rc=0
  wait_http "$BACKEND_URL/health" "backend /health" 60 || rc=1
  wait_http "$FRONTEND_URL" "frontend" 120 || rc=1

  echo
  if [ "$rc" -eq 0 ]; then
    ok "stack up"
  else
    err "one or more health checks failed — see logs"
  fi
  cmd_status
  say ""
  say "  logs: hd-dev logs backend   ·   hd-dev logs frontend"
  say "        $BACKEND_LOG"
  say "        $FRONTEND_LOG"
  return "$rc"
}

cmd_down() {
  say "→ stopping stack…"
  kill_pidfile "$BACKEND_PID"
  kill_pidfile "$FRONTEND_PID"
  # Belt-and-suspenders: uvicorn --reload spawns a reloader child; next spawns
  # next-server. Kill by port to catch survivors.
  kill_port "$BACKEND_PORT"
  kill_port "$FRONTEND_PORT"
  sleep 2
  # Escalate to SIGKILL if anything clings on.
  for p in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    local pids; pids=$(port_pids "$p")
    [ -n "$pids" ] && kill -KILL $pids 2>/dev/null || true
  done
  sleep 1
  if port_up "$BACKEND_PORT" || port_up "$FRONTEND_PORT"; then
    err "ports still in use: $(port_up "$BACKEND_PORT" && echo $BACKEND_PORT) $(port_up "$FRONTEND_PORT" && echo $FRONTEND_PORT)"
    return 1
  fi
  ok "ports ${BACKEND_PORT}/${FRONTEND_PORT} free"
}

cmd_status() {
  local b f
  if http_ok "$BACKEND_URL/health"; then b="${c_grn}up${c_off}"; else b="${c_red}down${c_off}"; fi
  if http_ok "$FRONTEND_URL"; then f="${c_grn}up${c_off}"; else f="${c_red}down${c_off}"; fi
  say ""
  printf '  backend   %b   %s/health\n' "$b" "$BACKEND_URL"
  printf '  frontend  %b   %s\n' "$f" "$FRONTEND_URL"
  printf '  %ssupabase  remote dev (%s)%s\n' "$c_dim" "${SUPABASE_URL:-see dev-remote.env}" "$c_off"
}

cmd_logs() {
  local which="${1:-backend}" log
  case "$which" in
    backend|be) log="$BACKEND_LOG" ;;
    frontend|fe) log="$FRONTEND_LOG" ;;
    *) err "unknown log '$which' (use backend|frontend)"; exit 1 ;;
  esac
  [ -f "$log" ] || { err "no log yet: $log"; exit 1; }
  tail -n 40 -f "$log"
}

case "${1:-}" in
  up)     shift; cmd_up "$@" ;;
  down)   shift; cmd_down "$@" ;;
  status|st) shift; load_env >/dev/null 2>&1 || true; cmd_status ;;
  logs)   shift; cmd_logs "$@" ;;
  *)
    cat >&2 <<EOF
hd-dev — local HeyDaddy runner (backend :8000 + frontend :3000 → remote dev Supabase)

  hd-dev up       start both, health-check, print URLs
  hd-dev down     stop both (pidfile + port), verify ports free
  hd-dev status   show up/down + URLs
  hd-dev logs [backend|frontend]   tail a log (default backend)
EOF
    exit 1 ;;
esac
