#!/usr/bin/env python3
"""nhq-daily-fetch — typed source adapters -> normalized magazine items."""
import sys, os, json, re, html, yaml, urllib.request, datetime, feedparser

CFG = os.path.expanduser("~/.claude/skills/daily-news/config.yaml")

def _clean(text):
    """Sanitize feed body text: decode HTML entities, strip tags, drop arXiv
    boilerplate, collapse whitespace — so no raw markup leaks into the magazine."""
    if not text: return text
    text = html.unescape(str(text))                 # &#x2F; &amp; &lt;p&gt; -> / & <p>
    text = re.sub(r"<[^>]+>", " ", text)            # strip HTML tags
    text = re.sub(r"arXiv:\S+\s*", "", text)        # arXiv id prefix
    text = re.sub(r"Announce Type:\s*\w+\s*", "", text)
    text = re.sub(r"^\s*Abstract:\s*", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text or None

def _dig(obj, path):
    cur = obj
    for k in path.split("."):
        if isinstance(cur, list): cur = cur[int(k)]
        elif isinstance(cur, dict): cur = cur.get(k)
        else: return None
        if cur is None: return None
    return cur

def _field(item, spec):
    """spec is 'a.b.c' or 'a.b|template-with-{}'."""
    if spec is None: return None
    path, _, tmpl = spec.partition("|")
    val = _dig(item, path) if path else None
    if tmpl and val is not None: return tmpl.format(val)
    return val

def _subst_url(url):
    d7 = (datetime.date.today() - datetime.timedelta(days=7)).isoformat()
    url = url.replace("{date_7d}", d7)
    if "{TMDB_KEY}" in url: url = url.replace("{TMDB_KEY}", os.environ.get("TMDB_KEY",""))
    return url

def _http_json(url):
    if url.startswith("file://"): return json.load(open(url[7:]))
    req = urllib.request.Request(url, headers={"User-Agent":"nhq-daily/1.0"})
    return json.loads(urllib.request.urlopen(req, timeout=20).read())

def fetch_source(entry, rating_min=7):
    t = entry["type"]; f = entry["fields"]; out = []
    if t == "rss":
        url = entry["url"]; feed = feedparser.parse(url[7:] if url.startswith("file://") else url)
        rows = feed.entries
    elif t == "json":
        data = _http_json(_subst_url(entry["url"]))
        rows = _dig(data, f["root"]) if "root" in f else data
    elif t == "firecrawl":
        rows = []  # firecrawl path handled by the agy-worker (see SKILL.md); fetch returns [] so pipeline routes it
    else:
        return []
    for r in rows:
        if t == "rss":
            getf = lambda key: (r.get(f[key]) if key in f else None)
            item = {"headline": getf("title"), "url": getf("url"),
                    "image": _field(r, f.get("image")), "summary": getf("summary"), "rating": None}
        else:
            item = {"headline": _field(r, f["title"]), "url": _field(r, f["url"]),
                    "image": _field(r, f.get("image")), "summary": _field(r, f.get("summary")),
                    "rating": _field(r, f.get("rating"))}
        item["headline"] = _clean(item["headline"]); item["summary"] = _clean(item.get("summary"))
        if not item["headline"] or not item["url"]: continue
        if item["rating"] is not None and float(item["rating"]) < rating_min: continue
        item.update(section=entry["section"], part=entry["part"], source=entry["url"])
        out.append(item)
        if len(out) >= entry.get("count", 10): break
    return out

def fetch_all(sources, rmin):
    """Fetch every source; a failing source (503/timeout/bad data) is skipped,
    not fatal — one dead feed must never empty the whole magazine."""
    items = []
    for s in sources:
        try:
            items.extend(fetch_source(s, rmin))
        except Exception as e:  # noqa: BLE001 - per-source isolation is the point
            print(f"[skip] {s.get('section','?')}: {e}", file=sys.stderr)
    return items

def main():
    cfg = yaml.safe_load(open(CFG)); rmin = cfg["thresholds"]["rating_min"]
    want = sys.argv[1] if len(sys.argv) > 1 else "--all"
    sources = cfg["sources"] if want == "--all" else [s for s in cfg["sources"] if s["section"] == want]
    print(json.dumps(fetch_all(sources, rmin), indent=2))

if __name__ == "__main__":
    main()