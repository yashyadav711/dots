#!/usr/bin/env bash
# nhq-glm [omp-args...] — launch omp with EVERY model role routed to z.ai (GLM).
#
# ⚠️ THE Z.AI SUBSCRIPTION IS CANCELLED (2026-08-11). Yash cancelled it; it had already
# failed 2026-08-01 with `insufficient balance`, and a live round-trip on 2026-08-11 still
# returns `[1113] Insufficient balance or no resource package`. This launcher is KEPT, not
# removed, because a FREE z.ai tier is acceptable if one works — but VERIFY THE LANE ANSWERS
# before trusting it: `bash ~/Github/nhq-agentic-os/scripts/nhq-engine-selftest.sh`.
# There is currently NO reliable zero-Anthropic CODE lane (docs/references/agy-capabilities.md).
#
# Loads the nhq-glm-config.yml overlay (sits next to this script) so ALL
# modelRoles — default, subagents (task), plan, slow, designer, advisor, smol,
# commit, title, vision — resolve to z.ai GLM models. ZERO Anthropic Claude
# burn for the session (verified: a spawned subagent ran on zai/glm-5.2).
#
# agy is a separate CLI (the Antigravity rotator), not an omp model provider,
# so it is not routable here — use agy directly when its accounts are healthy.
#
# NOTE: webSearch still follows ~/.omp/agent/config.yml providers.webSearch
# (z.ai is not an omp search backend); that one path is outside this alias.
#
# Usage: nhq-glm                  # interactive omp, fully on GLM
#        nhq-glm "fix the build"  # with an initial prompt
set -euo pipefail

# Loud pre-flight: a dead lane that looks configured is the trap. The key still AUTHENTICATES
# (429, not 401), so nothing here fails fast on its own.
echo "⚠️  nhq-glm: the z.ai/GLM subscription was cancelled 2026-08-11 — this session will likely" >&2
echo "    fail with 'insufficient balance'. Verify first: scripts/nhq-engine-selftest.sh" >&2
SRC="$(readlink -f "${BASH_SOURCE[0]:-$0}")"   # resolve the ~/.local/bin symlink
DIR="$(dirname "$SRC")"
exec omp --config "$DIR/nhq-glm-config.yml" "$@"
