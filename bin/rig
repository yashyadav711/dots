#!/usr/bin/env bash
# rig — get onto the GPU box.
#
#   rig                    FROM THE LAPTOP: a shell on rig, in ~/Github/rig.
#                          ON RIG ITSELF:   attaches the omp-rig session.
#   rig ssh | sh | shell   a plain shell, no omp, on either machine
#   rig --resume [SESSION] resume a previous omp conversation on rig
#   rig --continue [NAME]  continue the last omp conversation on rig
#   rig --attach           attach the always-running omp session (omp-rig)
#   rig --status           what is alive over there; changes nothing
#   rig -<flag> …          any other flag is passed through to omp on rig
#
# Bare `rig` deliberately does NOT open omp and does NOT attach the persistent
# session: attaching from inside the laptop's tmux nests two multiplexers, and he
# asked for a plain landing spot. omp is opt-in via the flags.
#
# A bare WORD is not forwarded to omp. It used to be, and `rig ssh` therefore ran
# omp's own `ssh` subcommand and answered "No SSH hosts configured" — which reads
# like rig is broken when nothing is wrong. Unknown words now print usage.
set -uo pipefail

HOST=rig
REPO='$HOME/Github/rig'          # expanded on the REMOTE side, not here

SESSION=omp-rig
c_d=$'\e[2m'; c_r=$'\e[31m'; c_0=$'\e[0m'
die() { printf '%srig: %s%s\n' "$c_r" "$*" "$c_0" >&2; exit 1; }

# ── already ON rig? then everything is local ─────────────────────────────────
# `rig` is installed on rig too (the fleet stage links every agent shorthand on
# whichever box it runs). Without this it tried to ssh to itself, and rig has no
# key to itself, so it died with "cannot reach rig with keys" while sitting on the
# very machine it was looking for. Same trap nhq_remote_dispatch guards against.
if [[ "$(hostname -s 2>/dev/null)" == rig ]]; then
  target="$HOME/Github/rig"
  case "${1:-}" in
    --status)  exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/nhq-attach" rig --status ;;

    ''|--attach)
      # ON rig, bare `rig` means "get me into my session here" — that is what he
      # asked for, and it is the opposite of what it means from the laptop (where
      # attaching would nest a second tmux inside the laptop's own).
      #
      # -A attaches the always-running omp-rig session if it exists and creates it
      # otherwise, so this works whether or not the keepalive service is up.
      if [[ -n ${TMUX:-} ]]; then
        # Already inside tmux on rig: switch instead of nesting.
        exec tmux switch-client -t "$SESSION" 2>/dev/null || exec tmux new-session -A -s "$SESSION" -c "$target"
      fi
      exec tmux new-session -A -s "$SESSION" -c "$target" ;;

    ssh|sh|shell)
      # The explicit escape hatch: a plain shell, no omp.
      cd "$target" 2>/dev/null || cd "$HOME"
      printf '%son rig — %s%s\n' "$c_d" "$PWD" "$c_0"
      exec "${SHELL:-/bin/bash}" -l ;;

    *)
      cd "$target" 2>/dev/null || cd "$HOME"
      exec omp "$@" ;;
  esac
fi

# Re-pin the host before connecting. `rig.local` resolves only when this laptop's
# systemd-resolved feels like answering mDNS (nsswitch has no mdns entry), which is
# how `ssh rig` intermittently died with "Temporary failure in name resolution".
# nhq-resolve asks avahi directly and rewrites the ssh include, so a changed DHCP
# lease after a power cut also fixes itself here.
"$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/nhq-resolve" rig --quiet >/dev/null 2>&1 || true

ssh -o BatchMode=yes -o ConnectTimeout=6 "$HOST" true 2>/dev/null \
  || die "cannot reach $HOST with keys (is it on? try: rig-off --status)"

case "${1:-}" in
  --status)
    exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/nhq-attach" rig --status
    ;;

  --attach)
    # The persistent session, for picking up the long-running conversation.
    exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/nhq-attach" rig
    ;;

  ''|ssh|sh|shell)
    # Plain shell, in the repo, on its main branch. -t for a real pty so the
    # remote login shell (fish) behaves normally.
    #
    # The remote login shell IS fish, and it does not speak `main=$(…)`. This used
    # to send the branch logic inline, so landing on rig printed a wall of
    # "fish: Unsupported use of '='" and dropped the connection. Two fixes, both
    # needed: run the command under bash explicitly, and keep the logic in
    # nhq-git-main rather than escaping a block that contains its own quotes.
    # The final `exec $SHELL -l` still hands Yash his fish prompt.
    # shellcheck disable=SC2029
    exec ssh -t "$HOST" "bash -lc 'cd $REPO 2>/dev/null || cd \$HOME; nhq-git-main; exec \$SHELL -l'"
    ;;

  --resume|--continue|-*)
    # omp flags — hand the whole argument list to omp on rig.
    #
    # Run omp DIRECTLY, not inside a remote tmux: this is usually invoked from the
    # laptop's own tmux, and nesting would leave the prefix key fighting itself.
    # For scrollback-in-tmux use `rig --attach`, which is what the persistent
    # session is for.
    q=""
    for a in "$@"; do q+=" $(printf '%q' "$a")"; done
    printf '%s→ omp on %s%s\n' "$c_d" "$HOST" "$c_0"
    # shellcheck disable=SC2029
    exec ssh -t "$HOST" "bash -lc 'export PATH=\$HOME/.local/bin:\$PATH; cd $REPO 2>/dev/null || cd \$HOME; exec omp$q'"
    ;;

  *)
    # A bare word used to be forwarded to omp, so `rig ssh` ran omp's OWN ssh
    # subcommand and printed "No SSH hosts configured" — which reads like rig is
    # broken when nothing is. Say what the options are instead of guessing.
    printf '%srig: don'\''t know "%s"%s\n\n' "$c_r" "$1" "$c_0" >&2
    sed -n '4,10p' "$(readlink -f "${BASH_SOURCE[0]:-$0}")" | sed 's/^# \?/  /' >&2
    printf '\n  %sinside omp you can also reach it directly: ssh://rig/home/bom/…%s\n' "$c_d" "$c_0" >&2
    exit 2
    ;;
esac
