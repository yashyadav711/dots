#!/usr/bin/env bash
# nhq-ask <agent> "<question>" [--read] — ephemeral one-shot ask to a fleet agent.
#
# Runs the target agent in one-shot PRINT mode: a throwaway process that loads the
# agent's CLAUDE.md + rules, answers, and EXITS. It creates NO persistent session
# and never attaches to / disturbs a live interactive session (e.g. Yash's Director
# session in nhq-agentic-os). Spawn -> ask -> answer -> close.
# Harness: `jcode run --quiet` when available (post omp→jcode migration 2026-07-19),
# else `omp -p --no-session`. Override with NHQ_ASK_HARNESS=jcode|omp.
#
# Default: --no-tools — a fast, tool-free, zero-side-effect reply (the agent answers
# from its loaded CLAUDE.md + .claude/rules context). Add `--read` to let the agent use
# tools (read repo files / its inbox) for a deeper answer; the prompt stays READ-ONLY.
#
# Logs the Q&A to <target-repo>/ai/<asker>-inbox.md so there's a who-asked-what trail.
#
# Usage:
#   nhq-ask director "Per-repo rules file, or one shared fleet rule?"
#   nhq-ask director "Summarize the 3 briefs in ai/envy-inbox.md" --read
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
# shellcheck source=/dev/null
source "$(dirname "$SELF")/nhq-lib.sh"

AGENT="${1:-}"; Q="${2:-}"; FLAG="${3:-}"
if [[ -z "$AGENT" || -z "$Q" ]]; then
  echo "usage: nhq-ask <agent> \"<question>\" [--read]" >&2
  exit 1
fi

KEY="$(nhq_agent_canon "$AGENT")"
if [[ -z "$KEY" ]]; then
  echo "nhq-ask: unknown agent '$AGENT' (see dots/bin/fleet-registry.json)" >&2
  exit 1
fi
REPO="$(nhq_agent_repo "$KEY")"
NAME="$(nhq_agent_name "$KEY")"
if [[ -z "$REPO" || ! -d "$REPO" ]]; then
  echo "nhq-ask: repo not found for '$KEY': ${REPO:-<unresolved>}" >&2
  exit 1
fi

# Who is asking (for the comms log). Resolve from the caller's context; fall back gracefully.
ASKER="$(nhq-agent-name 2>/dev/null || true)"; ASKER="${ASKER:-someone}"
ASKER_KEY="$(nhq_agent_canon "$ASKER" 2>/dev/null || true)"
[[ -z "$ASKER_KEY" ]] && ASKER_KEY="$(printf '%s' "$ASKER" | tr '[:upper:] ' '[:lower:]-')"

# Don't ask yourself.
if [[ -n "$ASKER_KEY" && "$ASKER_KEY" == "$KEY" ]]; then
  echo "nhq-ask: '$NAME' is you — nothing to ask." >&2
  exit 1
fi

# Default: tool-free intent (fast, safe — the agent's CLAUDE.md + rules load
# regardless). --read allows tools for a deeper answer; the prompt stays READ-ONLY.
# (omp enforces via --no-tools; jcode enforces via the READ-ONLY prompt contract +
# the pre_tool guards.)
HARNESS="${NHQ_ASK_HARNESS:-}"
if [[ -z "$HARNESS" ]]; then
  HARNESS=omp   # reverted 2026-07-28: NHQ defaults to omp (set NHQ_ASK_HARNESS=jcode to use jcode)
fi
TOOLS="--no-tools"
[[ "$FLAG" == "--read" || "$FLAG" == "--deep" ]] && TOOLS=""

PROMPT="$Q

[One-shot ask from '$ASKER' via nhq-ask. Answer concisely + decisively from your role and rules. READ-ONLY: do NOT edit / write / commit / push / branch — just answer. No need to run nhq-done; this is a direct reply.]"

echo "nhq-ask -> $NAME  (ephemeral $HARNESS one-shot; live sessions untouched)…" >&2
if [[ "$HARNESS" == jcode ]]; then
  ANSWER="$(cd "$REPO" && timeout 150 jcode run --quiet "$PROMPT" 2>/dev/null | sed '/^\[Tokens\]/d' || true)"
else
  ANSWER="$(cd "$REPO" && timeout 150 omp -p --no-session $TOOLS "$PROMPT" 2>/dev/null || true)"
fi

if [[ -z "${ANSWER//[[:space:]]/}" ]]; then
  echo "nhq-ask: no answer captured from $NAME (timed out or empty). Try again." >&2
  exit 1
fi

# Print the answer to stdout.
printf '%s\n' "$ANSWER"

# Log the Q&A to the target's comms inbox (who-asked-what trail). Coordination
# scaffolding (sanctioned carve-out from no-author-project-source); best-effort —
# never fail the ask on a logging error.
INBOX_DIR="$REPO/ai"
INBOX="$INBOX_DIR/${ASKER_KEY}-inbox.md"
if mkdir -p "$INBOX_DIR" 2>/dev/null; then
  {
    printf '\n## %s · %s -> %s (nhq-ask)\n**Q:** %s\n\n**A:** %s\n' \
      "$(date '+%Y-%m-%d %H:%M')" "$ASKER" "$NAME" "$Q" "$ANSWER" >> "$INBOX" \
      && echo "nhq-ask: logged -> ${INBOX/#$HOME/~}" >&2
  } || true
fi
