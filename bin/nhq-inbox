      dup=$('dup');

const kb=n=>n<1024?n+' B':n<1048576?(n/1024).toFixed(0)+' KB':n<1073741824?(n/1048576).toFixed(1)+' MB':(n/1073741824).toFixed(2)+' GB';
const esc=s=>s.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

let queue=[], upTo=null, agents=[], open_=false, here=new Set(), dupMode='replace';
// The key arrives once, in the URL the QR encodes, and is kept per device. It
// is stripped from the address bar straight away so it does not sit in
// screenshots or travel when the page is shared.
let key=localStorage.getItem('nhq-key')||'';
const qk=new URLSearchParams(location.search).get('k');
if(qk){ key=qk; localStorage.setItem('nhq-key',qk); history.replaceState({},'',location.pathname); }
punlock.onclick=()=>{ const v=pkey.value.trim(); if(!v) return;
  key=v; localStorage.setItem('nhq-key',v); pkey.value=''; refreshAgents(); };

// ── what will Send actually do ───────────────────────────────────────────────
// One button, one rule, decided by what you have given it. That is the point of
// the merge: you should not have to work out which panel your thought belongs
// in before you can start typing.
function plan(){
  const text=msg.value.trim();
  if(queue.length) return {kind:'files', text, to:upTo};
  if(!text)        return {kind:'none'};
  return upTo ? {kind:'prompt', text, to:upTo} : {kind:'clip', text};
}
const nameOf=k=>(agents.find(a=>a.key===k)||{}).label||k;
const liveOf=k=>!!(agents.find(a=>a.key===k)||{}).session;
const clashes=()=>queue.filter(f=>here.has(f.name)).map(f=>f.name);

function paint(){
  const p=plan(), locked=!key && !open_, dupes=clashes();
  log.innerHTML=queue.map(f=>
    `<div class="f"><div class="meta"><span class="nm">${esc(f.name)}</span>`
    +`<span class="sz">${kb(f.size)}${here.has(f.name)?' · already there':''}</span></div></div>`).join('');

  dup.hidden=!dupes.length;
  if(dupes.length){
    dup.querySelector('b').textContent = dupes.length===1
      ? `${dupes[0]} is already in the folder`
      : `${dupes.length} of these are already in the folder`;
    [...dup.querySelectorAll('[data-m]')].forEach(b=>
      b.classList.toggle('on', b.dataset.m===dupMode));
  }

  lockbox.hidden = !(locked && p.to);
  let label='Send', off=false, why='';
  if(p.kind==='none'){ off=true; }
  else if(p.kind==='clip'){ label='Send to laptop clipboard'; }
  else if(p.kind==='prompt'){ label=`Send to ${nameOf(p.to)}`; }
  else {
    const n = dupMode==='skip' ? queue.length-dupes.length : queue.length;
    label = n ? `Send ${n} file${n>1?'s':''}${p.to?` → ${nameOf(p.to)}`:''}`
              : 'Nothing to send';
    if(!n) off=true;
  }
  if(p.to && locked){ off=true; why='Unlock below to send to an agent.'; }
  else if(p.to && !liveOf(p.to)){ why=`${nameOf(p.to)} is offline — it will not arrive.`; }
  else if(dupes.length && dupMode==='skip'){ why=`Skipping ${dupes.length} already there.`; }
  else if(dupes.length){ why=`Replacing ${dupes.length} already there.`; }
  else if(p.kind==='clip'){ why='No name picked, so this goes to the clipboard.'; }
  send.textContent=label; send.disabled=off; hint.textContent=why;
}
msg.oninput=paint;
[...dup.querySelectorAll('[data-m]')].forEach(b=>
  b.onclick=()=>{ dupMode=b.dataset.m; paint(); });

async function refreshAgents(){
  try{
    const j=await (await fetch('/agents')).json();
    agents=j.agents; open_=!!j.open;
    to.innerHTML=agents.map(a=>
      `<button data-k="${a.key}" class="${a.session?'live':''}${a.key===upTo?' on':''}">
         <span class="dot"></span>${esc(a.label)}
         <span class="st">${a.session?'live':'offline'}</span>
       </button>`).join('');
    // Tapping the picked one again clears it — with nobody picked, text goes to
    // the clipboard and files just land in the folder, which is the common case.
    [...to.children].forEach(b=>b.onclick=()=>{
      upTo = (upTo===b.dataset.k) ? null : b.dataset.k; refreshAgents(); });
    paint();
  }catch(e){}
}
refreshAgents();
setInterval(()=>{ if(document.visibilityState==='visible') refreshAgents(); }, 10000);

// ── attaching ────────────────────────────────────────────────────────────────
const add=fs=>{ queue=queue.concat([...fs]); paint(); };
drop.onclick=()=>pick.click();
pick.onchange=e=>add(e.target.files);
cam.onclick=()=>camin.click();
camin.onchange=e=>add(e.target.files);
['dragenter','dragover'].forEach(t=>drop.addEventListener(t,e=>{e.preventDefault();drop.classList.add('hot');}));
['dragleave','drop'].forEach(t=>drop.addEventListener(t,e=>{e.preventDefault();drop.classList.remove('hot');}));
drop.addEventListener('drop',e=>add(e.dataTransfer.files));

const said=(t,ok)=>{ sendlog.innerHTML=`<div class="f"><span class="${ok?'ok':''}">${esc(t)}</span></div>`; };
function clearComposer(){
  queue=[]; msg.value=''; upTo=null; dupMode='replace';
  pick.value=''; camin.value=''; refreshAgents(); list();
}

// ── sending ──────────────────────────────────────────────────────────────────
// Three destinations behind one button. The endpoints stay single-purpose and
// separately testable; only the routing lives here.
send.onclick=async()=>{
  const p=plan(); if(p.kind==='none') return;
  send.disabled=true;

  if(p.kind==='clip'){
    try{ const j=await (await fetch('/text',{method:'POST',
           headers:{'Content-Type':'application/json'},
           body:JSON.stringify({text:p.text})})).json();
         said(j.ok?'On the laptop clipboard':'Clipboard unreachable', j.ok);
         if(j.ok) msg.value='';
    }catch(e){ said('Failed', false); }
    paint(); return;
  }

  if(p.kind==='prompt'){
    try{ const j=await (await fetch('/prompt',{method:'POST',
           headers:{'Content-Type':'application/json'},
           body:JSON.stringify({target:p.to, text:p.text, k:key})})).json();
         said(j.ok?('Sent to '+j.session):(j.error||'Failed'), j.ok);
         if(j.ok) clearComposer();
    }catch(e){ said('Failed', false); }
    paint(); return;
  }

  const fd=new FormData();
  queue.forEach(f=>fd.append('files',f,f.name));
  if(p.text) fd.append('note', p.text);
  fd.append('dupes', dupMode);
  if(p.to){ fd.append('to', p.to); if(key) fd.append('k', key); }
  const xhr=new XMLHttpRequest(); xhr.open('POST','/upload');
  bar.style.display='block';
  xhr.upload.onprogress=e=>{ if(e.lengthComputable) fill.style.width=(e.loaded/e.total*100)+'%'; };
  xhr.onload=()=>{
    bar.style.display='none'; fill.style.width='0';
    let text='Sent', ok=true;
    try{ const j=JSON.parse(xhr.responseText);
         const n=(j.saved||[]).length, s=(j.skipped||[]).length;
         text = `Sent ${n} file${n===1?'':'s'}` + (s?`, skipped ${s}`:'');
         // Say plainly whether the agent got it. A file that saved but was
         // never handed over, reported as a plain "Sent", is the kind of thing
         // you discover an hour later when nothing has happened.
         if(j.handoff){ ok=!!j.handoff.ok;
           text += ok ? ' → '+j.handoff.session
                      : ' — but '+(j.handoff.error||'not delivered'); }
    }catch(e){}
    said(text, ok); clearComposer();
  };
  xhr.onerror=()=>{ bar.style.display='none'; said('Upload failed — retry', false); paint(); };
  xhr.send(fd);
};

tpull.onclick=async()=>{
  tpull.disabled=true;
  try{ const j=await (await fetch('/clip')).json();
       msg.value=j.text||'';
       said(j.text?('Pulled '+j.text.length+' chars'):'Laptop clipboard is empty', !!j.text);
  }catch(e){ said('Failed', false); }
  tpull.disabled=false; paint();
};

async function del(name){
  await fetch('/rm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});
  list();
}

async function list(){
  try{
    const r=await fetch('/files'); const j=await r.json();
    // The folder's current names, so a queued file can be flagged as a
    // duplicate BEFORE it is sent rather than quietly renamed afterwards.
    // Refreshed on the same poll, so a file the agent drops in while the page
    // is open starts colliding immediately.
    here=new Set(j.files.map(f=>f.name));
    paint();
    count.textContent=j.files.length?j.files.length+' · '+kb(j.bytes):'';
    if(!j.files.length){ recent.innerHTML='<div class="f"><span class="empty">Empty — nothing waiting</span></div>'; return; }
    recent.innerHTML=j.files.map(f=>{
      const thumb=f.kind==='image'
        ? `<img src="/thumb/${encodeURIComponent(f.name)}" loading="lazy" alt="">`
        : `<div class="tag">${f.kind==='video'?'vid':(f.ext||'file')}</div>`;
      return `<div class="f">
        <a href="/dl/${encodeURIComponent(f.name)}" download>
          ${thumb}
          <div class="meta"><span class="nm">${esc(f.name)}</span><span class="sz">${kb(f.size)} &middot; ${f.when}</span>${f.note?`<span class="note">${esc(f.note)}</span>`:''}</div>
        </a>
        <button class="x" onclick="del('${encodeURIComponent(f.name).replace(/'/g,"\\'")}')" aria-label="delete">&times;</button>
      </div>`;
    }).join('');
  }catch(e){}
}
$('refresh').onclick=list;
list();
// The agent writes into this folder too, so poll — a file that appears while the
// page is open should just show up.
setInterval(()=>{ if(document.visibilityState==='visible') list(); }, 5000);

// ── itihaas ──────────────────────────────────────────────────────────────────
// Fire and forget: the pipeline runs for 15-25 minutes, so the POST only starts it
// and the run list is polled. Holding the request open would mean the phone
// screen locking could look like a failure.
const iname=$('iname'), igo=$('igo'), ilog=$('ilog'), iruns=$('iruns');
const isaid=(t,good)=>{ ilog.innerHTML=`<div class="f"><span class="${good?'ok':''}">${esc(t)}</span></div>`; };
igo.onclick=async()=>{
  const n=iname.value.trim(); if(!n) return;
  igo.disabled=true;
  try{
    const j=await (await fetch('/itihaas',{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({name:n, k:key})})).json();
    isaid(j.ok?`Chalu — ${n}. Notebook ban raha hai, yahin niche progress dikhega.`
              :(j.error||'Failed'), j.ok);
    if(j.ok) iname.value='';
  }catch(e){ isaid('Failed', false); }
  igo.disabled=false; iruns_refresh();
};
iname.addEventListener('keydown', e=>{ if(e.key==='Enter') igo.click(); });
async function iruns_refresh(){
  try{
    const j=await (await fetch('/itihaas')).json();
    const rs=j.runs||[];
    iruns.innerHTML = rs.map(r=>
      `<div class="f"><div class="meta"><span class="nm">${esc(r.name)}</span>`
      +`<span class="sz">${esc(r.stage)}`
      +(r.notebook?` · <a href="https://notebooklm.google.com/notebook/${encodeURIComponent(r.notebook)}" target="_blank" rel="noopener">notebook</a>`:'')
      +`</span></div></div>`).join('');
  }catch(e){}
}
iruns_refresh();
setInterval(()=>{ if(document.visibilityState==='visible') iruns_refresh(); }, 15000);
</script></body></html>"""


def serve() -> None:
    from fastapi import FastAPI, Request
    from fastapi.responses import HTMLResponse, JSONResponse, FileResponse, Response
    import uvicorn

    DEST.mkdir(parents=True, exist_ok=True)
    app = FastAPI(title="NHQ Inbox", docs_url=None, redoc_url=None)

    @app.get("/", response_class=HTMLResponse)
    async def index() -> str:
        return PAGE

    @app.get("/files")
    async def files() -> JSONResponse:
        items, total = [], 0
        for p in sorted(
            (x for x in DEST.iterdir() if x.is_file()),
            key=lambda x: x.stat().st_mtime, reverse=True,
        ):
            # A note belongs TO a file, so it is shown on that file's row rather
            # than as a row of its own. Listing both would put a 200-byte .md
            # beside every screenshot and make the folder look twice as full as
            # it is.
            if p.name.endswith(".note.md"):
                continue
            st = p.stat()
            total += st.st_size
            side = DEST / f"{p.name}.note.md"
            items.append({
                "name": p.name,
                "size": st.st_size,
                "kind": kind_of(p),
                "ext": p.suffix.lstrip(".").lower()[:4],
                "when": datetime.fromtimestamp(st.st_mtime).strftime("%H:%M"),
                "note": side.read_text()[:400].strip() if side.exists() else "",
            })
        return JSONResponse({"files": items, "bytes": total})

    @app.get("/dl/{name}")
    async def download(name: str):
        p = inside(name)
        if not p:
            return JSONResponse({"error": "not found"}, status_code=404)
        return FileResponse(p, filename=p.name)

    @app.get("/thumb/{name}")
    async def thumb(name: str):
        p = inside(name)
        if not p or kind_of(p) != "image":
            return JSONResponse({"error": "not an image"}, status_code=404)
        try:
            from PIL import Image
            import io
            with Image.open(p) as im:
                im.draft("RGB", (256, 256))       # cheap decode for big JPEGs
                im = im.convert("RGB")
                im.thumbnail((128, 128))
                buf = io.BytesIO()
                im.save(buf, "JPEG", quality=72)
            return Response(
                buf.getvalue(), media_type="image/jpeg",
                headers={"Cache-Control": "max-age=60"},
            )
        except Exception:
            return JSONResponse({"error": "unreadable"}, status_code=404)

    @app.post("/text")
    async def text(request: Request) -> JSONResponse:
        body = await request.json()
        t = (body or {}).get("text") or ""
        if not t.strip():
            return JSONResponse({"ok": False, "error": "empty"}, status_code=400)
        ok = clip_write(t)
        print(f"[{datetime.now():%H:%M:%S}] clipboard <- {len(t)} chars "
              f"({'ok' if ok else 'FAILED'})", flush=True)
        return JSONResponse({"ok": ok})

    @app.get("/clip")
    async def clip() -> JSONResponse:
        return JSONResponse({"text": clip_read()[:100_000]})

    @app.get("/agents")
    async def agents() -> JSONResponse:
        return JSONResponse({
            "open": open_mode(),
            "agents": [
                {"key": k, "label": label, "session": agent_where(k)}
                for k, label in AGENTS
            ],
        })

    @app.post("/prompt")
    async def prompt(request: Request) -> JSONResponse:
        """Type a prompt into a live agent session.

        The only endpoint here that needs the key. Everything else on this page
        moves files and clipboard text; this one reaches an agent that can run
        commands on the laptop, so it is not something the whole WiFi should be
        able to do just by finding the port.

        The target is matched against the shortlist rather than passed through.
        nhq-tell is invoked as argv so there is no shell to inject into either
        way, but an endpoint that will start work on this machine should accept
        the three names it means and nothing else.
        """
        body = await request.json() or {}
        if not open_mode() and not secrets.compare_digest(str(body.get("k") or ""), token()):
            return JSONResponse({"ok": False, "error": "locked — scan the QR on the laptop"},
                                status_code=403)
        target = str(body.get("target") or "")
        if target not in {k for k, _ in AGENTS}:
            return JSONResponse({"ok": False, "error": "unknown agent"}, status_code=400)
        text = (body.get("text") or "").strip()
        if not text:
            return JSONResponse({"ok": False, "error": "empty"}, status_code=400)

        session = agent_where(target)
        ok, detail = agent_send(target, text)
        print(f"[{datetime.now():%H:%M:%S}] prompt -> {target} "
              f"({session or 'offline'}): {'ok' if ok else detail}", flush=True)
        if not ok:
            return JSONResponse({"ok": False, "error": detail}, status_code=409)
        return JSONResponse({"ok": True, "session": session})

    @app.post("/itihaas")
    async def itihaas_start(request: Request) -> JSONResponse:
        """Start `nhq-itihaas <name>` for one person, detached.

        Keyed like /prompt and for the same reason: this starts work on the laptop.
        The name is passed as argv, never through a shell, so a name with quotes in
        it is a name and not a command.

        Detached on purpose. The pipeline runs 15-25 minutes; a phone that locks its
        screen mid-request must not look like a failed run, and the answer the page
        needs ("kahan tak pahuncha") comes from the state files instead.
        """
        body = await request.json() or {}
        if not open_mode() and not secrets.compare_digest(str(body.get("k") or ""), token()):
            return JSONResponse({"ok": False, "error": "locked — scan the QR on the laptop"},
                                status_code=403)
        name = re.sub(r"\s+", " ", str(body.get("name") or "")).strip()
        if not (2 <= len(name) <= 80):
            return JSONResponse({"ok": False, "error": "naam daalo (2-80 characters)"},
                                status_code=400)

        tool = shutil.which("nhq-itihaas")
        if not tool:
            return JSONResponse({"ok": False, "error": "nhq-itihaas not on PATH"},
                                status_code=500)
        ITIHAAS_STATE.mkdir(parents=True, exist_ok=True)
        slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "unnamed"
        log = ITIHAAS_STATE / f"{slug}.log"
        with log.open("ab") as fh:
            fh.write(f"\n=== {datetime.now():%Y-%m-%d %H:%M:%S} {name} ===\n".encode())
            subprocess.Popen([tool, name, "--deep"], stdout=fh, stderr=fh,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        print(f"[{datetime.now():%H:%M:%S}] itihaas -> {name}", flush=True)
        return JSONResponse({"ok": True, "name": name})

    @app.get("/itihaas")
    async def itihaas_runs() -> JSONResponse:
        """Every run and the stage it is on, newest first.

        Read straight off the state files the tool writes, so this stays correct
        even for runs started from the laptop's shell rather than this page.
        """
        # Two maps, not one label plus a glued-on suffix: that produced
        # "ban rahe hain chal raha hai". A stage in progress and the same stage
        # finished are different sentences in Hinglish, so they are written out.
        RUNNING = {
            "auth": "auth ho raha hai", "notebook": "notebook ban raha hai",
            "research": "deep research chal rahi hai",
            "artifacts": "report/slides/video queue ho rahe hain",
            "generation": "NotebookLM bana raha hai", "download": "download ho raha hai",
        }
        REACHED = {
            "auth": "auth ho gaya", "notebook": "notebook ban gaya",
            "research": "research ho gayi", "sources": "sources aa gaye",
            "artifacts": "queue ho gaye", "generation": "ban gaye",
            "download": "download ho gaya", "done": "poora ho gaya",
        }
        runs = []
        for f in sorted(ITIHAAS_STATE.glob("*.json"),
                        key=lambda p: p.stat().st_mtime, reverse=True)[:8]:
            try:
                d = json.loads(f.read_text())
            except Exception:
                continue
            stages = d.get("stages") or {}
            stage = "shuru ho raha hai"
            for k, v in stages.items():
                s = v.get("status")
                if s == "failed":
                    stage = f"{REACHED.get(k, k)} — ruk gaya"
                    break
                stage = RUNNING.get(k, k) if s == "running" else REACHED.get(k, k)
            if "done" in stages:
                stage = "poora ho gaya"
            runs.append({"name": d.get("name") or f.stem,
                         "stage": stage,
                         "notebook": d.get("notebook") or ""})
        return JSONResponse({"runs": runs})

    @app.post("/rm")
    async def rm(request: Request) -> JSONResponse:
        body = await request.json()
        p = inside((body or {}).get("name") or "")
        if not p:
            return JSONResponse({"error": "not found"}, status_code=404)
        p.unlink()
        # The note goes with it. A sidecar whose file is gone is never seen
        # again — it is hidden from the listing by design — so it would just
        # accumulate in a folder that is supposed to end up empty.
        (DEST / f"{p.name}.note.md").unlink(missing_ok=True)
        print(f"[{datetime.now():%H:%M:%S}] deleted {p.name}", flush=True)
        return JSONResponse({"ok": True})

    # Read the form off the Request directly. A `list[UploadFile]` signature
    # cannot be used here: `from __future__ import annotations` turns it into a
    # string, and this handler lives inside serve(), so Pydantic cannot resolve
    # the forward reference and every upload 500s. Verified 2026-08-12.
    @app.post("/upload")
    async def upload(request: Request) -> JSONResponse:
        form = await request.form()
        files = [v for v in form.getlist("files") if hasattr(v, "read")]
        if not files:
            return JSONResponse({"error": "no files in request"}, status_code=400)
        # What to do when the name is already in the folder. It used to always
        # be a third thing — `unique_path` quietly appended a timestamp — which
        # is the one answer nobody asks for: you send a corrected screenshot and
        # end up with two, neither obviously the current one. Yash asked for the
        # choice, so: replace, or skip. `keep` stays reachable for a caller that
        # wants the old behaviour, but nothing in the UI offers it.
        mode = str(form.get("dupes") or "replace")
        saved, skipped = [], []
        for f in files:
            name = safe_name(f.filename or "file")
            existing = DEST / name
            if existing.exists():
                if mode == "skip":
                    skipped.append(name)
                    print(f"[{datetime.now():%H:%M:%S}] skipped {name} (already there)", flush=True)
                    # Drain it anyway: an unread upload leaves the request body
                    # half-consumed and the connection in an odd state.
                    while await f.read(1024 * 1024):
                        pass
                    continue
                target = existing if mode == "replace" else unique_path(name)
            else:
                target = existing
            written = 0
            with target.open("wb") as out:
                while chunk := await f.read(1024 * 1024):
                    written += len(chunk)
                    if written > MAX_BYTES:
                        out.close()
                        target.unlink(missing_ok=True)
                        return JSONResponse({"error": f"{target.name} over 2 GB"}, status_code=413)
                    out.write(chunk)
            saved.append(target.name)
            print(f"[{datetime.now():%H:%M:%S}] saved {target.name} ({written} bytes)", flush=True)

        # The optional note, written as a sidecar NEXT TO each file rather than
        # as one file for the batch. A screenshot and "the button is misaligned"
        # are useless apart, and whoever opens the folder later opens a file —
        # not an index — so the note has to be wherever they land. Duplicating a
        # line of text across three sidecars costs nothing and means it cannot
        # be missed.
        note = str(form.get("note") or "").strip()
        if note:
            for name in saved:
                body = note if len(saved) == 1 else (
                    f"{note}\n\nSent together with: " + ", ".join(saved))
                (DEST / f"{name}.note.md").write_text(body + "\n")
            print(f"[{datetime.now():%H:%M:%S}] note ({len(note)} chars) on "
                  f"{len(saved)} file(s)", flush=True)

        # Optionally hand it straight to an agent instead of leaving it to be
        # found. The message carries ABSOLUTE paths, because the agent's working
        # directory is its own repo and a bare filename would mean nothing
        # there — and the note, because "look at this screenshot" without the
        # sentence that goes with it is the problem this whole feature exists
        # to solve.
        #
        # Same key as /prompt, for the same reason: this reaches something that
        # runs commands. Files still land in the folder either way, so a refused
        # handoff loses the notification and not the upload.
        handoff = None
        want = str(form.get("to") or "")
        # Nothing saved means everything was skipped as a duplicate. Waking an
        # agent to tell it about zero files is worse than saying nothing.
        if want and saved:
            if want not in {k for k, _ in AGENTS}:
                handoff = {"ok": False, "error": "unknown agent"}
            elif not open_mode() and not secrets.compare_digest(
                    str(form.get("k") or ""), token()):
                handoff = {"ok": False, "error": "locked — scan the QR on the laptop"}
            else:
                # ONE LINE, no newlines anywhere in it. nhq-tell types the
                # message with `tmux send-keys -l`, and a literal newline in
                # there arrives as Enter — which submits the prompt half-typed
                # and scatters the rest across the next turns. Caught in
                # testing 2026-08-13; a multi-line message looked fine in the
                # pane and would have broken a real session.
                paths = " ".join(str(DEST / n) for n in saved)
                body = f"From the NHQ inbox — {len(saved)} file(s): {paths}"
                if note:
                    body += f" — {note}"
                body = " ".join(body.split())
                ok, detail = agent_send(want, body)
                handoff = ({"ok": True, "session": agent_where(want)} if ok
                           else {"ok": False, "error": detail})
            print(f"[{datetime.now():%H:%M:%S}] handoff -> {want}: "
                  f"{'ok' if handoff.get('ok') else handoff.get('error')}", flush=True)
        return JSONResponse({"saved": saved, "skipped": skipped,
                             "note": bool(note), "handoff": handoff})

    p = int(os.environ.get("NHQ_INBOX_PORT") or port() or port(claim=True) or "3900")
    print(f"nhq-inbox -> http://{lan_ip()}:{p}  (sharing {DEST})", flush=True)
    uvicorn.run(app, host="0.0.0.0", port=p, log_level="warning")


# --------------------------------------------------------------------- cli

UNIT_TEXT = """[Unit]
Description=NHQ Inbox — LAN file + clipboard bridge to ~/Github/nhq-local-downloads
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=NHQ_INBOX_PORT={port}
Environment=NHQ_INBOX_LOCK={lock}
ExecStart={exe} serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
"""


def sysctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def cmd_start() -> int:
    DEST.mkdir(parents=True, exist_ok=True)
    p = port() or port(claim=True)
    UNIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    # `NHQ_INBOX_LOCK=1 nhq-inbox start` sticks, rather than applying once and
    # vanishing on the next restart. Re-running plain `start` keeps whatever the
    # unit already said, so turning the lock on does not need re-arming daily.
    UNIT_PATH.write_text(UNIT_TEXT.format(
        port=p, exe=os.path.abspath(__file__),
        lock="0" if open_mode() else "1",
    ))
    sysctl("daemon-reload")
    sysctl("enable", "--now", UNIT)
    sysctl("restart", UNIT)
    time.sleep(1.5)
    return cmd_status()


def cmd_stop() -> int:
    sysctl("disable", "--now", UNIT)
    subprocess.run(["nhq-port", "release", CLAIM], capture_output=True)
    print("nhq-inbox stopped, port released")
    return 0


def shared_url() -> str | None:
    """The URL to hand the phone.

    Plain while prompting is open, which is the default — no key to carry, and
    nothing in the address to leak if the URL is pasted somewhere. It only picks
    up `?k=` when NHQ_INBOX_LOCK=1 has actually turned locking on, so scanning
    the QR is still all a device needs in that mode.
    """
    p = port()
    if not p:
        return None
    base = f"http://{lan_ip()}:{p}"
    return base if open_mode() else f"{base}?k={token()}"


def cmd_url() -> int:
    url = shared_url()
    if not url:
        print("not running — `nhq-inbox start` first", file=sys.stderr)
        return 1
    print(url)
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=url, text=True, env=wl_env())
    return 0


def qr_block(url: str) -> None:
    """Draw the URL as a scannable code, if the terminal can carry one.

    Yash asked for this on `status` too, not just `qr`: the whole point of the
    box is that the phone reaches it, and reading an IP off one screen to type
    it into another is the one step that made him not bother. Silent when
    qrencode is missing or output is piped — a QR in a log file helps nobody.
    """
    if not shutil.which("qrencode") or not sys.stdout.isatty():
        return
    print()
    subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "1", url])


def cmd_qr() -> int:
    """A QR beats reading an IP off a screen and typing it on a phone."""
    url = shared_url()
    if not url:
        print("not running — `nhq-inbox start` first", file=sys.stderr)
        return 1
    if not shutil.which("qrencode"):
        print(url)
        print("(install qrencode for a scannable code)", file=sys.stderr)
        return 0
    subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "1", url])
    print(url)
    return 0


def cmd_clear() -> int:
    n = bytes_ = 0
    for f in DEST.iterdir() if DEST.exists() else []:
        if f.is_file():
            bytes_ += f.stat().st_size
            f.unlink()
            n += 1
    print(f"cleared {n} file(s), {bytes_/1048576:.1f} MB")
    return 0


def cmd_open() -> int:
    DEST.mkdir(parents=True, exist_ok=True)
    subprocess.Popen(["xdg-open", str(DEST)], env=wl_env(),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(DEST)
    return 0


def cmd_status() -> int:
    active = sysctl("is-active", UNIT).stdout.strip()
    p = port()
    files = [f for f in DEST.iterdir() if f.is_file()] if DEST.exists() else []
    total = sum(f.stat().st_size for f in files)
    url = f"http://{lan_ip()}:{p}" if p else ""
    print(f"service : {active}")
    print(f"url     : {url}" if url else "url     : (no port claimed)")
    print(f"folder  : {DEST}")
    print(f"files   : {len(files)} ({total/1048576:.1f} MB)")
    # The QR carries the key; the printed line does not. Scanning it unlocks
    # prompting on that phone, while a status pasted into a chat stays harmless.
    if url and active == "active":
        qr_block(shared_url() or url)
    return 0 if active == "active" else 1


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    table = {
        "serve": serve, "start": cmd_start, "stop": cmd_stop, "status": cmd_status,
        "url": cmd_url, "qr": cmd_qr, "clear": cmd_clear, "open": cmd_open,
    }
    fn = table.get(cmd)
    if not fn:
        print(__doc__)
        return 1
    return fn() or 0


if __name__ == "__main__":
    sys.exit(main())
