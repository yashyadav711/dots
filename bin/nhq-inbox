#!/usr/bin/env python3
"""nhq-inbox — the handover point between Yash's phone and the agent on the laptop.

Open the URL on the phone. Files you send land in ~/Github/nhq-local-downloads;
files the agent leaves there are listed for you to pull back. Text goes straight
onto the laptop's clipboard and back.

    nhq-inbox start     claim a port, install + start the user service
    nhq-inbox stop      stop the service and release the port
    nhq-inbox status    is it up, on which URL, how many files
    nhq-inbox url       print the URL (and copy it to the clipboard)
    nhq-inbox qr        print a scannable QR of the URL — never type the IP again
    nhq-inbox clear     empty the drop folder (an inbox should end up empty)
    nhq-inbox open      open the drop folder in the file manager
    nhq-inbox serve     run in the foreground (what the service runs)

WHAT IT DOES, both directions:
  phone -> laptop   files (tap, drag-drop, or straight from the camera)
  phone -> laptop   text: pasted text lands on the laptop's Wayland clipboard
  laptop -> phone   any file in the drop folder, tap to download, images preview
  laptop -> phone   the laptop's current clipboard, pulled on demand

WHY A CLAIMED PORT: `nhq-port` owns 3900-3909 and those are the only ports open
in ufw. Picking one by hand is how a URL ends up unreachable from the tablet.

WHY default.target: measured 2026-08-12 on this box — `graphical-session.target`
never activates, so anything WantedBy it silently never starts after a session
restart (that is what killed `vox`). This unit needs no display, so it survives
logout and reboot.

WHY Wants= AND After= ON network-online: `After=` alone only orders the unit, it
does not pull the target in. Without `Wants=`, on a cold boot the unit can start
before the LAN address exists and bind to nothing useful.

WHY THE CLIPBOARD NEEDS A SOCKET LOOKUP: `wl-copy` talks to the compositor and
needs WAYLAND_DISPLAY, which a systemd user service does not inherit. Rather than
depend on `import-environment` having been run, `wl_env()` finds the live
`wayland-N` socket in XDG_RUNTIME_DIR at call time.

No auth: this binds to the home LAN, behind the router, matching the rest of the
NHQ tooling. Note it now serves downloads too, so anyone on the WiFi can read the
drop folder — that folder is a scratch handover point, keep nothing precious in it.
Downloads are pinned to that one directory; `..` in a name cannot escape it.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
DEST = Path(os.environ.get("NHQ_INBOX_DIR", HOME / "Github/nhq-local-downloads"))
CLAIM = "inbox"
UNIT = "nhq-inbox.service"
UNIT_PATH = HOME / ".config/systemd/user" / UNIT
MAX_BYTES = 2 * 1024 * 1024 * 1024  # 2 GB per file — video from the phone fits

SAFE = re.compile(r"[^A-Za-z0-9._ -]")
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".heic", ".avif"}
VIDEO_EXT = {".mp4", ".mov", ".mkv", ".webm", ".avi", ".m4v"}


# ----------------------------------------------------------------- helpers

def lan_ip() -> str:
    """The address the tablet can actually reach — not 127.0.0.1, not a docker bridge."""
    try:
        out = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"],
            capture_output=True, text=True, check=True,
        ).stdout
    except Exception:
        return "127.0.0.1"
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        iface, cidr = parts[1], parts[3]
        if iface.startswith(("docker", "br-", "veth", "virbr")):
            continue
        return cidr.split("/")[0]
    return "127.0.0.1"


def port(claim: bool = False) -> str | None:
    if claim:
        return subprocess.run(
            ["nhq-port", "claim", CLAIM], capture_output=True, text=True, check=True
        ).stdout.strip()
    out = subprocess.run(["nhq-port", "list"], capture_output=True, text=True).stdout
    for line in out.splitlines()[1:]:          # skip the PORT/NAME/PID/SINCE header
        cols = line.split()
        if len(cols) >= 2 and cols[0].isdigit() and cols[1] == CLAIM:
            return cols[0]
    return None


def safe_name(raw: str) -> str:
    """Never trust an upload's filename: strip any path, keep it boring."""
    base = os.path.basename((raw or "file").replace("\\", "/")).strip()
    base = SAFE.sub("_", base) or "file"
    return base[:120]


def unique_path(name: str) -> Path:
    target = DEST / name
    if not target.exists():
        return target
    stem, ext = os.path.splitext(name)
    return DEST / f"{stem}-{datetime.now():%H%M%S}{ext}"


def inside(name: str) -> Path | None:
    """Resolve a requested name to a real file, or None. The only door to the disk.

    `safe_name` already flattens any path, and this re-checks the resolved parent,
    so a crafted `../../etc/passwd` lands as `.._.._etc_passwd` and then fails to
    exist rather than escaping. Both belts stay on deliberately.
    """
    p = (DEST / safe_name(name)).resolve()
    try:
        if p.parent != DEST.resolve() or not p.is_file():
            return None
    except OSError:
        return None
    return p


def kind_of(p: Path) -> str:
    ext = p.suffix.lower()
    return "image" if ext in IMAGE_EXT else "video" if ext in VIDEO_EXT else "file"


def wl_env() -> dict:
    """Environment a Wayland clipboard tool needs, found live rather than inherited."""
    env = dict(os.environ)
    run = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env["XDG_RUNTIME_DIR"] = run
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(
            s.name for s in Path(run).glob("wayland-*")
            if not s.name.endswith((".lock", ".sock"))
        )
        if socks:
            env["WAYLAND_DISPLAY"] = socks[0]
    return env


def clip_write(text: str) -> bool:
    """Put text on the laptop clipboard. Detached, because wl-copy must outlive us:
    on Wayland the clipboard is owned by a live client, so if wl-copy dies the
    paste buffer dies with it."""
    if not shutil.which("wl-copy"):
        return False
    try:
        subprocess.Popen(
            ["wl-copy", "--", text], env=wl_env(), start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return True
    except Exception:
        return False


def clip_read() -> str:
    if not shutil.which("wl-paste"):
        return ""
    try:
        r = subprocess.run(
            ["wl-paste", "--no-newline"], env=wl_env(),
            capture_output=True, text=True, timeout=4,
        )
        return r.stdout if r.returncode == 0 else ""
    except Exception:
        return ""


# ------------------------------------------------------------------ server

