#!/usr/bin/env python3
"""nhq-inbox — the handover point between Yash's phone and the agent on the laptop.

Open the URL on the phone. Files you send land in ~/Github/nhq-local-downloads;
files the agent leaves there are listed for you to pull back. Text goes straight
onto the laptop's clipboard and back.

    nhq-inbox start     claim a port, install + start the user service
    nhq-inbox stop      stop the service and release the port
    nhq-inbox status    is it up, on which URL, how many files
    nhq-inbox url       print the URL (and copy it to the clipboard)
    nhq-inbox qr        print a scannable QR of the URL — never type the IP again
    nhq-inbox clear     empty the drop folder (an inbox should end up empty)
    nhq-inbox open      open the drop folder in the file manager
    nhq-inbox serve     run in the foreground (what the service runs)

WHAT IT DOES, both directions:
  phone -> laptop   files (tap, drag-drop, or straight from the camera), with
                    an optional note saved as a sidecar next to each one
  phone -> laptop   text: pasted text lands on the laptop's Wayland clipboard
  phone -> laptop   a PROMPT typed straight into a live agent's session
  laptop -> phone   any file in the drop folder, tap to download, images preview
  laptop -> phone   the laptop's current clipboard, pulled on demand

PROMPTING AN AGENT: pick Director / NV / Builder, type, send. It resolves the
name through `nhq-tell`, which owns the lookup from an agent to whichever tmux
session that agent is sitting in — the registry and the slug rule are its
business, not this file's. If nobody is home the panel says offline and the
send is refused rather than dropped silently. Replies come back the way they
always do: the agent's own Telegram notification when it finishes.

WHY A CLAIMED PORT: `nhq-port` owns 3900-3909 and those are the only ports open
in ufw. Picking one by hand is how a URL ends up unreachable from the tablet.

WHY default.target: measured 2026-08-12 on this box — `graphical-session.target`
never activates, so anything WantedBy it silently never starts after a session
restart (that is what killed `vox`). This unit needs no display, so it survives
logout and reboot.

WHY Wants= AND After= ON network-online: `After=` alone only orders the unit, it
does not pull the target in. Without `Wants=`, on a cold boot the unit can start
before the LAN address exists and bind to nothing useful.

WHY THE CLIPBOARD NEEDS A SOCKET LOOKUP: `wl-copy` talks to the compositor and
needs WAYLAND_DISPLAY, which a systemd user service does not inherit. Rather than
depend on `import-environment` having been run, `wl_env()` finds the live
`wayland-N` socket in XDG_RUNTIME_DIR at call time.

FILES AND CLIPBOARD HAVE NO AUTH: they bind to the home LAN, behind the router,
matching the rest of the NHQ tooling. Anyone on the WiFi can read the drop
folder — it is a scratch handover point, keep nothing precious in it. Downloads
are pinned to that one directory; `..` in a name cannot escape it.

PROMPTING IS OPEN TOO, by default, on the same reasoning — and note what that
means: anyone who can reach this port can start an agent that runs shell
commands on this laptop. It ships open because that is this box's own posture
and because a key on the panel locked Yash out twice; a QR scanned by the
camera app opens in that app's browser, and localStorage does not carry across
to the one he reads in. Turn it on with one line in the unit —
`Environment=NHQ_INBOX_LOCK=1`, or `NHQ_INBOX_LOCK=1 nhq-inbox start`, which
writes it there — the day this port is reachable from anything but his WiFi.
The key then lives in ~/.config/nhq/inbox-token and rides in the QR.
"""

import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
DEST = Path(os.environ.get("NHQ_INBOX_DIR", HOME / "Github/nhq-local-downloads"))
CLAIM = "inbox"
UNIT = "nhq-inbox.service"
UNIT_PATH = HOME / ".config/systemd/user" / UNIT
MAX_BYTES = 2 * 1024 * 1024 * 1024  # 2 GB per file — video from the phone fits
# Written by nhq-itihaas, read by this page. Shared path, not a shared process:
# runs started from the laptop's shell show up here too.
ITIHAAS_STATE = HOME / ".nhq/itihaas"

SAFE = re.compile(r"[^A-Za-z0-9._ -]")
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".heic", ".avif"}
VIDEO_EXT = {".mp4", ".mov", ".mkv", ".webm", ".avi", ".m4v"}


# ----------------------------------------------------------------- helpers

def lan_ip() -> str:
    """The address the tablet can actually reach — not 127.0.0.1, not a docker bridge."""
    try:
        out = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"],
            capture_output=True, text=True, check=True,
        ).stdout
    except Exception:
        return "127.0.0.1"
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        iface, cidr = parts[1], parts[3]
        if iface.startswith(("docker", "br-", "veth", "virbr")):
            continue
        return cidr.split("/")[0]
    return "127.0.0.1"


def port(claim: bool = False) -> str | None:
    if claim:
        return subprocess.run(
            ["nhq-port", "claim", CLAIM], capture_output=True, text=True, check=True
        ).stdout.strip()
    out = subprocess.run(["nhq-port", "list"], capture_output=True, text=True).stdout
    for line in out.splitlines()[1:]:          # skip the PORT/NAME/PID/SINCE header
        cols = line.split()
        if len(cols) >= 2 and cols[0].isdigit() and cols[1] == CLAIM:
            return cols[0]
    return None


def safe_name(raw: str) -> str:
    """Never trust an upload's filename: strip any path, keep it boring."""
    base = os.path.basename((raw or "file").replace("\\", "/")).strip()
    base = SAFE.sub("_", base) or "file"
    return base[:120]


def unique_path(name: str) -> Path:
    target = DEST / name
    if not target.exists():
        return target
    stem, ext = os.path.splitext(name)
    return DEST / f"{stem}-{datetime.now():%H%M%S}{ext}"


def inside(name: str) -> Path | None:
    """Resolve a requested name to a real file, or None. The only door to the disk.

    `safe_name` already flattens any path, and this re-checks the resolved parent,
    so a crafted `../../etc/passwd` lands as `.._.._etc_passwd` and then fails to
    exist rather than escaping. Both belts stay on deliberately.
    """
    p = (DEST / safe_name(name)).resolve()
    try:
        if p.parent != DEST.resolve() or not p.is_file():
            return None
    except OSError:
        return None
    return p


def kind_of(p: Path) -> str:
    ext = p.suffix.lower()
    return "image" if ext in IMAGE_EXT else "video" if ext in VIDEO_EXT else "file"


def wl_env() -> dict:
    """Environment a Wayland clipboard tool needs, found live rather than inherited."""
    env = dict(os.environ)
    run = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env["XDG_RUNTIME_DIR"] = run
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(
            s.name for s in Path(run).glob("wayland-*")
            if not s.name.endswith((".lock", ".sock"))
        )
        if socks:
            env["WAYLAND_DISPLAY"] = socks[0]
    return env


def clip_write(text: str) -> bool:
    """Put text on the laptop clipboard. Detached, because wl-copy must outlive us:
    on Wayland the clipboard is owned by a live client, so if wl-copy dies the
    paste buffer dies with it."""
    if not shutil.which("wl-copy"):
        return False
    try:
        subprocess.Popen(
            ["wl-copy", "--", text], env=wl_env(), start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return True
    except Exception:
        return False


def clip_read() -> str:
    if not shutil.which("wl-paste"):
        return ""
    try:
        r = subprocess.run(
            ["wl-paste", "--no-newline"], env=wl_env(),
            capture_output=True, text=True, timeout=4,
        )
        return r.stdout if r.returncode == 0 else ""
    except Exception:
        return ""


# ------------------------------------------------------------------- agents

# The shortlist worth a button on a phone. The names, aliases and repos live in
# fleet-registry.json; `nhq-tell` owns the lookup from a name to whichever tmux
# session that agent is actually sitting in. This file deliberately knows
# neither — a second copy of the slug rule here is how the two drift apart.
AGENTS = [("director", "Director"), ("envy", "NV"), ("builder", "Builder")]

TOKEN_PATH = HOME / ".config/nhq/inbox-token"


def tool(name: str) -> str:
    """Absolute path to an NHQ tool.

    A systemd user unit starts with a near-empty PATH — ~/.local/bin is on it
    only because an interactive shell puts it there. Resolving by bare name
    works when run by hand and fails as a service, which is the worst of both.
    """
    return shutil.which(name) or str(HOME / ".local/bin" / name)


def token() -> str:
    """The key that unlocks sending prompts, created once and kept on disk.

    Files and clipboard stay open on the LAN as they always were. Prompts do
    not: a prompt reaches an agent that can run shell commands on this laptop,
    so anyone who can reach the port would otherwise have arbitrary execution
    through it. The token rides in the URL that `nhq-inbox qr` prints, so the
    phone gets it by scanning once and never sees it again.
    """
    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True)
    if TOKEN_PATH.exists():
        existing = TOKEN_PATH.read_text().strip()
        if existing:
            return existing
    fresh = secrets.token_urlsafe(9)
    TOKEN_PATH.write_text(fresh + "\n")
    TOKEN_PATH.chmod(0o600)
    return fresh


def open_mode() -> bool:
    """Prompting is open on the LAN unless NHQ_INBOX_LOCK=1 says otherwise.

    This started the other way round and that was me overruling a decision that
    was already made. The file's own posture is "no auth, this binds to the home
    LAN, behind the router" — and the clipboard endpoint, which will hand any
    passer-by whatever Yash last copied, has always sat here unauthenticated.
    Against that, a key on the prompt box is not the line it looked like.

    What settled it was the cost: it locked him out twice. A QR scanned by the
    camera app opens in that app's own browser, and localStorage does not cross
    to the one he actually reads in — so the key was saved somewhere he could
    not use it, and the panel stayed grey with no way forward that did not
    involve me telling him the token by hand.

    The lock still exists and still works; it is one line in the unit:
        Environment=NHQ_INBOX_LOCK=1
    Worth turning on the day this port is reachable from anything but his own
    WiFi, because a prompt does run shell commands on this laptop.

    Read from the unit when the variable is not in this process's environment,
    so `nhq-inbox qr` in a shell agrees with the server started by systemd. The
    alternative is a QR with no key printed for a server that demands one —
    silently, and only discovered on the phone.
    """
    env = os.environ.get("NHQ_INBOX_LOCK")
    if env is None and UNIT_PATH.exists():
        try:
            for line in UNIT_PATH.read_text().splitlines():
                if line.startswith("Environment=NHQ_INBOX_LOCK="):
                    env = line.split("=", 2)[2].strip()
                    break
        except OSError:
            pass
    return (env or "") != "1"


def agent_where(key: str) -> str:
    """The live tmux session for an agent, or "" when nobody is home."""
    try:
        r = subprocess.run([tool("nhq-tell"), "--where", key],
                           capture_output=True, text=True, timeout=6)
        return r.stdout.strip() if r.returncode == 0 else ""
    except Exception:
        return ""


def agent_send(key: str, text: str) -> tuple[bool, str]:
    """Type a prompt into an agent's session. Returns (sent, detail)."""
    try:
        r = subprocess.run([tool("nhq-tell"), key, text],
                           capture_output=True, text=True, timeout=20)
    except Exception as exc:
        return False, f"{type(exc).__name__}: {exc}"
    if r.returncode != 0:
        return False, (r.stderr.strip().splitlines() or ["not running"])[0]
    return True, r.stdout.strip()


# ------------------------------------------------------------------ server

