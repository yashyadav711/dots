        </a>
        <button class="x" onclick="del('${encodeURIComponent(f.name).replace(/'/g,"\\'")}')" aria-label="delete">&times;</button>
      </div>`;
    }).join('');
  }catch(e){}
}
$('refresh').onclick=list;
list();
// The agent writes into this folder too, so poll — a file that appears while the
// page is open should just show up.
setInterval(()=>{ if(document.visibilityState==='visible') list(); }, 5000);
</script></body></html>"""


def serve() -> None:
    from fastapi import FastAPI, Request
    from fastapi.responses import HTMLResponse, JSONResponse, FileResponse, Response
    import uvicorn

    DEST.mkdir(parents=True, exist_ok=True)
    app = FastAPI(title="NHQ Inbox", docs_url=None, redoc_url=None)

    @app.get("/", response_class=HTMLResponse)
    async def index() -> str:
        return PAGE

    @app.get("/files")
    async def files() -> JSONResponse:
        items, total = [], 0
        for p in sorted(
            (x for x in DEST.iterdir() if x.is_file()),
            key=lambda x: x.stat().st_mtime, reverse=True,
        ):
            st = p.stat()
            total += st.st_size
            items.append({
                "name": p.name,
                "size": st.st_size,
                "kind": kind_of(p),
                "ext": p.suffix.lstrip(".").lower()[:4],
                "when": datetime.fromtimestamp(st.st_mtime).strftime("%H:%M"),
            })
        return JSONResponse({"files": items, "bytes": total})

    @app.get("/dl/{name}")
    async def download(name: str):
        p = inside(name)
        if not p:
            return JSONResponse({"error": "not found"}, status_code=404)
        return FileResponse(p, filename=p.name)

    @app.get("/thumb/{name}")
    async def thumb(name: str):
        p = inside(name)
        if not p or kind_of(p) != "image":
            return JSONResponse({"error": "not an image"}, status_code=404)
        try:
            from PIL import Image
            import io
            with Image.open(p) as im:
                im.draft("RGB", (256, 256))       # cheap decode for big JPEGs
                im = im.convert("RGB")
                im.thumbnail((128, 128))
                buf = io.BytesIO()
                im.save(buf, "JPEG", quality=72)
            return Response(
                buf.getvalue(), media_type="image/jpeg",
                headers={"Cache-Control": "max-age=60"},
            )
        except Exception:
            return JSONResponse({"error": "unreadable"}, status_code=404)

    @app.post("/text")
    async def text(request: Request) -> JSONResponse:
        body = await request.json()
        t = (body or {}).get("text") or ""
        if not t.strip():
            return JSONResponse({"ok": False, "error": "empty"}, status_code=400)
        ok = clip_write(t)
        print(f"[{datetime.now():%H:%M:%S}] clipboard <- {len(t)} chars "
              f"({'ok' if ok else 'FAILED'})", flush=True)
        return JSONResponse({"ok": ok})

    @app.get("/clip")
    async def clip() -> JSONResponse:
        return JSONResponse({"text": clip_read()[:100_000]})

    @app.post("/rm")
    async def rm(request: Request) -> JSONResponse:
        body = await request.json()
        p = inside((body or {}).get("name") or "")
        if not p:
            return JSONResponse({"error": "not found"}, status_code=404)
        p.unlink()
        print(f"[{datetime.now():%H:%M:%S}] deleted {p.name}", flush=True)
        return JSONResponse({"ok": True})

    # Read the form off the Request directly. A `list[UploadFile]` signature
    # cannot be used here: `from __future__ import annotations` turns it into a
    # string, and this handler lives inside serve(), so Pydantic cannot resolve
    # the forward reference and every upload 500s. Verified 2026-08-12.
    @app.post("/upload")
    async def upload(request: Request) -> JSONResponse:
        form = await request.form()
        files = [v for v in form.getlist("files") if hasattr(v, "read")]
        if not files:
            return JSONResponse({"error": "no files in request"}, status_code=400)
        saved = []
        for f in files:
            target = unique_path(safe_name(f.filename or "file"))
            written = 0
            with target.open("wb") as out:
                while chunk := await f.read(1024 * 1024):
                    written += len(chunk)
                    if written > MAX_BYTES:
                        out.close()
                        target.unlink(missing_ok=True)
                        return JSONResponse({"error": f"{target.name} over 2 GB"}, status_code=413)
                    out.write(chunk)
            saved.append(target.name)
            print(f"[{datetime.now():%H:%M:%S}] saved {target.name} ({written} bytes)", flush=True)
        return JSONResponse({"saved": saved})

    p = int(os.environ.get("NHQ_INBOX_PORT") or port() or port(claim=True) or "3900")
    print(f"nhq-inbox -> http://{lan_ip()}:{p}  (sharing {DEST})", flush=True)
    uvicorn.run(app, host="0.0.0.0", port=p, log_level="warning")


# --------------------------------------------------------------------- cli

UNIT_TEXT = """[Unit]
Description=NHQ Inbox — LAN file + clipboard bridge to ~/Github/nhq-local-downloads
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=NHQ_INBOX_PORT={port}
ExecStart={exe} serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
"""


def sysctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def cmd_start() -> int:
    DEST.mkdir(parents=True, exist_ok=True)
    p = port() or port(claim=True)
    UNIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    UNIT_PATH.write_text(UNIT_TEXT.format(port=p, exe=os.path.abspath(__file__)))
    sysctl("daemon-reload")
    sysctl("enable", "--now", UNIT)
    sysctl("restart", UNIT)
    time.sleep(1.5)
    return cmd_status()


def cmd_stop() -> int:
    sysctl("disable", "--now", UNIT)
    subprocess.run(["nhq-port", "release", CLAIM], capture_output=True)
    print("nhq-inbox stopped, port released")
    return 0


def cmd_url() -> int:
    p = port()
    if not p:
        print("not running — `nhq-inbox start` first", file=sys.stderr)
        return 1
    url = f"http://{lan_ip()}:{p}"
    print(url)
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=url, text=True, env=wl_env())
    return 0


def qr_block(url: str) -> None:
    """Draw the URL as a scannable code, if the terminal can carry one.

    Yash asked for this on `status` too, not just `qr`: the whole point of the
    box is that the phone reaches it, and reading an IP off one screen to type
    it into another is the one step that made him not bother. Silent when
    qrencode is missing or output is piped — a QR in a log file helps nobody.
    """
    if not shutil.which("qrencode") or not sys.stdout.isatty():
        return
    print()
    subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "1", url])


def cmd_qr() -> int:
    """A QR beats reading an IP off a screen and typing it on a phone."""
    p = port()
    if not p:
        print("not running — `nhq-inbox start` first", file=sys.stderr)
        return 1
    url = f"http://{lan_ip()}:{p}"
    if not shutil.which("qrencode"):
        print(url)
        print("(install qrencode for a scannable code)", file=sys.stderr)
        return 0
    subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "1", url])
    print(url)
    return 0


def cmd_clear() -> int:
    n = bytes_ = 0
    for f in DEST.iterdir() if DEST.exists() else []:
        if f.is_file():
            bytes_ += f.stat().st_size
            f.unlink()
            n += 1
    print(f"cleared {n} file(s), {bytes_/1048576:.1f} MB")
    return 0


def cmd_open() -> int:
    DEST.mkdir(parents=True, exist_ok=True)
    subprocess.Popen(["xdg-open", str(DEST)], env=wl_env(),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(DEST)
    return 0


def cmd_status() -> int:
    active = sysctl("is-active", UNIT).stdout.strip()
    p = port()
    files = [f for f in DEST.iterdir() if f.is_file()] if DEST.exists() else []
    total = sum(f.stat().st_size for f in files)
    url = f"http://{lan_ip()}:{p}" if p else ""
    print(f"service : {active}")
    print(f"url     : {url}" if url else "url     : (no port claimed)")
    print(f"folder  : {DEST}")
    print(f"files   : {len(files)} ({total/1048576:.1f} MB)")
    if url and active == "active":
        qr_block(url)
    return 0 if active == "active" else 1


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    table = {
        "serve": serve, "start": cmd_start, "stop": cmd_stop, "status": cmd_status,
        "url": cmd_url, "qr": cmd_qr, "clear": cmd_clear, "open": cmd_open,
    }
    fn = table.get(cmd)
    if not fn:
        print(__doc__)
        return 1
    return fn() or 0


if __name__ == "__main__":
    sys.exit(main())
