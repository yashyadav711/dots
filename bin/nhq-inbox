<script>
const $ = i => document.getElementById(i);
const drop=$('drop'), pick=$('pick'), send=$('send'), cam=$('cam'), camin=$('camin'),
      bar=$('bar'), fill=bar.firstElementChild, log=$('log'), recent=$('recent'),
      txt=$('txt'), tsend=$('tsend'), tpull=$('tpull'), tlog=$('tlog'), count=$('count');
let queue=[];

const kb=n=>n<1024?n+' B':n<1048576?(n/1024).toFixed(0)+' KB':n<1073741824?(n/1048576).toFixed(1)+' MB':(n/1073741824).toFixed(2)+' GB';
