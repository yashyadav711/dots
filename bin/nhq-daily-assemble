#!/usr/bin/env python3
"""nhq-daily-assemble — normalized items -> premium 3-part magazine markdown."""
import sys, os, json, yaml, re
from collections import OrderedDict
CFG = os.path.expanduser("~/.claude/skills/daily-news/config.yaml")
PARTS = [("world","🌍 THE WORLD"),("workshop","🛠️ THE WORKSHOP"),("lounge","🎧 THE LOUNGE")]

def _slug(h): return re.sub(r"[^a-z0-9]+","-", h.strip().lower()).strip("-")

def assemble(items, date, cfg):
    order = [s["section"] for s in cfg["sources"]]
    by_sec = OrderedDict((s, []) for s in order)
    for it in items: by_sec.setdefault(it["section"], []).append(it)
    part_of = {s["section"]: s["part"] for s in cfg["sources"]}
    flat = [i for s in by_sec.values() for i in s]
    B = []  # each entry is one markdown BLOCK; joined by blank lines so nothing collapses
    B.append(f"---\ntitle: '📰 Daily — {date}'\ntags: [daily, news]\ndate: {date}\nread: false\n---")
    B.append("- [ ] Read")
    B.append(f"![hero](_covers/{date}-cover.png)")
    B.append(f"*Your daily world + builder briefing — {date}*")
    # TL;DR — one callout block (contiguous '>' lines, no blank lines inside)
    tldr = ["> [!tip] TL;DR — the 5 things that matter today"]
    for i in flat[:5]: tldr.append(f"> - **{i['headline']}** — [source]({i['url']})")
    B.append("\n".join(tldr))
    # Index — one block; blank line before each part group keeps it clean
    idx = ["## 📑 In this edition"]
    for part_key, part_label in PARTS:
        secs = [s for s in by_sec if part_of.get(s)==part_key and by_sec[s]]
        if not secs: continue
        idx.append(f"\n**{part_label}**")
        for s in secs: idx.append(f"- [{s}](#{_slug(s)}) · {len(by_sec[s])}")
    B.append("\n".join(idx))
    B.append("---")
    # Parts — every element is its OWN block, so blank lines separate them
    for part_key, part_label in PARTS:
        secs = [s for s in by_sec if part_of.get(s)==part_key and by_sec[s]]
        if not secs: continue
        B.append(f"## {part_label}")
        for s in secs:
            B.append(f"### {s}")
            for it in by_sec[s]:
                B.append(f"**{it['headline']}**" + (f" · ⭐ {it['rating']}" if it.get("rating") else ""))
                if it.get("summary"): B.append(it["summary"])
                if it.get("image"): B.append(f"![]({it['image']})")
                B.append(f"↗ [source]({it['url']})")
                if part_key == "lounge": B.append("- [ ] Already know this")
    B.append("## 📅 On This Day")
    B.append("## 💡 Idea of the Day")
    B.append(f"*Sources: {len(flat)} · generated {date}*")
    return "\n\n".join(B) + "\n"

def main():
    items = json.load(open(sys.argv[1])); date = sys.argv[2]; out = sys.argv[3]
    cfg = yaml.safe_load(open(CFG))
    open(out,"w").write(assemble(items, date, cfg)); print(out)

if __name__ == "__main__":
    main()
