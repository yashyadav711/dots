#!/usr/bin/env bash
# nhq-p3-guard — Protocol-3 commit gate (P4 safety).
#
# DENIES a git commit that stages any auth/payments/PII/audit/security path
# (globs in p3-paths.json) UNLESS an approval token is present.
#
# D4 (locked) + ok-Yash signature (Yash 2026-07-20, governance-ok-yash-signature):
# approval hardness depends on WHO is committing:
#   • Director-direct / human  → may approve ONLY with a live `ok - Yash` signature
#                                token (nhq-approve consume; single-use, TTL-bounded).
#                                The old bare inline VFRAME_P3_OK=1 self-approve is GONE
#                                on prod P3 gates — Director must hold Yash's signature.
#   • fleet / relay agent      → HARD-blocked. No self-approve, token ignored.
#
# Caller identity:
#   privileged (self-approve allowed) ⇔ (NHQ_AGENT unset OR canon==director)
#                                       AND not running inside a fleet-* session.
#   Any fleet-* tmux session, or any non-director NHQ_AGENT, is a fleet agent.
#
# THREE invocation modes (auto-detected):
#   1. PreToolUse hook   — hook JSON on stdin; intercepts Bash `git commit …`.
#   2. git pre-commit    — `nhq-p3-guard pre-commit` (exit 1 blocks the commit).
#   3. test/manual       — `nhq-p3-guard check <repo>` (prints matched + verdict).
#
# Wiring (Director documents/owns the harness side):
#   • PreToolUse: settings.json → hooks.PreToolUse matcher "Bash" → this script.
#   • pre-commit: ln -sfn ~/.local/bin/nhq-p3-guard <repo>/.git/hooks/pre-commit
#     (then the wrapper runs it as `pre-commit`).
#
# Overrides (also used by the selftest): NHQ_P3_PATHS, NHQ_AGENT, NHQ_SESSION,
# VFRAME_P3_OK, NHQ_AUDIT_BIN.
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
BIN="$(cd "$(dirname "$SELF")" && pwd)"
# Registry accessors (nhq_agent_canon) — optional; degrade to lowercase compare.
[[ -f "$BIN/nhq-lib.sh" ]] && source "$BIN/nhq-lib.sh" 2>/dev/null || true

# Policy file resolution: explicit override → dots/bin sibling (canonical, the
# reproducible home, like fleet-registry.json) → the kernel path the brief names.
p3_paths_file() {
  if [[ -n "${NHQ_P3_PATHS:-}" ]]; then printf '%s' "$NHQ_P3_PATHS"; return; fi
  if [[ -f "$BIN/p3-paths.json" ]]; then printf '%s' "$BIN/p3-paths.json"; return; fi
  printf '%s' "$HOME/Github/nhq-agentic-os/ai/p3-paths.json"
}

# Load globs into P3_GLOBS (array) + P3_EXCLUDES (v2: paths that are NEVER P3 —
# docs/prose/archives; evaluated before the category globs). Returns 1 if the
# paths file is missing/unparseable.
P3_GLOBS=(); P3_EXCLUDES=()
p3_load_globs() {
  local pf; pf="$(p3_paths_file)"
  [[ -f "$pf" ]] || return 1
  mapfile -t P3_GLOBS < <(jq -r '.categories[][]?' "$pf" 2>/dev/null)
  mapfile -t P3_EXCLUDES < <(jq -r '.exclusions[]?' "$pf" 2>/dev/null)
  [[ ${#P3_GLOBS[@]} -gt 0 ]]
}

# p3_match_file <repo-relative-path> — 0 if it matches a protected glob.
# In [[ ]] a `*` already crosses '/', so `**/x` matches any depth; we also test the
# `**/`-stripped core so a top-level file (no slash) still matches.
p3_match_file() {
  local f="$1" g core
  shopt -s nocasematch
  # v2 exclusions first: docs/prose/archives are never P3, regardless of name.
  # EXCEPTION: never let an exclusion neutralize the policy/guard self-protection
  # paths (security category) — those stay protected even if e.g. a *.md glob
  # were ever added that could shadow them.
  local excluded=1
  for g in "${P3_EXCLUDES[@]}"; do
    core="${g#\*\*/}"
    # shellcheck disable=SC2053
    if [[ "$f" == $g || "$f" == $core || "$f" == */$core ]]; then excluded=0; break; fi
  done
  if [[ $excluded -eq 0 ]]; then
    for g in "**/bin/p3-paths.json" "**/bin/nhq-p3-guard" "**/.nhq/pre-tool-guard"; do
      core="${g#\*\*/}"
      # shellcheck disable=SC2053
      if [[ "$f" == $g || "$f" == $core || "$f" == */$core ]]; then excluded=1; break; fi
    done
  fi
  if [[ $excluded -eq 0 ]]; then shopt -u nocasematch; return 1; fi
  for g in "${P3_GLOBS[@]}"; do
    core="${g#\*\*/}"
    # shellcheck disable=SC2053
    if [[ "$f" == $g || "$f" == $core || "$f" == */$core ]]; then
      shopt -u nocasematch; return 0
    fi
  done
  shopt -u nocasematch
  return 1
}

# p3_caller_privileged — 0 if the caller is Director/human (may self-approve), 1 if fleet.
# IDENTITY IS DERIVED FROM THE HARNESS ENV ONLY (NHQ_AGENT + fleet-tmux membership) — the
# variables this reads belong to the already-running hook process, which a guarded agent
# CANNOT change via a command-inline `NHQ_AGENT=… cmd` (that env reaches only the command's
# own subprocess, never this hook). Same anti-spoof principle as H2. NEVER derive identity
# from anything parsed out of the command string.
p3_caller_privileged() {
  local agent="${NHQ_AGENT:-}" sess="${NHQ_SESSION:-}"
  if [[ -z "$sess" && -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    sess="$(tmux display-message -p '#S' 2>/dev/null || true)"   # real tmux membership
  fi
  [[ "$sess" == fleet-* ]] && return 1          # any fleet-* session ⇒ fleet agent
  local canon=""
  if declare -F nhq_agent_canon >/dev/null 2>&1; then
    canon="$(nhq_agent_canon "$agent" 2>/dev/null || true)"
  else
    canon="$(printf '%s' "$agent" | tr '[:upper:]' '[:lower:]')"
  fi
  [[ -z "$agent" || "$canon" == "director" ]]
}

# Git invocation context for the repo under evaluation (set by each caller). Using the
# real GIT_DIR/-C the commit targets defeats H3 misdirection.
P3_GIT_ARGS=()
# The set of paths the commit will write. The cached index is the precise set a normal
# `git commit` writes. P2-02: `git commit -a` / `git commit <pathspec>` stage at commit time,
# so at PreToolUse the cached set is blind to them — when NHQ_P3_EFFECTIVE=1 (set by the omp
# hook for fleet lanes) we ALSO consider tracked working-tree changes vs HEAD, the superset of
# what `-a`/pathspec would stage. (The installed pre-commit hook remains the precise post-
# staging backstop; this widens the PreToolUse evaluation as defense-in-depth.) De-duplicated.
p3_staged_files() {
  { git "${P3_GIT_ARGS[@]}" diff --cached --name-only 2>/dev/null
    [[ "${NHQ_P3_EFFECTIVE:-}" == "1" ]] && git "${P3_GIT_ARGS[@]}" diff HEAD --name-only 2>/dev/null
  } | awk 'NF && !seen[$0]++'
}

# p3_scope — enforcement scope for the repo under P3_GIT_ARGS (Yash 2026-07-13):
# P3 commits are gated on ONLY three targets; everything else is Director-autonomous.
#   whole → block ANY commit  (firststone — Julian's repo; Director must not commit)
#   p3    → block P3-path commits, PROD branch (main/master) ONLY  (heydaddy, mirror)
#   none  → no gate            (nhq-agentic-os, envy, builder, dots, vault, dev branches…)
p3_scope() {
  local origin base branch
  origin="$(git "${P3_GIT_ARGS[@]}" remote get-url origin 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  base="$(basename "$(git "${P3_GIT_ARGS[@]}" rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  branch="$(git "${P3_GIT_ARGS[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [[ "$origin" == *firststone* || "$origin" == *firststone* || "$base" == firststone || "$base" == firststone ]]; then
    echo whole; return
  fi
  if [[ "$origin" == *yashyadav711/heydaddy* || "$base" == heydaddy || "$origin" == *yashyadav711/mirror* || "$base" == mirror ]]; then
    # FAIL CLOSED on ambiguous HEAD: detached HEAD / unborn branch reports "HEAD"
    # (or empty) — an agent could detach at main and commit ungated. Treat any
    # non-feature-branch state of a scoped repo as prod.
    if [[ "$branch" == main || "$branch" == master || "$branch" == HEAD || -z "$branch" ]]; then echo p3; else echo none; fi
    return
  fi
  echo none
}

# p3_evaluate <mode>  (mode = pretooluse | precommit)
# sets P3_MATCHED + P3_VERDICT; returns 0 allow / 1 deny. Reads P3_GIT_ARGS.
P3_MATCHED=""; P3_VERDICT=""

# Locate the nhq-approve binary (dots/bin sibling → PATH). Empty if unavailable.
p3_approve_bin() {
  if [[ -n "${NHQ_APPROVE_BIN:-}" ]]; then printf '%s' "$NHQ_APPROVE_BIN"; return; fi
  if [[ -x "$BIN/nhq-approve" ]]; then printf '%s' "$BIN/nhq-approve"; return; fi
  command -v nhq-approve 2>/dev/null || true
}

# Resolve the repo basename + branch the current commit targets, from the SAME
# P3_GIT_ARGS context p3_scope already used (never re-parse the command string for
# identity). Sets P3_REPO_BASE + P3_TARGET_BRANCH. The repo identity is CANONICALIZED
# to the scoped prod name (heydaddy/mirror) via the SAME origin/base match p3_scope
# uses — so a token granted `--repo heydaddy` also covers a linked worktree dir
# (heydaddy-wt-*) whose raw basename differs. Detached/unborn HEAD on a scoped prod
# repo is treated as prod "main" (p3_scope already forces that state to scope p3).
P3_REPO_BASE=""; P3_TARGET_BRANCH=""
p3_resolve_identity() {
  local origin base branch
  origin="$(git "${P3_GIT_ARGS[@]}" remote get-url origin 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  base="$(basename "$(git "${P3_GIT_ARGS[@]}" rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  if [[ "$origin" == *yashyadav711/heydaddy* || "$base" == heydaddy ]]; then P3_REPO_BASE=heydaddy
  elif [[ "$origin" == *yashyadav711/mirror* || "$base" == mirror ]]; then P3_REPO_BASE=mirror
  else P3_REPO_BASE="$base"; fi
  branch="$(git "${P3_GIT_ARGS[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [[ "$branch" == master ]]; then branch=master
  elif [[ "$branch" == main || "$branch" == HEAD || -z "$branch" ]]; then branch=main
  fi
  P3_TARGET_BRANCH="$branch"
}

p3_evaluate() {
  local mode="${1:-pretooluse}" f
  # H3: the git context must resolve to a real repo. If -C / GIT_DIR points nowhere
  # (misdirection), we can't read the true staged set → fail CLOSED.
  if ! git "${P3_GIT_ARGS[@]}" rev-parse --git-dir >/dev/null 2>&1; then
    P3_VERDICT="DENY(unresolvable-repo)"; P3_MATCHED=""; return 1
  fi
  # TARGET SCOPE (Yash 2026-07-13): gate only firststone(whole) + heydaddy/mirror-prod(p3);
  # everything else is Director-autonomous — allow immediately, no path check.
  local scope; scope="$(p3_scope)"
  if [[ "$scope" == none ]]; then
    P3_VERDICT="ALLOW(out-of-scope)"; P3_MATCHED=""; return 0
  fi
  if [[ "$scope" == whole ]]; then
    local staged; staged="$(p3_staged_files)"
    if [[ -z "$staged" ]]; then P3_VERDICT="ALLOW(no-changes)"; P3_MATCHED=""; return 0; fi
    P3_MATCHED="$(printf '%s' "$staged" | head -20)"
    P3_VERDICT="DENY(firststone-whole-repo)"; p3_audit deny; return 1
  fi
  # scope == p3 (heydaddy/mirror prod) → path-glob gate below.
  if ! p3_load_globs; then
    # A security gate must not commit blind. Fail CLOSED if the policy file is missing.
    P3_VERDICT="DENY(no-policy-file)"; P3_MATCHED=""; return 1
  fi
  local matched=""
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    p3_match_file "$f" && matched+="$f"$'\n'
  done < <(p3_staged_files)
  P3_MATCHED="${matched%$'\n'}"
  if [[ -z "$P3_MATCHED" ]]; then
    P3_VERDICT="ALLOW(no-p3-paths)"; return 0
  fi
  # H2: pre-commit runs with whatever env the `git commit` inherited — an agent can set
  # NHQ_AGENT/NHQ_SESSION/VFRAME_P3_OK inline. So pre-commit NEVER trusts env identity:
  # it ALWAYS treats the caller as an agent with NO self-approve. Self-approval exists
  # ONLY in PreToolUse mode (harness env, not command-inline).
  if [[ "$mode" == "precommit" ]]; then
    P3_VERDICT="DENY(precommit-no-selfapprove)"; p3_audit deny; return 1
  fi
  # PreToolUse Director approval (governance 2026-07-20): a harness-proven Director
  # approves a PROD P3 commit ONLY via a valid "ok - Yash" signature token (nhq-approve),
  # NOT a bare inline VFRAME_P3_OK. Director writes the token after Yash types "ok - Yash";
  # the guard CONSUMES it (single-use) + audits. No token → blocked. A fleet agent that
  # fakes identity/token inline is still fleet by harness identity → hard-blocked below.
  if p3_caller_privileged; then
    p3_resolve_identity
    local _ap_bin; _ap_bin="$(p3_approve_bin)"
    if [[ -n "$_ap_bin" ]] && "$_ap_bin" consume --repo "$P3_REPO_BASE" --target "$P3_TARGET_BRANCH" >/dev/null 2>&1; then
      P3_VERDICT="ALLOW(yash-signature-token)"; p3_audit allow; return 0
    fi
    P3_VERDICT="DENY(no-yash-signature)"; p3_audit deny; return 1
  fi
  P3_VERDICT="DENY(fleet-hard-block)"; p3_audit deny; return 1
}

# Best-effort audit line (never fatal).
p3_audit() {
  local decision="$1" ab="${NHQ_AUDIT_BIN:-$BIN/nhq-audit}"
  # P2-05: when a fleet daemon owns a HMAC-KEYED audit chain (NHQ_OMP_SOCK set) but this process
  # has NO key (it was stripped from the worker/host env), a direct unkeyed append would corrupt
  # the keyed chain — the driver's keyed sink owns it. Skip; the BLOCK still stands & is surfaced.
  if [[ -n "${NHQ_OMP_SOCK:-}" && -z "${NHQ_AUDIT_HMAC_KEY:-}" && -z "${NHQ_AUDIT_HMAC_KEYFILE:-}" ]]; then return 0; fi
  [[ -x "$ab" ]] || ab="$(command -v nhq-audit 2>/dev/null || true)"
  [[ -n "$ab" && -x "$ab" ]] || return 0
  "$ab" append --tool p3-guard --bucket "p3:${decision}" \
    --file "$(printf '%s' "$P3_MATCHED" | head -1)" \
    --cmd "git commit verdict=$P3_VERDICT" 2>/dev/null || true
}

# Emit a PreToolUse deny decision (stdout JSON) + notify.
p3_emit_deny() {
  local reason="$1"
  "${NHQ_NOTIFY:-$HOME/.local/bin/nhq-notify}" blocked "🛑 P3 commit BLOCKED" "$reason" 2>/dev/null || true
  cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "deny",
    "permissionDecisionReason": "BLOCKED (Protocol-3): $reason"
  }
}
EOF
}

p3_deny_reason() {
  local m; m="$(printf '%s' "$P3_MATCHED" | tr '\n' ' ')"
  case "$P3_VERDICT" in
    DENY\(fleet-hard-block\)) echo "this commit stages protected path(s) [$m]; fleet/relay agents are hard-blocked from auth/payments/PII/audit/security commits — escalate to Yash via nhq-blocked." ;;
    DENY\(no-yash-signature\)) echo "this commit stages protected path(s) [$m] on a PROD target — it needs Yash's 'ok - Yash' signature. After Yash types 'ok - Yash' in chat, Director runs: nhq-approve grant --repo <repo> --target <branch> , then retries the commit (token is single-use + logged to audit.jsonl)." ;;
    DENY\(director-no-token\)) echo "this commit stages protected path(s) [$m]; (legacy) obtain Yash's 'ok - Yash' signature then 'nhq-approve grant …' — bare inline self-approve is retired." ;;
    DENY\(precommit-no-selfapprove\)) echo "this commit stages protected path(s) [$m]; the pre-commit gate never trusts inline env — no self-approve here. A legitimate Director p3 commit is approved at the PreToolUse layer (harness env); to bypass the hook deliberately use 'git commit --no-verify' as a conscious human override." ;;
    DENY\(unresolvable-repo\)) echo "the git target (-C / GIT_DIR) does not resolve to a real repository — refusing to evaluate a misdirected commit." ;;
    DENY\(firststone-whole-repo\)) echo "firststone is Julian's repo — Director/NHQ agents do not commit to it (whole-repo Protocol-3 block). Hand any firststone change to Julian." ;;
    DENY\(no-policy-file\)) echo "p3-paths.json policy file not found at $(p3_paths_file) — refusing to commit blind. Restore the policy file." ;;
    *) echo "protected-path commit denied." ;;
  esac
}

# Parse the git context (GIT_DIR / -C) out of a PreToolUse Bash command into P3_GIT_ARGS.
# Prefer GIT_DIR (where the index lives) over -C; fall back to the hook cwd.
p3_set_git_ctx_from_cmd() {
  local cmd="$1" cwd="$2" gd tgt
  gd="$(printf '%s' "$cmd" | grep -oE 'GIT_DIR=[^[:space:]]+' | head -1 | cut -d= -f2-)"
  tgt="$(printf '%s' "$cmd" | grep -oE 'git[[:space:]]+(-[^[:space:]]+[[:space:]]+)*-C[[:space:]]+[^[:space:]]+' | grep -oE -- '-C[[:space:]]+[^[:space:]]+' | head -1 | sed -E 's/^-C[[:space:]]+//')"
  if [[ -n "$gd" ]]; then P3_GIT_ARGS=(--git-dir="$gd")
  elif [[ -n "$tgt" ]]; then P3_GIT_ARGS=(-C "$tgt")
  else P3_GIT_ARGS=(-C "$cwd"); fi
}

# ---- Mode dispatch ----
case "${1:-}" in
  check)
    # nhq-p3-guard check <repo> [pretooluse|precommit]
    # In `check`, env VFRAME_P3_OK stands in for the inline token the dispatch would parse.
    repo="${2:-$PWD}"; mode="${3:-pretooluse}"
    P3_GIT_ARGS=(-C "$repo"); P3_TOKEN="${VFRAME_P3_OK:-}"
    if p3_evaluate "$mode"; then
      echo "P3: $P3_VERDICT"; [[ -n "$P3_MATCHED" ]] && echo "matched:"$'\n'"$P3_MATCHED"
      exit 0
    else
      echo "P3: $P3_VERDICT"; [[ -n "$P3_MATCHED" ]] && echo "matched:"$'\n'"$P3_MATCHED"
      exit 1
    fi
    ;;
  match-path)
    # nhq-p3-guard match-path <path> [<path> ...]
    # Single-path policy probe for the omp edit/write pre-hook: reuses the EXACT
    # p3_match_file matcher (no policy duplication). Prints + exit 0 on the FIRST
    # protected match; exit 1 if none match; exit 2 if the policy file is missing
    # (fail-closed — the caller treats an unparseable policy as "protected").
    shift
    if ! p3_load_globs; then echo "DENY(no-policy-file)" >&2; exit 2; fi
    for f in "$@"; do
      [[ -z "$f" ]] && continue
      if p3_match_file "$f"; then echo "$f"; exit 0; fi
    done
    exit 1
    ;;
  pre-commit)
    # The git pre-commit hook — fires after `git add`, before the commit is written.
    # ALWAYS precommit mode → never trusts inline env (H2). Uses the ambient repo.
    P3_GIT_ARGS=()
    if p3_evaluate precommit; then exit 0; fi
    echo "🛑 P3 commit blocked: $(p3_deny_reason)" >&2
    exit 1
    ;;
  "")
    # No arg: PreToolUse hook if hook JSON is on stdin, else pre-commit on cwd.
    if [[ -t 0 ]]; then
      P3_GIT_ARGS=(-C "$PWD")
      if p3_evaluate precommit; then exit 0; fi
      echo "🛑 P3 commit blocked: $(p3_deny_reason)" >&2; exit 1
    fi
    INPUT="$(cat)"
    TOOL="$(printf '%s' "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null)"
    [[ "$TOOL" == "Bash" ]] || exit 0
    CMD="$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)"
    # Commit detection (H3 + N2 + NEW-C): allow inline env assignments (incl GIT_DIR=…) AND
    # an env-wrapper before `git`, in ANY form — bare `env` or a path ending in `/env`
    # (`/usr/bin/env git commit`). The pre-commit hook is the real gate; this is detection.
    echo "$CMD" | grep -qE '(^|[;&|]|&&)[[:space:]]*((([^[:space:]]*/)?env)[[:space:]]+([^[:space:]]+[[:space:]]+)*)?([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*git[[:space:]]+([^|;&]*[[:space:]])?commit([[:space:]]|$)' || exit 0
    CWD="$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)"; CWD="${CWD:-$PWD}"
    p3_set_git_ctx_from_cmd "$CMD" "$CWD"
    # The self-approval TOKEN comes from the COMMAND's inline env-prefix (Director can only
    # set it inline, not in this hook's env). IDENTITY still comes from the harness env, so a
    # fleet agent putting VFRAME_P3_OK=1 (or NHQ_AGENT=director) inline is still blocked.
    if echo "$CMD" | grep -qE '(^|[[:space:]])VFRAME_P3_OK=1([[:space:]]|$)'; then P3_TOKEN=1; else P3_TOKEN=""; fi
    if p3_evaluate pretooluse; then exit 0; fi
    p3_emit_deny "$(p3_deny_reason)"
    exit 0   # decision carried in the JSON, not the exit code
    ;;
  *)
    echo "usage: nhq-p3-guard {check <repo> [pretooluse|precommit]|match-path <path>...|pre-commit}  (or pipe PreToolUse hook JSON)" >&2
    exit 2
    ;;
esac
