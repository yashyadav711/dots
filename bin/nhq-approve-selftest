#!/usr/bin/env bash
# nhq-approve-selftest — proves the `ok - Yash` signature-token gate (governance
# 2026-07-20, governance-ok-yash-signature). Covers all 8 acceptance cases from
# SPEC-guard-ok-yash-signature.md, hermetically, against throwaway repos + a
# throwaway approval store. Fires NO real desktop toast, touches NO real store.
#
# Usage: nhq-approve-selftest       (exits non-zero if any assertion fails)
set -uo pipefail

BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")" && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

APPROVE="$BIN/nhq-approve"
P3="$BIN/nhq-p3-guard"

# Hermetic env: throwaway store, silent audit/notify, sandbox p3 policy.
export NHQ_APPROVAL_STORE="$TMP/approval.json"
export NHQ_APPROVE_BIN="$APPROVE"
export NHQ_AUDIT_BIN=/bin/true
export NHQ_NOTIFY="$TMP/notify-noop"
printf '#!/usr/bin/env bash\nexit 0\n' > "$NHQ_NOTIFY"; chmod +x "$NHQ_NOTIFY"
export NHQ_NOTIFY_SUPPRESS=1 NHQ_TEST=1

P3PF="$TMP/p3-paths.json"
cat > "$P3PF" <<'JSON'
{"version":1,"categories":{"auth":["**/.env","**/*.env"],"audit":["**/audit.jsonl"]},"exclusions":[]}
JSON
export NHQ_P3_PATHS="$P3PF"

pass=0; fail=0
ok() { echo "  PASS: $1"; pass=$((pass + 1)); }
no() { echo "  FAIL: $1"; fail=$((fail + 1)); }
eq() { if [[ "$2" == "$3" ]]; then ok "$1 ($2)"; else no "$1 — got '$2' want '$3'"; fi; }

# Build a git repo at $1 with origin $2, on branch $3, staging file $4 with content $5.
mkrepo() {
  local dir="$1" origin="$2" branch="$3" file="${4:-}" content="${5:-}"
  git init -q -b "$branch" "$dir"
  git -C "$dir" remote add origin "$origin"
  git -C "$dir" -c user.email=a@b.c -c user.name=x commit --allow-empty -qm base
  if [[ -n "$file" ]]; then
    mkdir -p "$dir/$(dirname "$file")" 2>/dev/null || true
    printf '%s\n' "$content" > "$dir/$file"
    git -C "$dir" add "$file"
  fi
}

# p3 commit verdict for a repo under a caller identity (env assignments in $@).
p3verdict() { # $1=repo $2..=env
  local repo="$1"; shift
  env "$@" "$P3" check "$repo" 2>/dev/null | sed -n '1p' | sed 's/^P3: //'
}
p3allow() { # $1=repo $2..=env → allow|deny
  local repo="$1"; shift
  if env "$@" "$P3" check "$repo" >/dev/null 2>&1; then echo allow; else echo deny; fi
}

echo "── A: nhq-approve token store primitives ──────────────────────────────"
"$APPROVE" clear >/dev/null
eq "verify empty store → miss"        "$(("$APPROVE" verify --repo heydaddy --target main >/dev/null 2>&1) && echo hit || echo miss)" "miss"
N="$("$APPROVE" grant --repo heydaddy --target main --ttl 30)"
eq "grant prints a nonce"             "$([[ -n "$N" ]] && echo yes || echo no)" "yes"
eq "verify after grant → hit"         "$(("$APPROVE" verify --repo heydaddy --target main >/dev/null 2>&1) && echo hit || echo miss)" "hit"
eq "verify wrong target → miss"       "$(("$APPROVE" verify --repo heydaddy --target dev  >/dev/null 2>&1) && echo hit || echo miss)" "miss"
eq "verify wrong repo → miss"         "$(("$APPROVE" verify --repo mirror   --target main >/dev/null 2>&1) && echo hit || echo miss)" "miss"
eq "consume once → ok"                "$(("$APPROVE" consume --repo heydaddy --target main >/dev/null 2>&1) && echo ok || echo fail)" "ok"
eq "consume again → single-use fail"  "$(("$APPROVE" consume --repo heydaddy --target main >/dev/null 2>&1) && echo ok || echo fail)" "fail"
# corrupt store degrades to no-grants (not a crash)
printf 'not json{{\n' > "$NHQ_APPROVAL_STORE"
eq "corrupt store verify → miss"      "$(("$APPROVE" verify --repo heydaddy --target main >/dev/null 2>&1) && echo hit || echo miss)" "miss"
"$APPROVE" clear >/dev/null
eq "store chmod 600"                  "$(stat -c '%a' "$NHQ_APPROVAL_STORE" 2>/dev/null)" "600"

echo "── B: nhq-p3-guard prod P3 commit gate (the 6 commit cases) ────────────"
HD="$TMP/heydaddy"
mkrepo "$HD" "https://github.com/yashyadav711/heydaddy.git" main ".env" "SECRET=1"
"$APPROVE" clear >/dev/null

# 1. Director prod P3 commit WITHOUT a token → DENY(no-yash-signature).
eq "1. Director prod P3, no token → verdict" "$(p3verdict "$HD" NHQ_AGENT=Director NHQ_SESSION=main)" "DENY(no-yash-signature)"

# 2. grant then Director prod P3 commit → ALLOW(yash-signature-token) + grant consumed.
"$APPROVE" grant --repo heydaddy --target main >/dev/null
eq "2. Director prod P3, with token → verdict" "$(p3verdict "$HD" NHQ_AGENT=Director NHQ_SESSION=main)" "ALLOW(yash-signature-token)"
eq "2b. grant now consumed (verify miss)"      "$(("$APPROVE" verify --repo heydaddy --target main >/dev/null 2>&1) && echo hit || echo miss)" "miss"

# 3. second commit reusing same grant → DENY (single-use).
eq "3. Director prod P3, reuse token → DENY"   "$(p3allow "$HD" NHQ_AGENT=Director NHQ_SESSION=main)" "deny"

# 4. expired grant (ttl in the past) → DENY.
"$APPROVE" clear >/dev/null
"$APPROVE" grant --repo heydaddy --target main --ttl 0 >/dev/null
eq "4. Director prod P3, expired grant → DENY"  "$(p3allow "$HD" NHQ_AGENT=Director NHQ_SESSION=main)" "deny"

# 5. Fleet-tier prod P3 commit (even with a token) → still DENY(fleet-hard-block).
"$APPROVE" clear >/dev/null
"$APPROVE" grant --repo heydaddy --target main >/dev/null
eq "5. Fleet prod P3, with token → verdict"    "$(p3verdict "$HD" NHQ_AGENT=Envy NHQ_SESSION=fleet-envy-x)" "DENY(fleet-hard-block)"
eq "5b. Fleet did NOT consume the grant"       "$(("$APPROVE" verify --repo heydaddy --target main >/dev/null 2>&1) && echo hit || echo miss)" "hit"
"$APPROVE" clear >/dev/null

# 6. Dev/feature commit (scope none) → ALLOW(out-of-scope), no token needed.
FEAT="$TMP/heydaddy-feat"
mkrepo "$FEAT" "https://github.com/yashyadav711/heydaddy.git" main ".env" "SECRET=1"
git -C "$FEAT" checkout -q -b feat/x
eq "6. Director feat-branch P3 commit → verdict" "$(p3verdict "$FEAT" NHQ_AGENT=Director NHQ_SESSION=main)" "ALLOW(out-of-scope)"
# non-scoped repo, even on main, is out of scope
DOTS="$TMP/dots"
mkrepo "$DOTS" "https://github.com/1jehuang/dots.git" main ".env" "SECRET=1"
eq "6b. Director non-scoped-repo main P3 → verdict" "$(p3verdict "$DOTS" NHQ_AGENT=Director NHQ_SESSION=main)" "ALLOW(out-of-scope)"

# ── C: RETIRED 2026-08-12 ────────────────────────────────────────────────────
# Section C covered the jcode pre_tool push/merge gate (cases 7 and 8). jcode was
# unused for two weeks (~/.jcode last touched 2026-07-29), so the whole family was
# retired: the hooks were unwired from ~/.jcode/config.toml and the scripts moved
# to ~/.local/share/nhq-archive/. With nhq-jcode-pretool gone these eight cases
# returned 127 and the suite read 22 passed / 8 failed — a failure of the harness,
# not of the gate.
#
# What was covered here is NOT lost: the same Protocol-3 policy is exercised by
# section B through nhq-p3-guard, which is the live gate for omp and Claude Code.
# Only the jcode ADAPTER for it went away. Restore from git if jcode ever returns.

echo "── D: regressions — frozen behavior preserved ─────────────────────────"
# firststone whole-repo block still fires
FS="$TMP/firststone"
mkrepo "$FS" "https://github.com/someone/firststone.git" main "readme.md" "hi"
eq "firststone whole-repo commit → DENY" "$(p3verdict "$FS" NHQ_AGENT=Director NHQ_SESSION=main)" "DENY(firststone-whole-repo)"
# precommit mode never self-approves (even with a live token)
"$APPROVE" grant --repo heydaddy --target main >/dev/null
eq "precommit prod P3 → DENY(precommit-no-selfapprove)" "$(env NHQ_AGENT=Director NHQ_SESSION=main "$P3" check "$HD" precommit 2>/dev/null | sed -n '1p' | sed 's/^P3: //')" "DENY(precommit-no-selfapprove)"
# no-policy-file fails closed on a scoped prod repo
eq "no-policy-file prod P3 → DENY(no-policy-file)" "$(env NHQ_P3_PATHS="$TMP/does-not-exist.json" NHQ_AGENT=Director NHQ_SESSION=main "$P3" check "$HD" 2>/dev/null | sed -n '1p' | sed 's/^P3: //')" "DENY(no-policy-file)"

echo "────────────────────────────────────────────────────────────────────────"
echo "nhq-approve-selftest: $pass passed, $fail failed"
[[ $fail -eq 0 ]]
