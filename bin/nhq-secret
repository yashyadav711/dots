#!/usr/bin/env bash
# nhq-secret — the fleet's local vault. One KeePassXC database, unlocked by a
# password sealed to THIS machine's TPM, read by agents through this CLI.
#
# WHY THIS EXISTS: secrets on this box were plaintext and scattered — a 23 KB
# ~/.hermes/.env, four loose keys in ~/.config/nhq/, and 16 .env files across
# product repos. There was no password manager installed at all. And the disk has
# NO full-disk encryption (root is plain btrfs, no LUKS), so at-rest protection
# was zero: a stolen laptop was a stolen set of credentials.
#
# WHY TPM SEALING IS THE POINT: `systemd-creds ... --with-key=tpm2` produces a
# blob that only decrypts on this machine. With no FDE underneath, that is the
# single protection that actually addresses the realistic threat — the laptop
# leaving the house. Verified 2026-08-20: seal → 511 bytes, unseal → original
# value, and decrypting under a different --name is refused.
#
# WHAT THIS IS NOT: a permission system. Every agent runs as the same Unix user,
# so any of them can call `keepassxc-cli` directly and bypass everything here.
# The accounts/ tier therefore buys a Telegram alert and an audit line —
# DETECTION, not prevention. Anything stronger needs a secret the box does not
# hold (a passphrase typed per use, or a FIDO2 touch), which would break
# unattended operation. Design + threat model:
#   envy/docs/superpowers/specs/2026-08-20-nhq-secret-design.md
#
#   nhq-secret init                     create the vault, seal its password
#   nhq-secret get <path>               print one secret
#   nhq-secret user <path>              print the username
#   nhq-secret totp <path>              print the current TOTP code
#   nhq-secret totp-add <path> <seed>   store a TOTP seed (or otpauth:// URI)
#   nhq-secret list [group]             list entry paths (never values)
#   nhq-secret rm <path>                remove an entry
#   nhq-secret add <path> [-u USER] [--url URL]   value on stdin
#   nhq-secret gen <path> [-u USER] [--url URL]   generate + store, print it
#   nhq-secret login <path>             fill the entry into the shared browser
#   nhq-secret password                 reveal the master password (for the GUI)
#   nhq-secret lock                     forget the cached password
#   nhq-secret status                   vault + TPM health
set -uo pipefail

HOME_DIR="${NHQ_SECRET_HOME:-$HOME/.nhq-secret}"
VAULT="${NHQ_SECRET_VAULT:-$HOME_DIR/vault.kdbx}"
CRED="$HOME_DIR/unlock.cred"
AUDIT="$HOME_DIR/audit.log"
CRED_NAME="nhq-secret"
# tmpfs, mode 700, owned by this user, wiped by a reboot. See vault_pw().
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/nhq-secret"
CACHE="$CACHE_DIR/pw"

die()  { printf 'nhq-secret: %s\n' "$*" >&2; exit 1; }
say()  { printf '%s\n' "$*"; }

# ── TPM access ───────────────────────────────────────────────────────────────
# /dev/tpmrm0 is root:tss, so TPM use needs the `tss` group. A group added with
# usermod only lands in NEW login sessions, and the agents running right now
# started before it — so we must not assume direct access. `sg tss -c` picks the
# group up immediately for a single command (measured cost: 58 ms), which is why
# every TPM call goes through here instead of calling systemd-creds directly.
in_tss() { id -nG 2>/dev/null | tr ' ' '\n' | grep -qx tss; }
tpm_run() {
  if in_tss; then bash -c "$1"; else sg tss -c "$1"; fi
}

# The vault password, on stdout, with EXACTLY ONE trailing newline.
#
# THE NEWLINE IS LOAD-BEARING. The sealed blob holds the password with no
# newline, and keepassxc-cli reads its database password as a LINE from stdin.
# Emitting it raw made `add` — which reads the db password and then the entry
# value from the SAME stream — concatenate the two into one bogus password, so
# every add failed while `show` still worked (it reads to EOF).
#
# WHY IT IS CACHED: the TPM unseal costs 6.4 SECONDS on this laptop (measured;
# `sg` is only 58 ms of that). Paying that on every read made the tool unusable
# for an agent doing more than one lookup. The cache lives in
# $XDG_RUNTIME_DIR — tmpfs, so RAM-backed, mode 700 and owned by this user, and
# gone on reboot. That is the natural expiry: no TTL to tune, and the password
# never touches a real disk.
#
# The honest cost: the password now sits in RAM readable by anything running as
# yash. That is already true of the vault itself under this design — every agent
# is the same user — so the cache widens nothing that was previously closed. It
# does mean `nhq-secret lock` is the thing to run if you ever want it gone before
# a reboot.
vault_pw() {
  if [[ -s "$CACHE" ]]; then cat "$CACHE"; return 0; fi
  [[ -f "$CRED" ]] || die "no sealed password at $CRED — run: nhq-secret init"
  local pw
  pw="$(tpm_run "systemd-creds decrypt --name=$CRED_NAME $(printf '%q' "$CRED") -" 2>/dev/null)" \
    || die "could not unseal the vault password (TPM unreachable, or the credential was created on another machine)"
  [[ -n "$pw" ]] || die "unsealed an empty vault password"
  mkdir -p "$CACHE_DIR" && chmod 700 "$CACHE_DIR"
  ( umask 077; printf '%s\n' "$pw" > "$CACHE" )
  printf '%s\n' "$pw"
}

# ── audit ────────────────────────────────────────────────────────────────────
# Records reads THROUGH THIS TOOL. An agent calling keepassxc-cli itself leaves
# no line — stated in the design rather than implied, because a log whose gaps
# you do not know about is worse than no log.
agent_name() {
  local n; n="$(nhq-agent-name 2>/dev/null)"
  printf '%s' "${n:-unknown}"
}
audit() {
  local verb="$1" path="$2"
  mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR" 2>/dev/null || true
  printf '%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$(agent_name)" "$verb" "$path" >> "$AUDIT"
  chmod 600 "$AUDIT" 2>/dev/null || true
}

# accounts/* reads are loud. machine/* reads are not: an API key read is a
# routine part of an agent doing its job, and a notification on every one of
# those would train Yash to ignore the notification that matters.
notify_if_account() {
  local path="$1" verb="$2"
  [[ "$path" == accounts/* || "$verb" == password ]] || return 0
  command -v nhq-bot >/dev/null 2>&1 || return 0
  # Backgrounded so a slow Telegram round-trip never stalls an agent mid-task.
  ( nhq-bot notify --event completed \
      --title "Vault read: $path" \
      --body "$(agent_name) ran \`nhq-secret $verb $path\` on the shared vault. If that was not expected, check $AUDIT and rotate the credential." \
      >/dev/null 2>&1 & ) 2>/dev/null
}

kp() { keepassxc-cli "$@"; }
kp_read() { vault_pw | kp "$@"; }
require_vault() { [[ -f "$VAULT" ]] || die "no vault at $VAULT — run: nhq-secret init"; }

# ── commands ─────────────────────────────────────────────────────────────────
cmd_init() {
  command -v keepassxc-cli >/dev/null || die "keepassxc-cli missing — sudo pacman -S keepassxc"
  [[ -f "$VAULT" ]] && die "vault already exists at $VAULT (refusing to overwrite)"
  mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR"

  local pw; pw="$(kp generate -L 64 -l -U -n 2>/dev/null)"
  [[ -n "$pw" ]] || die "could not generate a vault password"

  printf '%s\n%s\n' "$pw" "$pw" | kp db-create -q -p "$VAULT" >/dev/null 2>&1
  [[ -f "$VAULT" ]] || die "db-create failed"
  chmod 600 "$VAULT"
  for g in machine accounts; do printf '%s\n' "$pw" | kp mkdir -q "$VAULT" "$g" >/dev/null 2>&1; done

  # --name binds the blob to this name as well as this machine, so a copied blob
  # cannot be replayed under a different credential.
  printf '%s' "$pw" | tpm_run "systemd-creds encrypt --with-key=tpm2 --name=$CRED_NAME - $(printf '%q' "$CRED")" \
    || die "TPM sealing failed — is yash in group tss? (usermod -aG tss yash)"
  chmod 600 "$CRED"
  unset pw

  audit init vault
  say "vault    : $VAULT"
  say "sealed   : $CRED  (TPM-bound to this machine AND to the name '$CRED_NAME')"
  say "groups   : machine/  accounts/"
  say
  say "The master password exists ONLY inside that sealed blob. Lose $CRED, or"
  say "reset the TPM, and the vault is unrecoverable. To open the vault in the"
  say "KeePassXC GUI, run: nhq-secret password"
}

cmd_get() {
  local path="${1:?usage: nhq-secret get <path>}"
  require_vault
  local v; v="$(kp_read show -q -s -a Password "$VAULT" "$path" 2>/dev/null)"
  [[ -n "$v" && "$v" != *"Could not find entry"* ]] || die "no entry at $path"
  audit get "$path"; notify_if_account "$path" get
  printf '%s' "$v"
}

cmd_user() {
  local path="${1:?usage: nhq-secret user <path>}"
  require_vault
  local v; v="$(kp_read show -q -a UserName "$VAULT" "$path" 2>/dev/null)"
  [[ -n "$v" && "$v" != *"Could not find entry"* ]] || die "no entry at $path"
  audit user "$path"
  printf '%s' "$v"
}

cmd_totp() {
  local path="${1:?usage: nhq-secret totp <path>}"
  require_vault
  local v; v="$(kp_read show -q -t "$VAULT" "$path" 2>/dev/null)"
  case "$v" in
    ""|*"no TOTP"*|*"Could not find"*)
      die "no TOTP on $path — add one with: nhq-secret totp-add $path <seed>" ;;
  esac
  audit totp "$path"; notify_if_account "$path" totp
  printf '%s' "$v"
}

# Store a TOTP seed. keepassxc-cli cannot set custom attributes (`edit` has no
# flag for them and a seed in Notes is ignored — both measured), and the GUI is
# not an option for an agent. So: export the whole database to XML, inject the
# TOTP strings into the right entry, and import it back. UUIDs live in the XML,
# so entries keep their identity across the round trip.
#
# The old vault is kept as a timestamped .bak and the new one is only moved into
# place AFTER the seed reads back as a real 6-digit code — a half-written vault
# is the one failure mode that would cost real credentials.
cmd_totp_add() {
  local path="${1:?usage: nhq-secret totp-add <path> <base32-seed|otpauth://...>}"
  local seed="${2:?usage: nhq-secret totp-add <path> <base32-seed|otpauth://...>}"
  require_vault
  local pw; pw="$(vault_pw)"
  local tmpx tmpd; tmpx="$(mktemp -t nhqsec.XXXXXX.xml)"; tmpd="$(mktemp -u -t nhqsec.XXXXXX.kdbx)"
  # shellcheck disable=SC2064
  trap "rm -f '$tmpx' '$tmpd'" RETURN

  printf '%s\n' "$pw" | kp export -q -f xml "$VAULT" > "$tmpx" 2>/dev/null
  [[ -s "$tmpx" ]] || die "export failed"

  NHQ_PATH="$path" NHQ_SEED="$seed" python3 - "$tmpx" <<'PY' || die "could not inject the seed"
import os, sys, re, base64
import xml.etree.ElementTree as ET
from urllib.parse import urlparse, parse_qs

want, seed = os.environ["NHQ_PATH"], os.environ["NHQ_SEED"].strip()
digits, period = "6", "30"
if seed.lower().startswith("otpauth://"):
    q = parse_qs(urlparse(seed).query)
    if "secret" not in q: sys.exit("otpauth URI has no secret= parameter")
    digits = q.get("digits", ["6"])[0]; period = q.get("period", ["30"])[0]
    seed = q["secret"][0]
seed = re.sub(r"\s+", "", seed).upper()
try:
    base64.b32decode(seed + "=" * (-len(seed) % 8))
except Exception:
    sys.exit("seed is not valid base32")

path = sys.argv[1]
tree = ET.parse(path); root = tree.getroot()

# The TOP-LEVEL group's own name is dropped, whatever it is called. keepassxc-cli
# addresses entries relative to the root group, and that group is NOT named
# "Root" — on this vault it is "Passwords" (measured). Hardcoding a name made
# every path resolve to "Passwords/machine/..." and nothing ever matched.
def walk(group, prefix, top=False):
    name = "" if top else (group.findtext("Name") or "")
    here = prefix if not name else (f"{prefix}/{name}" if prefix else name)
    for e in group.findall("Entry"):
        title = ""
        for s in e.findall("String"):
            if s.findtext("Key") == "Title": title = s.findtext("Value") or ""
        yield (f"{here}/{title}" if here else title), e
    for g in group.findall("Group"):
        yield from walk(g, here)

target = None
for p, e in walk(root.find("Root").find("Group"), "", top=True):
    if p == want: target = e; break
if target is None: sys.exit(f"no entry at {want}")

for key, val in (("TOTP Seed", seed), ("TOTP Settings", f"{period};{digits}")):
    for s in target.findall("String"):
        if s.findtext("Key") == key:
            s.find("Value").text = val; break
    else:
        s = ET.SubElement(target, "String")
        ET.SubElement(s, "Key").text = key
        ET.SubElement(s, "Value").text = val
tree.write(path, encoding="UTF-8", xml_declaration=True)
PY

  printf '%s\n%s\n' "$pw" "$pw" | kp import -q -p "$tmpx" "$tmpd" >/dev/null 2>&1
  [[ -s "$tmpd" ]] || die "import failed — vault untouched"

  local code; code="$(printf '%s\n' "$pw" | kp show -q -t "$tmpd" "$path" 2>/dev/null)"
  [[ "$code" =~ ^[0-9]{6,8}$ ]] || die "the rebuilt vault did not produce a TOTP code — vault untouched"

  cp -a "$VAULT" "$VAULT.bak-$(date +%Y%m%d-%H%M%S)"
  mv "$tmpd" "$VAULT"; chmod 600 "$VAULT"
  audit totp-add "$path"
  say "TOTP stored on $path (verified: it produced $code)"
  say "previous vault kept as $VAULT.bak-*"
}

# Without this, a mistyped entry could only be removed through the GUI — and the
# GUI needs the 64-char master password, so an agent had no way to undo its own
# mistake.
#
# TWO PASSES, deliberately. keepassxc's `rm` MOVES the entry to "Recycle Bin"
# rather than deleting it, and a secret in the bin is still fully readable —
# measured: after `rm machine/probekey`, `get "Recycle Bin/probekey"` returned the
# value verbatim. A tool that prints "removed" while the credential is still
# retrievable from the same file is worse than one with no rm at all, so the
# second pass (rm on the bin path) purges it for real.
cmd_rm() {
  local path="${1:?usage: nhq-secret rm <path>}"
  require_vault
  kp_read rm -q "$VAULT" "$path" >/dev/null 2>&1 || die "could not remove $path (does it exist? try: nhq-secret list)"
  # Now purge whatever the bin caught. The entry keeps its title, not its group.
  local leaf="${path##*/}"
  kp_read rm -q "$VAULT" "Recycle Bin/$leaf" >/dev/null 2>&1 || true
  audit rm "$path"
  if [[ -n "$(cmd_list 2>/dev/null | grep -Fx "Recycle Bin/$leaf")" ]]; then
    say "removed $path — WARNING: a copy is still in Recycle Bin/$leaf, purge it manually"
  else
    say "purged $path"
  fi
}

cmd_list() {
  require_vault
  local out; out="$(kp_read ls -q -R -f "$VAULT" "${1:-}" 2>/dev/null)"
  printf '%s\n' "$out" | grep -vE '/$|\[empty\]|^$' || true
}

# Value comes from stdin so a secret never lands in the shell history or in the
# process list where `ps` would show it.
cmd_add() {
  local path="${1:?usage: nhq-secret add <path> [-u USER] [--url URL]  (value on stdin)}"; shift
  require_vault
  local user="" url=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username) user="${2:-}"; shift 2 ;;
      --url)         url="${2:-}";  shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  local val; IFS= read -r val || true
  [[ -n "$val" ]] || die "no value on stdin"

  local args=(add -q -p)
  [[ -n "$user" ]] && args+=(-u "$user")
  [[ -n "$url"  ]] && args+=(--url "$url")
  args+=("$VAULT" "$path")

  # db password, then entry password — same stream, this order.
  { vault_pw; printf '%s\n' "$val"; } | kp "${args[@]}" >/dev/null 2>&1 \
    || die "add failed (does the group exist? try: nhq-secret list)"
  unset val
  audit add "$path"
  say "stored $path"
}

cmd_gen() {
  local path="${1:?usage: nhq-secret gen <path> [-u USER] [--url URL]}"; shift
  local pw; pw="$(kp generate -L 32 -l -U -n 2>/dev/null)"
  [[ -n "$pw" ]] || die "could not generate a password"
  # `|| die` matters: without it a failed add still printed a password Yash would
  # reasonably assume was stored, handing him a credential the vault never saw.
  printf '%s\n' "$pw" | cmd_add "$path" "$@" >/dev/null \
    || die "generated a password but storing it FAILED — nothing was saved"
  audit gen "$path"
  printf '%s' "$pw"
}

# Fill the entry into the SHARED browser rather than a private one, so the login
# lands in the profile every other agent already uses. Own tab, shared context —
# a new context would start logged out, which defeats the point.
cmd_login() {
  local path="${1:?usage: nhq-secret login <path>}"
  require_vault
  command -v nhq-browser >/dev/null || die "nhq-browser missing"
  local cdp; cdp="$(nhq-browser url 2>/dev/null)" || die "shared browser is not live — nhq-browser start"

  local u p url totp=""
  u="$(cmd_user "$path" 2>/dev/null || true)"
  p="$(cmd_get "$path")"
  url="$(kp_read show -q -a URL "$VAULT" "$path" 2>/dev/null)"
  [[ -n "$url" && "$url" != *"Could not find"* ]] || die "entry $path has no URL to log into"
  totp="$(kp_read show -q -t "$VAULT" "$path" 2>/dev/null)"
  [[ "$totp" =~ ^[0-9]{6,8}$ ]] || totp=""

  audit login "$path"
  NODE_PATH="$(npm root -g)" NHQ_U="$u" NHQ_P="$p" NHQ_URL="$url" NHQ_CDP="$cdp" NHQ_TOTP="$totp" node -e '
const { chromium } = require("playwright");
(async () => {
  const b = await chromium.connectOverCDP(process.env.NHQ_CDP);
  const ctx = b.contexts()[0];                 // the PERSISTENT context
  const page = await ctx.newPage();            // our own tab
  await page.goto(process.env.NHQ_URL, { waitUntil: "domcontentloaded" });
  const user = page.locator(
    "input[type=email], input[name*=user i], input[name*=email i], input[id*=user i], input[id*=email i]").first();
  const pass = page.locator("input[type=password]").first();
  if (process.env.NHQ_U && await user.count()) await user.fill(process.env.NHQ_U);
  if (!(await pass.count())) { console.log("no password field on " + page.url() + " — tab left open"); await b.close(); return; }
  await pass.fill(process.env.NHQ_P);
  let note = "filled username+password";
  if (process.env.NHQ_TOTP) note += " (TOTP " + process.env.NHQ_TOTP + " ready — the field usually appears after submit)";
  console.log(note + " on " + page.url() + " — tab left open, NOT submitted");
  await b.close();                             // detaches; the browser stays up
})().catch(e => { console.error("login failed: " + e.message); process.exit(1); });
' || die "browser fill failed"
}

# For the KeePassXC GUI. The master password is a 64-char random that nobody was
# ever meant to memorise, so without this command Yash could not open his own
# vault — which is exactly the wall this hit on day one.
cmd_password() {
  require_vault
  audit password vault; notify_if_account vault password
  say "$(vault_pw)"
  say
  say "Paste that into KeePassXC and open $VAULT"
  say "It is cached in RAM at $CACHE — 'nhq-secret lock' forgets it."
}

cmd_lock() { rm -f "$CACHE"; say "cached password forgotten (next read pays the ~6s TPM unseal)"; }

cmd_status() {
  local tpm="unreachable" v="absent" n=0 a=0 cached
  # Sample the cache state FIRST. Counting entries below unseals the vault, which
  # CREATES the cache — so reading this afterwards always reported "yes" and the
  # line could never tell the truth about a cold start.
  [[ -s "$CACHE" ]] && cached="yes (cached in RAM at $CACHE)" || cached="no (next read pays the TPM unseal)"
  tpm_run "systemd-analyze has-tpm2" >/dev/null 2>&1 && tpm="ok$(in_tss || printf ' (via sg tss — re-login to drop the fallback)')"
  if [[ -f "$VAULT" ]]; then
    v="$VAULT ($(du -h "$VAULT" | cut -f1))"
    local l; l="$(cmd_list 2>/dev/null)"
    n=$(printf '%s\n' "$l" | grep -c '^machine/' || true)
    a=$(printf '%s\n' "$l" | grep -c '^accounts/' || true)
  fi
  say "vault    : $v"
  say "sealed   : $([[ -f $CRED ]] && echo "$CRED" || echo 'absent — run: nhq-secret init')"
  say "tpm      : $tpm"
  say "unlocked : $cached"
  say "entries  : machine/=$n  accounts/=$a"
  say "audit    : $AUDIT ($([[ -f $AUDIT ]] && wc -l < "$AUDIT" || echo 0) lines)"
}

case "${1:-status}" in
  init)      cmd_init ;;
  get)       shift; cmd_get "$@" ;;
  user)      shift; cmd_user "$@" ;;
  totp)      shift; cmd_totp "$@" ;;
  totp-add)  shift; cmd_totp_add "$@" ;;
  list)      shift; cmd_list "$@" ;;
  rm)        shift; cmd_rm "$@" ;;
  add)       shift; cmd_add "$@" ;;
  gen)       shift; cmd_gen "$@" ;;
  login)     shift; cmd_login "$@" ;;
  password)  cmd_password ;;
  lock)      cmd_lock ;;
  status)    cmd_status ;;
  *) sed -n '/^#   nhq-secret init/,/^#   nhq-secret status/p' "$(readlink -f "${BASH_SOURCE[0]}")" | sed 's/^# \?//'; exit 2 ;;
esac
