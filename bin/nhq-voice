#!/usr/bin/env python3
"""nhq-voice — record voice samples and measure what the transcriber does with them.

    nhq-voice test ["label"]     TUI bench: speak -> read -> edit -> see the diff
    nhq-voice record ["label"]   record one sample; Enter stops it
    nhq-voice record "x" --secs 8   fixed length, no keyboard needed
    nhq-voice list               what has been recorded
    nhq-voice play <n>           listen back
    nhq-voice transcribe [n]     run sample(s) through the live whisper server
    nhq-voice truth <n> "..."    record what you actually said, for accuracy
    nhq-voice rm <n>             delete one

WHY THIS EXISTS: changing anything in the dictation path — the model, the
vocabulary, batch instead of live decoding, a rewrite pass through an external
model — is only worth doing if it measurably improves the text. Without a fixed
set of clips, every "this feels better" is a guess made on a fresh sentence that
the last version never saw. Record once, re-run forever.

CAPTURE IS DELIBERATELY IDENTICAL TO vox: `parecord --raw --rate=16000
--channels=1 --format=s16le --latency-msec=50`, honouring the same `source` in
~/.config/vox/config.toml. A sample recorded through a different mic path, rate
or denoiser would measure that difference instead of the change under test.

Samples live in ~/.local/share/vox/samples/ as plain 16 kHz mono WAV, with one
JSON line of metadata each. Nothing here is throwaway — they are the regression
suite for the ear.
"""

import difflib
import atexit
import json
import os
import socket
import re
import tempfile
import textwrap
import shutil
import subprocess
import sys
import threading
import time
import wave
from array import array
from datetime import datetime
from pathlib import Path

RATE = 16000
HOME = Path.home()
DIR = Path(os.environ.get("NHQ_VOICE_DIR", HOME / ".local/share/vox/samples"))
META = DIR / "samples.jsonl"
CFG = HOME / ".config/vox/config.toml"


def source() -> str:
    """The mic vox itself would use — an empty value means the system default."""
    try:
        for line in CFG.read_text().splitlines():
            s = line.split("#", 1)[0].strip()
            if s.startswith("source") and "=" in s:
                return s.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return ""


def whisper_port() -> int:
    try:
        for line in CFG.read_text().splitlines():
            s = line.split("#", 1)[0].strip()
            if s.startswith("whisper_port") and "=" in s:
                return int(s.split("=", 1)[1].strip())
    except (OSError, ValueError):
        pass
    return 8127


_OWNED = None          # a whisper-server this process started, to kill on exit


def cfg_val(key: str, default: str = "") -> str:
    try:
        for line in CFG.read_text().splitlines():
            s = line.split("#", 1)[0].strip()
            if s.startswith(key) and "=" in s:
                return s.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return default


def port_open(p: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", p), timeout=0.4):
            return True
    except OSError:
        return False


def ensure_server(say=lambda _s: None) -> int:
    """Return a port with whisper-server listening, starting one if needed.

    Prefers the daemon's own server when it happens to be up — it is already
    warm and costs nothing. Otherwise starts a private one on a DIFFERENT port:
    voxd spawns and owns `whisper_port`, and squatting on it would make his next
    dictation fail to start its engine. Args are copied from voxd._spawn so the
    bench measures the same decoder, not a differently-configured one.
    """
    global _OWNED
    live = whisper_port()
    if port_open(live):
        return live
    mine = live + 100
    if port_open(mine):
        return mine
    model = os.path.expanduser(cfg_val("whisper_model"))
    if not model or not Path(model).exists():
        raise RuntimeError(f"whisper_model not found: {model!r}")
    if shutil.which("whisper-server") is None:
        raise RuntimeError("whisper-server not on PATH (install whisper-cpp)")
    say("starting whisper server…")
    args = ["whisper-server", "-m", model,
            "-t", cfg_val("threads", "4"), "-bs", "1",
            "-l", cfg_val("whisper_lang", "en"), "-mc", "0", "-nt",
            "--host", "127.0.0.1", "--port", str(mine)]
    _OWNED = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    atexit.register(stop_server)
    deadline = time.time() + 60
    while time.time() < deadline:
        if _OWNED.poll() is not None:
            raise RuntimeError("whisper-server exited during startup")
        if port_open(mine):
            return mine
        time.sleep(0.3)
    raise TimeoutError("whisper-server did not come up in 60s")


def stop_server() -> None:
    global _OWNED
    if _OWNED and _OWNED.poll() is None:
        _OWNED.terminate()
        try:
            _OWNED.wait(timeout=3)
        except subprocess.TimeoutExpired:
            _OWNED.kill()
    _OWNED = None


def rows() -> list[dict]:
    if not META.exists():
        return []
    return [json.loads(l) for l in META.read_text().splitlines() if l.strip()]


def save(row: dict) -> None:
    DIR.mkdir(parents=True, exist_ok=True)
    with META.open("a") as f:
        f.write(json.dumps(row) + "\n")


def rewrite(all_rows: list[dict]) -> None:
    META.write_text("".join(json.dumps(r) + "\n" for r in all_rows))


def bar(level: float, width: int = 44) -> str:
    """A level meter, because a recorder with no feedback is a recorder you do
    not trust. Same reason vox draws a waveform instead of a spinner."""
    n = min(width, int(level * width))
    return "█" * n + "·" * (width - n)


def rms(chunk: bytes) -> float:
    """Level of one 16-bit mono chunk, 0..1.

    Hand-rolled because `audioop` was removed from the stdlib in Python 3.13 and
    this box runs 3.14. `array` reads the frames natively, so a 100 ms chunk is
    1600 samples — cheap enough to do every frame without numpy.
    """
    if not chunk:
        return 0.0
    a = array("h")
    a.frombytes(chunk[: len(chunk) // 2 * 2])
    if not a:
        return 0.0
    return (sum(s * s for s in a) / len(a)) ** 0.5 / 32768.0


def cmd_record(label: str, secs: float = 0.0) -> int:
    DIR.mkdir(parents=True, exist_ok=True)
    n = len(rows()) + 1
    label = label or f"sample-{n}"
    slug = "".join(c if c.isalnum() or c in "-_" else "-" for c in label.lower())[:40]
    path = DIR / f"{n:02d}-{slug}.wav"

    cmd = ["parecord", "--raw", f"--rate={RATE}", "--channels=1",
           "--format=s16le", "--latency-msec=50"]
    if source():
        cmd += ["-d", source()]

    try:
        # stderr is captured, never discarded: a mic that will not open is the
        # single most likely failure here and swallowing the reason wastes the
        # next twenty minutes.
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0)
    except FileNotFoundError:
        print("nhq-voice: parecord not found — install pipewire-pulse", file=sys.stderr)
        return 2

    stop = threading.Event()
    if secs:
        print(f"\n  ● recording  \033[2m{label}\033[0m")
        print(f"    bolo… \033[2mstops after {secs}s\033[0m\n")
        threading.Timer(secs, stop.set).start()
    elif sys.stdin.isatty():
        print(f"\n  ● recording  \033[2m{label}\033[0m")
        print("    bolo… \033[2mEnter = stop\033[0m\n")
        threading.Thread(target=lambda: (sys.stdin.readline(), stop.set()), daemon=True).start()
    else:
        # Enter-to-stop needs a keyboard. Piped or scripted, stdin is at EOF the
        # instant we read it, which would end the recording before it began.
        print("nhq-voice: stdin is not a terminal — pass --secs N", file=sys.stderr)
        proc.terminate()
        return 2

    frames, started, peak = [], time.time(), 0.0
    tty = sys.stdout.isatty()
    try:
        while not stop.is_set():
            chunk = proc.stdout.read(3200)          # 100 ms at 16 kHz mono s16
            if not chunk:
                break
            frames.append(chunk)
            level = rms(chunk)
            peak = max(peak, level)
            if tty:
                # \r only redraws on a terminal; down a pipe it would emit one
                # line per 100 ms and bury the result.
                elapsed = time.time() - started
                sys.stdout.write(f"\r    {bar(min(1.0, level * 4))}  {elapsed:5.1f}s ")
                sys.stdout.flush()
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()

    audio = b"".join(frames)
    got = len(audio) / (RATE * 2)
    if got < 0.4:
        err = proc.stderr.read(400).decode("utf-8", "replace").strip()
        print("\r    nothing recorded" + " " * 34)
        if err:
            print(f"    parecord: {err.splitlines()[0]}", file=sys.stderr)
        return 1

    with wave.open(str(path), "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
        w.writeframes(audio)

    save({"n": n, "label": label, "file": path.name, "seconds": round(got, 2),
          "peak": round(peak, 3), "at": datetime.now().isoformat(timespec="seconds"),
          "truth": ""})
    print(f"\r    \033[32m✓\033[0m saved  {path.name}  {got:.1f}s  peak {peak:.2f}" + " " * 14)
    print(f"\n    transcribe it:  nhq-voice transcribe {n}")
    return 0


def cmd_list() -> int:
    rs = rows()
    if not rs:
        print("no samples yet — nhq-voice record \"short one\"")
        return 0
    print(f"  {'#':>2}  {'secs':>5}  {'peak':>4}  label")
    for r in rs:
        mark = "✓" if r.get("truth") else " "
        print(f"  {r['n']:>2}{mark} {r['seconds']:>6}  {r['peak']:>4}  {r['label']}")
    print(f"\n  {len(rs)} sample(s) in {DIR}")
    print("  ✓ = ground truth recorded (nhq-voice truth <n> \"...\")")
    return 0


def cmd_play(n: int) -> int:
    r = next((x for x in rows() if x["n"] == n), None)
    if not r:
        print(f"no sample {n}", file=sys.stderr)
        return 1
    return subprocess.run(["paplay", str(DIR / r["file"])]).returncode


def transcribe_one(path: Path, port: int | None = None) -> tuple[str, float]:
    """Straight at the running whisper-server, the same endpoint voxd posts to."""
    import urllib.request
    boundary = "----nhqvoice"
    body = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; "
            f"filename=\"a.wav\"\r\nContent-Type: audio/wav\r\n\r\n").encode()
    body += path.read_bytes() + b"\r\n"
    body += (f"--{boundary}\r\nContent-Disposition: form-data; "
             f"name=\"response_format\"\r\n\r\ntext\r\n").encode()
    body += f"--{boundary}--\r\n".encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{port or whisper_port()}/inference", data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    t0 = time.time()
    with urllib.request.urlopen(req, timeout=300) as resp:
        text = resp.read().decode("utf-8", "replace")
    return " ".join(text.split()).strip(), time.time() - t0


def cmd_transcribe(which: int | None) -> int:
    rs = [r for r in rows() if which is None or r["n"] == which]
    if not rs:
        print("nothing to transcribe", file=sys.stderr)
        return 1
    fails = 0
    for r in rs:
        path = DIR / r["file"]
        print(f"\n  \033[1m#{r['n']} {r['label']}\033[0m  ({r['seconds']}s)")
        try:
            text, took = transcribe_one(path, ensure_server())
        except Exception as exc:
            # The server is started lazily by voxd, so a cold box has none.
            print(f"    \033[31mfailed\033[0m: {exc}", file=sys.stderr)
            print("    (could not reach or start whisper-server)", file=sys.stderr)
            fails += 1
            continue
        rtf = took / r["seconds"] if r["seconds"] else 0
        print(f"    \033[2m{took:.1f}s  RTF {rtf:.2f}\033[0m")
        print(f"    {text}")
        if r.get("truth"):
            print(f"    \033[2mtruth:\033[0m {r['truth']}")
    return 1 if fails else 0


def cmd_truth(n: int, text: str) -> int:
    rs = rows()
    hit = next((x for x in rs if x["n"] == n), None)
    if not hit:
        print(f"no sample {n}", file=sys.stderr)
        return 1
    hit["truth"] = text
    rewrite(rs)
    print(f"  #{n} truth recorded")
    return 0


def cmd_rm(n: int) -> int:
    rs = rows()
    hit = next((x for x in rs if x["n"] == n), None)
    if not hit:
        print(f"no sample {n}", file=sys.stderr)
        return 1
    (DIR / hit["file"]).unlink(missing_ok=True)
    rewrite([x for x in rs if x["n"] != n])
    print(f"  #{n} removed")
    return 0


# ── the test bench ───────────────────────────────────────────────────────────

class Vocab:
    """Port of voxd's Vocabulary, so the bench shows what dictation ACTUALLY
    produces. Without the same [fix] pass the bench would judge the raw model
    and every rule already in vocabulary.toml would read as an error."""

    def __init__(self) -> None:
        self.rules: list[tuple[re.Pattern, str]] = []
        path = HOME / ".config/vox/vocabulary.toml"
        if not path.exists():
            return
        try:
            import tomllib
            data = tomllib.loads(path.read_text())
        except Exception:
            return
        for src, dst in sorted(data.get("fix", {}).items(), key=lambda kv: -len(kv[0])):
            src = str(src).strip()
            if src:
                pat = r"\b" + r"\s+".join(re.escape(w) for w in src.split()) + r"\b"
                self.rules.append((re.compile(pat, re.IGNORECASE), str(dst)))

    def apply(self, text: str) -> str:
        for pattern, replacement in self.rules:
            def sub(m, r=replacement):
                found = m.group(0)
                if found[:1].isupper() and r[:1].islower():
                    return r[:1].upper() + r[1:]
                return r
            text = pattern.sub(sub, text)
        return text


def word_diff(before: str, after: str) -> tuple[list, list, int]:
    """Word-level diff. Returns (was_spans, now_spans, changed_count).

    A span is (text, kind) with kind in {same, gone, new}. Word level rather
    than character level because the thing being measured is a transcriber: it
    gets whole words wrong, and a character diff of "yash"→"Yash" would report
    one character when the useful unit is one word.
    """
    a, b = before.split(), after.split()
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    was, now, changed = [], [], 0
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            was.append((" ".join(a[i1:i2]), "same"))
            now.append((" ".join(b[j1:j2]), "same"))
        else:
            if i2 > i1:
                was.append((" ".join(a[i1:i2]), "gone"))
            if j2 > j1:
                now.append((" ".join(b[j1:j2]), "new"))
            changed += max(i2 - i1, j2 - j1)
    return was, now, changed


def wer(before: str, after: str) -> float:
    a, b = before.split(), after.split()
    if not b:
        return 0.0
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    edits = sum(max(i2 - i1, j2 - j1)
                for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag != "equal")
    return 100.0 * edits / len(b)


def cmd_test(label: str) -> int:
    try:
        import curses
    except ImportError:
        print("nhq-voice: curses unavailable", file=sys.stderr)
        return 2
    return curses.wrapper(_bench, label)


def _bench(scr, label: str) -> int:
    import curses
    curses.curs_set(0)
    scr.nodelay(True)
    curses.use_default_colors()
    for i, fg in enumerate((curses.COLOR_CYAN, curses.COLOR_GREEN, curses.COLOR_RED,
                            curses.COLOR_YELLOW), start=1):
        curses.init_pair(i, fg, -1)
    ACCENT, GREEN, RED, AMBER = (curses.color_pair(i) for i in range(1, 5))
    DIM = curses.A_DIM

    state = {"phase": "ready", "raw": "", "edited": "", "secs": 0.0,
             "took": 0.0, "levels": [], "path": None, "err": "", "label": label}
    vocab = Vocab()

    def draw() -> None:
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 12 or w < 50:
            scr.addstr(0, 0, "terminal too small"[: max(0, w - 1)])
            scr.refresh()
            return
        rule = "─" * (w - 2)

        head = {"ready": "ready", "recording": "● recording",
                "transcribing": "transcribing…", "review": "review",
                "diff": "diff", "saved": "saved"}[state["phase"]]
        scr.addstr(0, 1, "nhq-voice", curses.A_BOLD)
        scr.addstr(0, 11, "· dictation test", DIM)
        right = ""
        if state["phase"] == "recording":
            right = f"{state['secs']:.1f}s"
        elif state["took"]:
            rtf = state["took"] / state["secs"] if state["secs"] else 0
            right = f"{state['secs']:.1f}s spoken · {state['took']:.1f}s decode · RTF {rtf:.2f}"
        scr.addstr(0, max(12, w - len(right) - 2), right[: w - 14], DIM)
        scr.addstr(1, 1, rule, DIM)

        y = 3
        if state["phase"] in ("ready", "recording"):
            scr.addstr(y, 2, head, AMBER | curses.A_BOLD if state["phase"] == "recording" else DIM)
            y += 2
            # A scrolling waveform, not a spinner: it is the one thing that
            # proves the mic is live before you have any text to look at.
            blocks = " ▁▂▃▄▅▆▇█"
            span = w - 6
            hist = state["levels"][-span:]
            line = "".join(blocks[min(8, int(v * 8 * 4))] for v in hist)
            scr.addstr(y, 3, line[:span], ACCENT)
            y += 2
        if state["phase"] == "transcribing":
            scr.addstr(y, 2, head, AMBER)
            y += 2
        if state["err"]:
            for ln in textwrap.wrap(state["err"], w - 6)[:3]:
                scr.addstr(y, 3, ln, RED)
                y += 1
            y += 1

        def block(title, text, attr=0, colour=None):
            nonlocal y
            if y >= h - 3:
                return
            scr.addstr(y, 2, title, DIM | curses.A_BOLD)
            y += 1
            for ln in textwrap.wrap(text or "—", w - 6)[: max(1, (h - y - 4) // 2)]:
                if y >= h - 3:
                    break
                scr.addstr(y, 3, ln, colour or attr)
                y += 1
            y += 1

        if state["phase"] in ("review", "saved") and state["raw"]:
            block("TRANSCRIPT", state["edited"] or state["raw"])
        if state["phase"] == "diff":
            was, now, changed = word_diff(state["raw"], state["edited"])
            pct = wer(state["raw"], state["edited"])
            scr.addstr(y, 2, f"{changed} word(s) changed · WER {pct:.1f}%",
                       (GREEN if changed == 0 else AMBER) | curses.A_BOLD)
            y += 2
            for title, spans, bad in (("WAS", was, RED), ("NOW", now, GREEN)):
                if y >= h - 4:
                    break
                scr.addstr(y, 2, title, DIM | curses.A_BOLD)
                y += 1
                x = 3
                for text, kind in spans:
                    for word in text.split():
                        if x + len(word) + 1 > w - 3:
                            y += 1
                            x = 3
                            if y >= h - 4:
                                break
                        scr.addstr(y, x, word, bad | curses.A_BOLD if kind != "same" else DIM)
                        x += len(word) + 1
                y += 2

        keys = {
            "ready": "space  start        q  quit",
            "recording": "space  stop         q  cancel",
            "transcribing": "",
            "review": "e  edit        r  re-record        s  save        q  quit",
            "diff": "e  edit again   s  save as truth     r  re-record   q  quit",
            "saved": "r  another      q  quit",
        }[state["phase"]]
        scr.addstr(h - 2, 1, rule, DIM)
        scr.addstr(h - 1, 2, keys[: w - 4], DIM)
        scr.refresh()

    def record() -> None:
        cmd = ["parecord", "--raw", f"--rate={RATE}", "--channels=1",
               "--format=s16le", "--latency-msec=50"]
        if source():
            cmd += ["-d", source()]
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, bufsize=0)
        except FileNotFoundError:
            state["err"] = "parecord not found — install pipewire-pulse"
            state["phase"] = "ready"
            return
        state.update(phase="recording", levels=[], secs=0.0, raw="", edited="",
                     took=0.0, err="")
        frames, t0 = [], time.time()
        while True:
            draw()
            if scr.getch() in (ord(" "), ord("q"), 27):
                break
            chunk = proc.stdout.read(3200)
            if not chunk:
                break
            frames.append(chunk)
            state["levels"].append(rms(chunk))
            state["secs"] = time.time() - t0
            if state["secs"] > 300:
                break
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()

        audio = b"".join(frames)
        state["secs"] = len(audio) / (RATE * 2)
        if state["secs"] < 0.4:
            err = proc.stderr.read(300).decode("utf-8", "replace").strip()
            state["err"] = f"nothing recorded — {err.splitlines()[0] if err else 'mic gave no audio'}"
            state["phase"] = "ready"
            return

        # Write the WAV BEFORE transcribing. The recording is the expensive,
        # unrepeatable half; a transcriber that is down must never cost it.
        #
        # It lands in a temp file, not the sample library: a bench run you decide
        # not to keep would otherwise leave a WAV that `list` never shows, since
        # only saved runs get a metadata line. Kept until save, then moved in.
        path = Path(tempfile.mkstemp(suffix=".wav", prefix="nhq-voice-bench-")[1])
        with wave.open(str(path), "wb") as wv:
            wv.setnchannels(1); wv.setsampwidth(2); wv.setframerate(RATE)
            wv.writeframes(audio)
        state["path"] = path

        state["phase"] = "transcribing"
        draw()
        try:
            def say(msg):
                state["err"] = msg
                draw()
            port = ensure_server(say)
            state["err"] = ""
            text, took = transcribe_one(path, port)
            state["raw"] = vocab.apply(text)
            state["took"] = took
            state["phase"] = "review"
        except Exception as exc:
            state["err"] = (f"transcribe failed: {exc} — audio is safe at "
                            f"{path.name}. Dictate once with Alt×2 to start the "
                            f"whisper server, then re-run.")
            state["phase"] = "ready"

    def edit() -> None:
        base = state["edited"] or state["raw"]
        tmp = Path(tempfile.mkstemp(suffix=".txt", prefix="nhq-voice-")[1])
        tmp.write_text(base + "\n")
        curses.def_prog_mode()
        curses.endwin()
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vim"
        subprocess.run([editor, str(tmp)])
        curses.reset_prog_mode()
        scr.clear()
        state["edited"] = tmp.read_text().strip()
        tmp.unlink(missing_ok=True)
        state["phase"] = "diff" if state["edited"] != state["raw"] else "review"

    def do_save() -> None:
        # NOT named save(): it calls the module-level save() and would recurse.
        n = len(rows()) + 1
        lbl = state["label"] or f"bench-{n}"
        slug = "".join(c if c.isalnum() or c in "-_" else "-" for c in lbl.lower())[:40]
        DIR.mkdir(parents=True, exist_ok=True)
        final = DIR / f"{n:02d}-{slug}.wav"
        shutil.move(str(state["path"]), final)
        state["path"] = final
        save_row = {
            "n": n, "label": lbl,
            "file": final.name,
            "seconds": round(state["secs"], 2),
            "peak": round(max(state["levels"] or [0]), 3),
            "at": datetime.now().isoformat(timespec="seconds"),
            "raw": state["raw"],
            "truth": state["edited"] or state["raw"],
            "wer": round(wer(state["raw"], state["edited"] or state["raw"]), 2),
        }
        save(save_row)
        state["phase"] = "saved"

    while True:
        draw()
        ch = scr.getch()
        if ch == -1:
            time.sleep(0.05)
            continue
        key = chr(ch) if 32 <= ch < 127 else ""
        if key == "q":
            return 0
        if state["phase"] in ("ready", "saved") and (key == " " or key == "r"):
            record()
        elif state["phase"] == "review":
            if key == "e":
                edit()
            elif key == "r":
                record()
            elif key == "s":
                do_save()
        elif state["phase"] == "diff":
            if key == "e":
                edit()
            elif key == "r":
                record()
            elif key == "s":
                do_save()


def main() -> int:
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    verb, rest = a[0], a[1:]
    try:
        if verb == "record":
            secs = 0.0
            if "--secs" in rest:
                i = rest.index("--secs")
                secs = float(rest[i + 1])
                rest = rest[:i] + rest[i + 2:]
            return cmd_record(" ".join(rest), secs)
        if verb == "test":       return cmd_test(" ".join(rest))
        if verb == "list":       return cmd_list()
        if verb == "play":       return cmd_play(int(rest[0]))
        if verb == "transcribe": return cmd_transcribe(int(rest[0]) if rest else None)
        if verb == "truth":      return cmd_truth(int(rest[0]), " ".join(rest[1:]))
        if verb == "rm":         return cmd_rm(int(rest[0]))
    except (IndexError, ValueError):
        print(f"nhq-voice: bad arguments for `{verb}`", file=sys.stderr)
        return 2
    print(f"nhq-voice: unknown verb `{verb}`", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
