#!/usr/bin/env bash
# nhq-omp-codex [omp-args...] — omp main seat on Codex GPT-5.x, workers on the cheap agy pool.
#
# Quality-first secondary seat. Use when Anthropic is near its 5h/weekly limit.
# Loads nhq-omp-codex-config.yml (next to this script) as a per-key overlay.
#
# Usage: nhq-omp-codex                  # interactive
#        nhq-omp-codex "fix the build"  # with a prompt
set -euo pipefail
SRC="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
DIR="$(dirname "$SRC")"
exec omp --config "$DIR/nhq-omp-codex-config.yml" "$@"
