#!/usr/bin/env bash
# nhq-heydaddy-deploy — one dispatcher, four faces (called through a symlink):
#
#   nhq-heydaddy-dev-be-deploy    dev  · heydaddy      (backend)   railway up --detach
#   nhq-heydaddy-dev-fe-deploy    dev  · heydaddy-web  (frontend)  railway redeploy --from-source
#   nhq-heydaddy-prod-be-deploy   prod · heydaddy      (backend)   migrations, then railway up --detach
#   nhq-heydaddy-prod-fe-deploy   prod · heydaddy-web  (frontend)  railway redeploy --from-source
#
# Flags:  --dry-run   print the plan, touch nothing
#         -y|--yes    skip the prod typed confirmation (heydaddy-promote passes this)
#
# Env:  HEYDADDY_DIR                 source tree to upload   (default ~/Github/Work/heydaddy)
#       NHQ_DEPLOY_TRIGGER_TIMEOUT   cap on the upload/trigger call, seconds (default 900)
#       NHQ_DEPLOY_TIMEOUT           cap on waiting for the build to finish, seconds (default 1200)
#       NHQ_DEPLOY_POLL              seconds between status polls (default 10)
#       NHQ_DEPLOY_RW_TIMEOUT        cap on each small railway query, seconds (default 90)
#       NHQ_DEPLOY_MIGRATE_TIMEOUT   cap on the prod migration step, seconds (default 600)
#       NHQ_DEPLOY_DRY=1             same as --dry-run
#
# ── heydaddy#225 — why this script is shaped like this ────────────────────────
# Symptom: `nhq-heydaddy-{prod,dev}-be-deploy` blocked forever with no output;
# `heydaddy-promote to-prod` sat ~33 min on the backend step and never reached
# frontend+verify. Root cause was NOT one bad command — it was that NOTHING in
# the chain was bounded or observable:
#   1. Every `railway` call inherited this script's stdin and had no deadline.
#      The CLI still prompts in several paths (`railway up -y` exists precisely
#      to suppress prompts), and the old code ran `railway link … >/dev/null
#      2>&1` — so a prompt was invisible AND unanswerable: a silent forever-wait.
#   2. `--detach` only skips the build-LOG stream. `railway up` still tars and
#      uploads the whole working tree first (~70 MB of tracked files here) and
#      renders no progress at all when stdout is a pipe rather than a TTY. Long
#      silent block, no deadline, no way to tell it apart from a real hang.
#   3. The prod path delegated to the repo's `scripts/deploy.sh`, which has had
#      a top-level `local dirty_count` (line 58) since 2026-07-23 — `local`
#      outside a function is a bash error, so under `set -e` that script aborts
#      in 0.04 s with exit 2 and never reaches `railway up` at all.
#   4. A `railway up --detach` that returns 0 only means the build was QUEUED.
#      Nothing polled the result, so a failed build still looked like success
#      and `heydaddy-promote` marched on to the next step.
# Fix: every railway call runs under `timeout` with stdin from /dev/null (a
# prompt now dies instantly instead of hanging), the deploy is triggered with
# `--detach` and then POLLED to a terminal state with visible progress, there is
# a hard overall deadline that fails LOUD, and any failure exits non-zero so
# heydaddy-promote stops instead of shipping half a release.
#
# ── 2026-08-01 — the false failure on a healthy prod release ─────────────────
# Symptom: `nhq-heydaddy-prod-fe-deploy` printed an empty "current deployment:"
# and then "the deploy trigger failed (exit 1) … Nothing was polled". The trigger
# had actually SUCCEEDED — deployment ffb875fa was created at that exact second
# and finished SUCCESS. The re-run the message demanded produced a duplicate
# build. Two independent defects, both of them "an error was turned into silence":
#   A. `deploy_top` piped railway's stderr to /dev/null, swallowed every parse
#      exception with `except: sys.exit(0)`, and returned "" for THREE different
#      situations — API error, empty list, unparseable JSON. The caller printed
#      that "" into "→ current deployment: " (an empty sentence) and kept going
#      with no baseline. Worse, `prev_id=""` makes `id != prev_id` true for the
#      PREVIOUS deployment, so the poll loop could have reported the old build's
#      SUCCESS as this run's.
#   B. The trigger's exit code was treated as the whole truth. It isn't: the CLI
#      fires the deploy mutation and THEN reads the reply, and every read failure
#      after that point (reqwest timeout, edge 502/HTML body, 429, OAuth-refresh
#      blip) surfaces as a non-zero exit for a deploy that is already running.
# Fix: deploy_top now reports WHY it failed instead of returning ""; an
# unreadable baseline is an explicit, named condition that switches new-deploy
# detection from "id changed" to "created after we pressed the button"; and a
# non-zero trigger is re-checked against the deployment list before it is called
# a failure — if a new deployment exists it is polled and the trigger is reported
# as noisy. #225's timeout/kill/stdin-closed hang protection is unchanged.
#
# Made by Director for Yash — 2026-06-30; #225 detach+poll+timeout rewrite 2026-07-28;
# false-failure / empty-baseline fix 2026-08-01.
set -uo pipefail

PROJECT_ID="0a52cb6e-d0da-49d2-b608-ea1fa6b4c68f"   # heydaddy
HEYDADDY_DIR="${HEYDADDY_DIR:-$HOME/Github/Work/heydaddy}"

TRIGGER_TIMEOUT="${NHQ_DEPLOY_TRIGGER_TIMEOUT:-900}"
TOTAL_TIMEOUT="${NHQ_DEPLOY_TIMEOUT:-1200}"
POLL_INTERVAL="${NHQ_DEPLOY_POLL:-10}"
RW_TIMEOUT="${NHQ_DEPLOY_RW_TIMEOUT:-90}"
MIGRATE_TIMEOUT="${NHQ_DEPLOY_MIGRATE_TIMEOUT:-600}"
HEALTH_TRIES="${NHQ_DEPLOY_HEALTH_TRIES:-8}"
# How many times to re-ask the API "did a deployment actually appear?" after a
# non-zero trigger, before believing the trigger's exit code (see the trigger
# section — a noisy trigger on a healthy deploy is how you get a duplicate build).
TRIGGER_RECHECK_TRIES="${NHQ_DEPLOY_TRIGGER_RECHECK:-3}"

# ── Resolve env + tier from the invoked name ─────────────────────────────────
self="$(basename "$0")"
case "$self" in
  *-dev-be-*)  RW_ENV="dev";        SERVICE="heydaddy";     TIER="be"; LABEL="DEV · backend (heydaddy)" ;;
  *-dev-fe-*)  RW_ENV="dev";        SERVICE="heydaddy-web"; TIER="fe"; LABEL="DEV · frontend (heydaddy-web)" ;;
  *-prod-be-*) RW_ENV="production"; SERVICE="heydaddy";     TIER="be"; LABEL="PROD · backend (heydaddy)" ;;
  *-prod-fe-*) RW_ENV="production"; SERVICE="heydaddy-web"; TIER="fe"; LABEL="PROD · frontend (heydaddy-web)" ;;
  *)
    echo "nhq-heydaddy-deploy: call me through one of the symlinks:" >&2
    echo "  nhq-heydaddy-{dev,prod}-{be,fe}-deploy [--dry-run] [-y]" >&2
    exit 2 ;;
esac

is_prod=0; [[ "$RW_ENV" == "production" ]] && is_prod=1

case "$RW_ENV/$TIER" in
  dev/be)         HEALTH_URL="https://heydaddy-dev.up.railway.app/health";     HEALTH_WANT=200 ;;
  dev/fe)         HEALTH_URL="https://heydaddy-web-dev.up.railway.app/";       HEALTH_WANT=200 ;;
  production/be)  HEALTH_URL="https://api.heydaddy.app/health";                HEALTH_WANT=200 ;;
  production/fe)  HEALTH_URL="https://www.heydaddy.app/";                      HEALTH_WANT=200 ;;
esac

# ── Flags ─────────────────────────────────────────────────────────────────────
dry_run=0; [[ "${NHQ_DEPLOY_DRY:-0}" == "1" ]] && dry_run=1
assume_yes=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    -y|--yes)  assume_yes=1 ;;
    *) echo "unknown flag: $arg" >&2; exit 2 ;;
  esac
done

# ── Output helpers ────────────────────────────────────────────────────────────
rule() { echo "──────────────────────────────────────────────────────────"; }
loud() {  # loud <headline> [detail…] — a failure you cannot miss in a scrollback
  echo "" >&2
  echo "══════════════════════════════════════════════════════════" >&2
  echo "✗ $1" >&2
  shift
  local line; for line in "$@"; do echo "  $line" >&2; done
  echo "══════════════════════════════════════════════════════════" >&2
}
hhmmss() { printf '%02d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }

# Every railway call: hard deadline + stdin closed, so an interactive prompt
# EOFs out immediately instead of blocking this script forever (#225).
rw() { local t="$1"; shift; timeout --kill-after=10 "$t" railway "$@" </dev/null; }

# Collapse anything multi-line into one short, printable line.
oneline() { printf '%s' "${1-}" | tr '\n\t' '  ' | tr -s ' ' | cut -c1-200; }

# ── Deployment-list reader ────────────────────────────────────────────────────
# Answers "what is the newest deployment for this service?" and has THREE
# possible outcomes. Collapsing them into one empty string is half of what broke
# the 2026-08-01 prod release:
#   return 0 → DEPLOY_TOP_LINE = "<id> <STATUS> <createdAt-epoch>"
#   return 1 → DEPLOY_TOP_ERR  = why the list could not be READ
#   return 1 → DEPLOY_TOP_ERR  = the list was read fine and is EMPTY
# The old version routed railway's stderr to /dev/null, swallowed every parse
# exception with `except: sys.exit(0)`, and printed "" for all three. The caller
# interpolated that "" straight into "→ current deployment: " — an empty
# sentence — and then carried on with no baseline at all, which in turn let the
# poll loop mistake the PREVIOUS deployment for the new one.
DEPLOY_TOP_LINE=""
DEPLOY_TOP_ERR=""
RW_ERRFILE="$(mktemp -t nhq-heydaddy-deploy.XXXXXX)"
trap 'rm -f "$RW_ERRFILE"' EXIT

deploy_top() {
  DEPLOY_TOP_LINE=""; DEPLOY_TOP_ERR=""
  local raw rc parsed
  raw="$(rw "$RW_TIMEOUT" deployment list \
          --project "$PROJECT_ID" --environment "$RW_ENV" --service "$SERVICE" \
          --limit 5 --json 2>"$RW_ERRFILE")"
  rc=$?
  if (( rc == 124 || rc == 137 )); then
    DEPLOY_TOP_ERR="'railway deployment list' did not answer within ${RW_TIMEOUT}s"
    return 1
  fi
  if (( rc != 0 )); then
    DEPLOY_TOP_ERR="'railway deployment list' exited $rc — $(oneline "$(cat "$RW_ERRFILE" 2>/dev/null)")"
    return 1
  fi
  parsed="$(printf '%s' "$raw" | python3 -c '
import calendar, json, sys, time
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception as e:
    print("ERR railway returned unparseable JSON (%s); first 120 chars: %r"
          % (e.__class__.__name__, raw[:120]))
    raise SystemExit(0)
if not isinstance(d, list):
    print("ERR expected a JSON list of deployments, got %s" % type(d).__name__)
    raise SystemExit(0)
if not d:
    print("ERR the deployment list is empty — this service has never deployed")
    raise SystemExit(0)
top = d[0]
if not isinstance(top, dict) or not top.get("id"):
    keys = sorted(top)[:8] if isinstance(top, dict) else type(top).__name__
    print("ERR newest entry carries no id field (saw: %s)" % (keys,))
    raise SystemExit(0)
try:
    epoch = calendar.timegm(time.strptime((top.get("createdAt") or "")[:19],
                                          "%Y-%m-%dT%H:%M:%S"))
except Exception:
    epoch = 0
print("OK", top["id"], top.get("status") or "UNKNOWN", epoch)
' 2>&1)"
  if [[ "$parsed" == OK\ * ]]; then
    DEPLOY_TOP_LINE="${parsed#OK }"
    return 0
  fi
  DEPLOY_TOP_ERR="$(oneline "${parsed#ERR }")"
  [[ -n "$DEPLOY_TOP_ERR" ]] || DEPLOY_TOP_ERR="could not parse the deployment list"
  return 1
}

# Is "<id> <createdAt-epoch>" a deployment that THIS run caused?
# With a baseline, "the id changed" is exact and immune to clock skew. Without
# one it falls back to "created at or after the moment we pressed the button",
# allowing 120s of skew between this box and Railway. The fallback is load-
# bearing: when prev_id is empty, `id != prev_id` is TRUE for the previous
# deployment too, so the poll loop would latch onto the old SUCCESS and declare
# victory without ever waiting for the build it just started.
is_new_deployment() {
  local id="$1" created="${2:-0}"
  [[ -n "$id" ]] || return 1
  if [[ -n "$prev_id" ]]; then
    [[ "$id" != "$prev_id" ]]
  else
    (( created >= trigger_started_epoch - 120 ))
  fi
}

rule
echo "  HeyDaddy deploy → $LABEL"
echo "  source:   $HEYDADDY_DIR"
echo "  method:   $( [[ $TIER == be ]] && echo 'railway up --detach (tarball)' || echo 'railway redeploy --from-source' ) + status polling"
echo "  deadline: trigger ${TRIGGER_TIMEOUT}s · build ${TOTAL_TIMEOUT}s — hard-fails, never hangs"
rule

# ── Dry run ───────────────────────────────────────────────────────────────────
if [[ "$dry_run" == 1 ]]; then
  echo "DRY RUN — would run, and change nothing:"
  n=0; step() { n=$(( n + 1 )); echo "  $n. $1"; }
  if [[ "$TIER" == "be" && "$is_prod" == 1 ]]; then
    step "read prod DATABASE_URL   (railway variables --service $SERVICE --environment $RW_ENV --kv)"
    step "python -m backend.migrate upgrade   — ABORT the whole deploy if it fails"
  fi
  if [[ "$TIER" == "be" ]]; then
    step "stamp release commit → railway variable set RAILWAY_GIT_COMMIT_SHA=<HEAD> RAILWAY_GIT_BRANCH=<branch> --skip-deploys (no extra deploy; #279)"
  fi
  if [[ "$TIER" == "be" ]]; then
    step "cd $HEYDADDY_DIR && railway up --project $PROJECT_ID --environment $RW_ENV --service $SERVICE --detach"
  else
    step "railway redeploy --from-source --project $PROJECT_ID --environment $RW_ENV --service $SERVICE --yes"
  fi
  step "poll 'railway deployment list' every ${POLL_INTERVAL}s until the NEW deployment is SUCCESS"
  echo "     (FAILED/CRASHED → exit 1 · nothing terminal within ${TOTAL_TIMEOUT}s → exit 1, loudly)"
  echo "     a non-zero trigger is re-checked ${TRIGGER_RECHECK_TRIES}× against the deployment list"
  echo "     first — if a new deployment appeared it is polled, not aborted"
  step "curl $HEALTH_URL — expect $HEALTH_WANT"

  # Read-only probe. This is the ONLY thing the dry run touches on the network:
  # a `deployment list` GET. It exercises the exact parser the real run uses, so
  # a dry run now proves the baseline parses instead of asserting it does.
  echo ""
  echo "Baseline probe (read-only — lists deployments, triggers nothing):"
  probe_now="$(date -u +%s)"
  if deploy_top; then
    read -r p_id p_st p_ts _ <<<"$DEPLOY_TOP_LINE"
    if (( p_ts > 0 )); then
      p_when="$(date -u -d "@$p_ts" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo "epoch $p_ts")"
      p_age=" ($(hhmmss $(( probe_now - p_ts ))) ago)"
    else
      p_when="unknown"; p_age=""
    fi
    echo "  ✓ parsed  id=$p_id  status=$p_st  created=$p_when$p_age"
    echo "  the real run would print → \"→ current deployment: ${p_id:0:8} ($p_st)\""
    echo "  and would recognise its own build by \"id changed from ${p_id:0:8}\"."
  else
    echo "  ⚠ NO BASELINE — $DEPLOY_TOP_ERR"
    echo "  the real run would print → \"→ current deployment: ⚠ UNKNOWN …\" with that"
    echo "  reason, keep going, and recognise its own build by creation time instead."
  fi
  exit 0
fi

# ── Prod gate — typed confirmation (Protocol-3 posture; prod is never silent) ─
if [[ "$is_prod" == 1 && "$assume_yes" == 0 ]]; then
  echo "⚠️  PRODUCTION deploy. This ships to LIVE users."
  [[ "$TIER" == "be" ]] && echo "    (uploads your CURRENT working tree in $HEYDADDY_DIR — commit/checkout first)"
  read -r -p "  Type DEPLOY PROD to continue: " confirm
  if [[ "$confirm" != "DEPLOY PROD" ]]; then
    echo "  aborted — not confirmed."
    exit 1
  fi
fi

if [[ "$TIER" == "be" && ! -d "$HEYDADDY_DIR" ]]; then
  loud "HEYDADDY_DIR is not a directory: $HEYDADDY_DIR" "Set HEYDADDY_DIR to your heydaddy checkout."
  exit 1
fi

# ── Prod backend: migrations BEFORE code, or nothing ships ───────────────────
if [[ "$is_prod" == 1 && "$TIER" == "be" ]]; then
  echo "→ applying pending prod migrations (code is not shipped if this fails)…"
  prod_db="$(rw "$RW_TIMEOUT" variables --service "$SERVICE" --environment "$RW_ENV" --kv 2>/dev/null \
             | grep '^DATABASE_URL=' | head -1 | sed 's/^DATABASE_URL=//')"
  if [[ -z "$prod_db" ]]; then
    loud "REFUSING to deploy: could not read the prod DATABASE_URL." \
         "Without it the migration state cannot be confirmed, and shipping code" \
         "ahead of its migrations means 500s on live users."
    exit 1
  fi
  py="$HEYDADDY_DIR/.venv/bin/python"; [[ -x "$py" ]] || py="python3"
  ( cd "$HEYDADDY_DIR" && DATABASE_URL="$prod_db" \
      timeout --kill-after=10 "$MIGRATE_TIMEOUT" "$py" -m backend.migrate upgrade </dev/null )
  rc=$?
  unset prod_db
  if (( rc == 124 || rc == 137 )); then
    loud "prod migrations did NOT finish within ${MIGRATE_TIMEOUT}s — aborted." \
         "Code was NOT shipped. Run the upgrade by hand and re-deploy."
    exit 1
  elif (( rc != 0 )); then
    loud "prod migration apply FAILED (exit $rc) — aborted." "Code was NOT shipped, so no missing-migration 500s."
    exit 1
  fi
  echo "  ✓ prod migrations up to date"
fi

# ── Stamp the release commit (#279) ──────────────────────────────────────────
# /health, /version, the admin health card and the Sentry release all read
# RAILWAY_GIT_COMMIT_SHA / RAILWAY_GIT_BRANCH (backend/main.py, routers/_version.py,
# routers/admin.py, observability.py) and fall back to "unknown". A `railway up`
# tarball deploy injects NO git metadata, and `railway up` has NO --build-arg, so
# the only way a real SHA reaches those handlers is a service variable set here,
# just before the upload. --skip-deploys is REQUIRED: a plain `variable set`
# triggers its own redeploy, which would race the `railway up` below — this keeps
# it at exactly one deploy. Best-effort: a failed stamp degrades to "unknown", it
# never blocks a release. FE tiers redeploy from a GitHub-connected source where
# Railway injects these itself, so this is backend-only.
if [[ "$TIER" == "be" ]]; then
  stamp_sha="$(cd "$HEYDADDY_DIR" 2>/dev/null && git rev-parse HEAD 2>/dev/null)"
  stamp_branch="$(cd "$HEYDADDY_DIR" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [[ -n "$stamp_sha" ]]; then
    echo "→ stamping release commit ${stamp_sha:0:8} (branch ${stamp_branch:-unknown}) as a runtime var — no extra deploy…"
    rw "$RW_TIMEOUT" variable set "RAILWAY_GIT_COMMIT_SHA=$stamp_sha" \
       --project "$PROJECT_ID" --service "$SERVICE" --environment "$RW_ENV" --skip-deploys \
       >/dev/null 2>&1 \
      || echo "   ⚠ could not set RAILWAY_GIT_COMMIT_SHA — /health may report 'unknown' (deploy continues)" >&2
    if [[ -n "$stamp_branch" && "$stamp_branch" != "HEAD" ]]; then
      rw "$RW_TIMEOUT" variable set "RAILWAY_GIT_BRANCH=$stamp_branch" \
         --project "$PROJECT_ID" --service "$SERVICE" --environment "$RW_ENV" --skip-deploys \
         >/dev/null 2>&1 \
        || echo "   ⚠ could not set RAILWAY_GIT_BRANCH (deploy continues)" >&2
    fi
  else
    echo "   ⚠ $HEYDADDY_DIR is not a git checkout — skipping commit stamp; /health may report 'unknown'" >&2
  fi
fi

# ── Trigger ───────────────────────────────────────────────────────────────────
prev_id=""; prev_status=""
if deploy_top; then
  read -r prev_id prev_status _ <<<"$DEPLOY_TOP_LINE"
  echo "→ current deployment: ${prev_id:0:8} ($prev_status)"
else
  # An unreadable baseline used to print as an empty sentence and then silently
  # weaken every later check. It is now a named condition with its reason.
  echo "→ current deployment: ⚠ UNKNOWN — could not read the deployment list."
  echo "   reason: $DEPLOY_TOP_ERR"
  echo "   Continuing WITHOUT a baseline. This run will recognise its own build by"
  echo "   creation time rather than by 'the id changed', and will NOT mistake the"
  echo "   deployment already on top for the one it is about to start."
fi
trigger_started_epoch="$(date -u +%s)"

if [[ "$TIER" == "be" ]]; then
  echo "→ uploading working tree + triggering the build (railway up --detach)…"
  echo "   this uploads a tarball and prints nothing while it does; capped at ${TRIGGER_TIMEOUT}s."
  ( cd "$HEYDADDY_DIR" && rw "$TRIGGER_TIMEOUT" up \
      --project "$PROJECT_ID" --environment "$RW_ENV" --service "$SERVICE" --detach )
  rc=$?
else
  echo "→ triggering redeploy from the connected GitHub source…"
  rw "$TRIGGER_TIMEOUT" redeploy --from-source \
      --project "$PROJECT_ID" --environment "$RW_ENV" --service "$SERVICE" --yes
  rc=$?
fi

# ── A non-zero trigger is not proof that nothing shipped ─────────────────────
# `railway redeploy --from-source` fires the serviceInstanceDeploy(latestCommit:
# true) mutation and then READS the reply. Every read failure AFTER that point —
# the reqwest client-level timeout, a 502/HTML body from the edge, a 429, an
# OAuth-refresh blip, a response the client cannot deserialize — propagates
# through `?` and exits non-zero for a deploy the server has ALREADY started
# (railwayapp/cli src/client.rs: `.send().await?` then `response.json().await?`,
# both downstream of the mutation). `railway up --detach` has the same shape.
# Observed on prod 2026-08-01: trigger reported exit 1, deployment ffb875fa was
# created at that exact second and finished SUCCESS, and the "re-run" this error
# used to demand produced a duplicate build. A false failure on a healthy prod
# release is how someone rolls back something that was fine — so ask the API
# before believing the exit code.
noisy_trigger=0
if (( rc != 0 )); then
  if (( rc == 124 || rc == 137 )); then
    echo "⚠  the deploy trigger did not return within ${TRIGGER_TIMEOUT}s — killed it (#225 hang guard)." >&2
  else
    echo "⚠  the deploy trigger exited $rc." >&2
  fi
  echo "   Checking whether a deployment appeared anyway before calling this a failure…" >&2
  adopted_id=""; adopted_status=""
  for (( try = 1; try <= TRIGGER_RECHECK_TRIES; try++ )); do
    if deploy_top; then
      read -r chk_id chk_status chk_ts _ <<<"$DEPLOY_TOP_LINE"
      if is_new_deployment "$chk_id" "$chk_ts"; then
        adopted_id="$chk_id"; adopted_status="$chk_status"; break
      fi
      printf '   [recheck %d/%d] no new deployment — top is still %s (%s)\n' \
        "$try" "$TRIGGER_RECHECK_TRIES" "${chk_id:0:8}" "$chk_status" >&2
    else
      printf '   [recheck %d/%d] could not read the list — %s\n' \
        "$try" "$TRIGGER_RECHECK_TRIES" "$DEPLOY_TOP_ERR" >&2
    fi
    (( try < TRIGGER_RECHECK_TRIES )) && sleep "$POLL_INTERVAL"
  done

  if [[ -n "$adopted_id" ]]; then
    noisy_trigger=1
    echo "   ✓ a new deployment DID appear: ${adopted_id:0:8} ($adopted_status)." >&2
    echo "   → the trigger was NOISY, not failed. Polling that build instead of aborting." >&2
    echo "   → do NOT re-run this deploy — that is what produces a duplicate build." >&2
  elif (( rc == 124 || rc == 137 )); then
    loud "the deploy trigger did not return within ${TRIGGER_TIMEOUT}s for $LABEL — killed it." \
         "This is the #225 hang, caught instead of waited on." \
         "Re-checked the deployment list ${TRIGGER_RECHECK_TRIES}× afterwards and NO new deployment" \
         "appeared, so nothing shipped and re-running will not duplicate a build:" \
         "  railway deployment list --project $PROJECT_ID --environment $RW_ENV --service $SERVICE"
    exit 1
  else
    loud "the deploy trigger failed (exit $rc) for $LABEL, and nothing shipped." \
         "Re-checked the deployment list ${TRIGGER_RECHECK_TRIES}× afterwards and NO new deployment" \
         "appeared, so fixing the error above and re-running is safe:" \
         "  railway deployment list --project $PROJECT_ID --environment $RW_ENV --service $SERVICE"
    exit 1
  fi
fi

# ── Poll to a terminal state, with a hard deadline ───────────────────────────
echo "→ waiting for the new deployment to finish (poll ${POLL_INTERVAL}s, deadline ${TOTAL_TIMEOUT}s)…"
started=$SECONDS
new_id=""; new_status=""; outcome="timeout"
while (( SECONDS - started < TOTAL_TIMEOUT )); do
  elapsed=$(( SECONDS - started ))
  if deploy_top; then
    read -r id st ts _ <<<"$DEPLOY_TOP_LINE"
    if is_new_deployment "$id" "$ts"; then
      printf '    [+%s] %s  %s\n' "$(hhmmss "$elapsed")" "${id:0:8}" "${st:-?}"
      case "$st" in
        SUCCESS)                  new_id="$id"; new_status="$st"; outcome="success"; break ;;
        FAILED|CRASHED|REMOVED)   new_id="$id"; new_status="$st"; outcome="failed";  break ;;
      esac
    else
      printf '    [+%s] waiting for the new deployment to appear (top is still %s)…\n' \
        "$(hhmmss "$elapsed")" "${id:0:8}"
    fi
  else
    # Don't render a transient API blip as "waiting…" — that reads like progress.
    printf '    [+%s] deployment list unreadable — %s\n' "$(hhmmss "$elapsed")" "$DEPLOY_TOP_ERR"
  fi
  sleep "$POLL_INTERVAL"
done

if [[ "$outcome" == "failed" ]]; then
  loud "deploy $new_status for $LABEL (deployment ${new_id:0:8})." \
       "logs: railway logs --project $PROJECT_ID --environment $RW_ENV --service $SERVICE"
  exit 1
fi

if [[ "$outcome" == "timeout" ]]; then
  loud "TIMED OUT after ${TOTAL_TIMEOUT}s waiting for $LABEL to finish building." \
       "This is a hard failure, NOT a hang — the build may still be running." \
       "Check it, then re-run or roll back:" \
       "  railway deployment list --project $PROJECT_ID --environment $RW_ENV --service $SERVICE" \
       "  railway logs        --project $PROJECT_ID --environment $RW_ENV --service $SERVICE" \
       "Raise the ceiling with NHQ_DEPLOY_TIMEOUT=<seconds> if builds are legitimately slower."
  exit 1
fi

echo "  ✓ build SUCCESS (${new_id:0:8})"

# ── Health check ──────────────────────────────────────────────────────────────
echo "→ health-checking $HEALTH_URL (expect $HEALTH_WANT)…"
code="ERR"
for (( i = 1; i <= HEALTH_TRIES; i++ )); do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$HEALTH_URL" </dev/null || echo ERR)"
  printf '    attempt %d/%d → %s\n' "$i" "$HEALTH_TRIES" "$code"
  [[ "$code" == "$HEALTH_WANT" ]] && break
  (( i < HEALTH_TRIES )) && sleep 6
done

if [[ "$code" != "$HEALTH_WANT" ]]; then
  loud "$LABEL deployed (${new_id:0:8}) but $HEALTH_URL returned $code, not $HEALTH_WANT." \
       "Railway health-gates traffic, so the previous healthy build should still be serving." \
       "  railway logs --project $PROJECT_ID --environment $RW_ENV --service $SERVICE"
  exit 1
fi

rule
echo "✅ $LABEL live + healthy (${new_id:0:8})"
(( noisy_trigger == 1 )) && \
  echo "   note: the trigger command exited non-zero but the deploy was real — see above."
rule
exit 0
