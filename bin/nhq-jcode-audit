#!/usr/bin/env bash
# nhq-jcode-audit — jcode post_tool observer → NHQ hash-chained audit feed.
#
# The jcode analogue of omp's hooks/post/audit.ts: appends one chained,
# agent-stamped line per MUTATING tool call to the audit.jsonl that governance
# already trusts, by delegating to the single source of truth
#   ~/.local/bin/nhq-audit append …
# (secret-scrub, chain hash, locking all live there — no format duplication).
#
# jcode post_tool is an OBSERVER hook: detached, fire-and-forget, cannot block.
# Env: JCODE_HOOK_TOOL_NAME, JCODE_HOOK_TOOL_INPUT (≤16KB), JCODE_HOOK_SESSION_ID,
#      JCODE_HOOK_CWD, JCODE_HOOK_PAYLOAD.
#
# Wiring: ~/.jcode/config.toml → [hooks] post_tool = "~/.local/bin/nhq-jcode-audit"
set -uo pipefail

TOOL="${JCODE_HOOK_TOOL_NAME:-}"
[[ -z "$TOOL" ]] && exit 0

# Only mutating surfaces are audited (mirror of audit.ts): bash commands,
# file edits/writes/patches, and mutating MCP calls.
case "${TOOL,,}" in
  bash) KIND=cmd ;;
  edit|write|multiedit|apply_patch|patch) KIND=file ;;
  mcp*) KIND=mcp ;;
  *) exit 0 ;;
esac

AUDIT="$HOME/.local/bin/nhq-audit"
[[ -x "$AUDIT" ]] || AUDIT="$HOME/Github/dots/bin/nhq-audit"
[[ -x "$AUDIT" ]] || exit 0

AGENT="${NHQ_AGENT:-jcode}"
SESSION="${JCODE_HOOK_SESSION_ID:-}"
INPUT="${JCODE_HOOK_TOOL_INPUT:-}"

case "$KIND" in
  cmd)
    CMD="$(printf '%s' "$INPUT" | jq -r '.command // empty' 2>/dev/null | head -c 500)"
    [[ -z "$CMD" ]] && exit 0
    "$AUDIT" append --tool jcode-bash --agent "$AGENT" --session "$SESSION" \
      --bucket tool:bash --cmd "$CMD" >/dev/null 2>&1 || true
    ;;
  file)
    FILE="$(printf '%s' "$INPUT" | jq -r '.file_path // .path // empty' 2>/dev/null)"
    [[ -z "$FILE" ]] && exit 0
    "$AUDIT" append --tool "jcode-$TOOL" --agent "$AGENT" --session "$SESSION" \
      --bucket tool:file --file "$FILE" >/dev/null 2>&1 || true
    ;;
  mcp)
    # Only mutating MCP names (reads are noise).
    case "$TOOL" in
      *list_*|*get_*|*_status|*_metrics|*search_*|*docs_*) exit 0 ;;
    esac
    "$AUDIT" append --tool "jcode-mcp" --agent "$AGENT" --session "$SESSION" \
      --bucket tool:mcp --cmd "$TOOL" >/dev/null 2>&1 || true
    ;;
esac
exit 0
