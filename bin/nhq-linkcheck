#!/usr/bin/env python3
"""nhq-linkcheck — verify links (200 + not homepage), images, and intra-doc anchors."""
import sys, re, urllib.request, urllib.parse, urllib.error
from concurrent.futures import ThreadPoolExecutor

# Hosts where the bare root IS the content (project/landing pages), not a nav homepage.
PROJECT_HOSTS = (".github.io", ".gitlab.io", ".pages.dev", ".netlify.app", ".vercel.app", ".readthedocs.io")

def is_homepage(url):
    p = urllib.parse.urlparse(url)
    host = p.netloc.lower()
    depth = len([x for x in p.path.split("/") if x])
    if depth == 0 and not p.query:
        if any(host.endswith(s) for s in PROJECT_HOSTS): return False, ""  # project page = real content
        return True, "bare homepage"
    return False, ""

# Definitively-dead codes: drop. Everything else (incl. 403/405/429/5xx bot-blocks
# + throttling) means the URL is LIVE but unverifiable — keep it, don't gut sections.
DEAD = {0, 404, 410}

def _head(url):
    for method in ("HEAD", "GET"):
        try:
            kw = {"method": "HEAD"} if method == "HEAD" else {}
            req = urllib.request.Request(url, headers={"User-Agent": "nhq-linkcheck/1.0"}, **kw)
            r = urllib.request.urlopen(req, timeout=15)
            return r.status, r.headers.get("Content-Type", "")
        except urllib.error.HTTPError as e:
            if method == "HEAD":  # some servers reject HEAD — retry as GET
                continue
            return e.code, (e.headers.get("Content-Type", "") if e.headers else "")
        except Exception:
            if method == "HEAD":
                continue
            return 0, ""
    return 0, ""

def check_url(url):
    hp, why = is_homepage(url)
    if hp: return False, why
    st, _ = _head(url)
    if st in DEAD: return False, f"dead {st}"
    return True, (f"ok {st}" if 200 <= st < 400 else f"unverified {st}")

def check_image(url):
    st, ct = _head(url)
    if st in DEAD: return False
    if 200 <= st < 400: return ct.startswith("image/")  # reachable → must be an image
    return True  # blocked/throttled (403/429/5xx) — live but unverifiable, keep

def _slug(h): return "#" + re.sub(r"[^a-z0-9]+","-", h.strip().lower()).strip("-")

def check_anchors(md):
    headings = {_slug(m.group(1)) for m in re.finditer(r"^#{1,6} (.+)$", md, re.M)}
    refs = re.findall(r"\]\((#[^)]+)\)", md)
    return [r for r in refs if r not in headings]

def format_issues(md):
    """Catch RENDERING defects link-checking can't see: raw HTML/entities leaking
    into body text, and block elements (image / source line) not blank-separated —
    which Obsidian collapses into a run-on paragraph. 'Links resolve' != 'looks good'."""
    issues = []
    lines = md.split("\n")
    for i, l in enumerate(lines):
        s = l.strip()
        if re.search(r"</?(p|img|a|br|em|strong|div|span|h[1-6])\b", l):
            issues.append(f"raw HTML @{i+1}: {s[:50]}")
        if re.search(r"&#x?[0-9a-fA-F]+;|&(amp|lt|gt|quot);", l):
            issues.append(f"entity @{i+1}: {s[:50]}")
        if (s.startswith("![") or s.startswith("↗ ")) and i > 0 and lines[i-1].strip() != "":
            issues.append(f"block not blank-separated @{i+1}: {s[:40]}")
        # item headline (**Title** [· ⭐ x]) must be followed by a real summary,
        # not jump straight to the image/source → that's a headline-only empty item.
        if re.match(r"^\*\*.+\*\*( · ⭐ .+)?$", s):
            nxt = next((lines[j].strip() for j in range(i+1, len(lines)) if lines[j].strip() != ""), "")
            if nxt.startswith("![") or nxt.startswith("↗ "):
                issues.append(f"no summary (headline-only) @{i+1}: {s[:50]}")
            elif nxt and not nxt.startswith(("#", "**", ">", "-", "|")) and len(nxt) < 40:
                issues.append(f"summary too thin @{i+1}: {nxt[:50]}")
    return issues

def audit(md):
    links = re.findall(r"(?<!!)\[[^\]]+\]\((https?://[^)]+)\)", md)
    imgs  = re.findall(r"!\[[^\]]*\]\((https?://[^)]+)\)", md) + re.findall(r'<img[^>]+src="(https?://[^"]+)"', md)
    with ThreadPoolExecutor(max_workers=16) as ex:
        bl = [u for u,(ok,_) in zip(links, ex.map(check_url, links)) if not ok]
        bi = [u for u,ok in zip(imgs, ex.map(check_image, imgs)) if not ok]
    return {"broken_links": bl, "broken_images": bi, "broken_anchors": check_anchors(md), "format_issues": format_issues(md)}

def main():
    md = open(sys.argv[1]).read(); res = audit(md)
    bad = sum(len(v) for v in res.values())
    import json; print(json.dumps(res, indent=2))
    sys.exit(1 if bad else 0)

if __name__ == "__main__":
    main()
