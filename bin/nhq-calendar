#!/usr/bin/env python3
"""nhq-calendar — Director's planning calendar.

A dated/timed task store the Director keeps so work that isn't for *today* gets
parked on a real date instead of lost. The overnight run can ask `due` for
tonight's items.

Store  : ~/.nhq/calendar.jsonl   (source of truth, one JSON per line)
View   : ~/Obsidian/nHQ/Calendar.md   (regenerated; Yash reads it in Obsidian)

Usage:
  nhq-calendar add "<title>" [--date YYYY-MM-DD|today|tomorrow|tonight] [--time HH:MM]
                             [--note "..."] [--tag x] [--tag y]
  nhq-calendar list                      # all pending, soonest first
  nhq-calendar due [--date YYYY-MM-DD]    # pending on/before date (default today) + undated
  nhq-calendar done <id>                  # mark completed
  nhq-calendar drop <id>                  # abandon
  nhq-calendar rm   <id>                  # delete the row
  nhq-calendar view                       # print the agenda (also written to the vault)
Dates: 'tonight' -> today (time 21:00 if none). 'overnight' kept as a tag.
Times display as `YYYY-MM-DD HH:MM IST`, the same string nhq-run and nhq-brief
print — an undated or untimed row is shown as-is, never given a made-up clock.
"""
import sys, os, json, datetime, uuid

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".nhq", "calendar.jsonl")
VIEW = os.path.join(HOME, "Obsidian", "nHQ", "Calendar.md")
os.makedirs(os.path.dirname(STORE), exist_ok=True)


# ── time ─────────────────────────────────────────────────────────────────
# DUPLICATED BYTE-IDENTICALLY in bin/nhq-run, bin/nhq-brief and bin/nhq-calendar.
# They are standalone scripts with no shared import — change one, change all three.

IST = datetime.timezone(datetime.timedelta(hours=5, minutes=30), "IST")


def _now_iso():
    """Now, ISO 8601 carrying the offset: 2026-08-10T07:39:12+05:30.

    Derived from IST explicitly rather than read off the ambient zone, so the
    value stays correct under any TZ and the offset survives into the store.
    """
    return datetime.datetime.now(IST).replace(microsecond=0).isoformat()


def _fmt_ts(ts):
    """The one display format, everywhere: '2026-08-10 07:39 IST'.

    A date-only value renders as the bare date. A clock time that was never
    recorded is never invented.
    """
    s = str(ts or "").strip()
    if not s:
        return ""
    if len(s) == 10:
        return s
    try:
        d = datetime.datetime.fromisoformat(s)
    except ValueError:
        return s
    if d.tzinfo is None:  # a naive wall-clock value is already IST
        d = d.replace(tzinfo=IST)
    return d.astimezone(IST).strftime("%Y-%m-%d %H:%M") + " IST"


def _when(r):
    """A row's date and optional --time, through the one formatter above.
    A date-only row stays date-only and an undated one stays 'someday':
    no clock time and no date is ever invented for a row that has none."""
    d, t = r.get("date"), r.get("time")
    if d and t:
        return _fmt_ts(f"{d}T{t}")
    if d:
        return _fmt_ts(d)
    return f"someday {t}" if t else "someday"



def _today():
    return datetime.datetime.now(IST).date().isoformat()


def _resolve_date(s):
    if not s:
        return None
    s = s.strip().lower()
    t = datetime.date.fromisoformat(_today())
    if s in ("today", "tonight"):
        return t.isoformat()
    if s == "tomorrow":
        return (t + datetime.timedelta(days=1)).isoformat()
    datetime.date.fromisoformat(s)  # validate YYYY-MM-DD (raises on bad input)
    return s


def _load():
    if not os.path.exists(STORE):
        return []
    out = []
    for line in open(STORE):
        line = line.strip()
        if line:
            out.append(json.loads(line))
    return out


def _save(rows):
    with open(STORE, "w") as f:
        for r in rows:
            f.write(json.dumps(r) + "\n")
    _write_view(rows)


def _key(r):
    # undated sort last; then by date, then time
    return (r.get("date") or "9999-12-31", r.get("time") or "99:99")


def _write_view(rows):
    if not os.path.dirname(VIEW) or not os.path.isdir(os.path.dirname(VIEW)):
        return
    pend = sorted([r for r in rows if r["status"] == "pending"], key=_key)
    done = [r for r in rows if r["status"] == "done"]
    L = ["# NHQ Calendar", "", "_Director's planning calendar. Source: `~/.nhq/calendar.jsonl` · regenerated by `nhq-calendar`._", ""]
    L.append(f"**{len(pend)} pending** · updated {_fmt_ts(_now_iso())}")
    L.append("")
    if pend:
        cur = None
        for r in pend:
            d = r.get("date") or "— someday —"
            if d != cur:
                cur = d
                label = d
                if d == _today():
                    label = f"{d}  (today)"
                L.append(f"## {label}")
            t = f"`{_when(r)}` " if r.get("time") else ""
            tags = "  " + " ".join(f"#{x}" for x in r.get("tags", [])) if r.get("tags") else ""
            L.append(f"- [ ] {t}{r['title']}  · `{r['id']}`{tags}")
            if r.get("note"):
                L.append(f"    - {r['note']}")
        L.append("")
    if done:
        L.append("## Done")
        for r in sorted(done, key=_key):
            L.append(f"- [x] {r['title']}  · `{r['id']}`")
        L.append("")
    open(VIEW, "w").write("\n".join(L))


def _fmt(r):
    tags = "  " + " ".join(f"#{x}" for x in r.get("tags", [])) if r.get("tags") else ""
    note = f"  — {r['note']}" if r.get("note") else ""
    return f"[{r['id']}] {_when(r)}  {r['title']}{tags}{note}"


def _parse_opts(args):
    o = {"tags": []}
    i = 0
    pos = []
    while i < len(args):
        a = args[i]
        if a == "--date":
            o["date"] = args[i + 1]; i += 2
        elif a == "--time":
            o["time"] = args[i + 1]; i += 2
        elif a == "--note":
            o["note"] = args[i + 1]; i += 2
        elif a == "--tag":
            o["tags"].append(args[i + 1]); i += 2
        else:
            pos.append(a); i += 1
    return pos, o


def cmd_add(args):
    pos, o = _parse_opts(args)
    if not pos:
        print("usage: nhq-calendar add \"<title>\" [--date ..] [--time HH:MM] [--note ..] [--tag ..]"); sys.exit(1)
    title = pos[0]
    rows = _load()
    r = {
        "id": uuid.uuid4().hex[:6],
        "title": title,
        "date": _resolve_date(o.get("date")),
        "time": o.get("time") or (("21:00") if (o.get("date", "").lower() == "tonight") else None),
        "note": o.get("note"),
        "tags": o["tags"],
        "status": "pending",
        "created": _today(),
    }
    rows.append(r)
    _save(rows)
    print("added:", _fmt(r))


def cmd_list(_):
    rows = [r for r in _load() if r["status"] == "pending"]
    if not rows:
        print("(calendar empty)"); return
    for r in sorted(rows, key=_key):
        print(_fmt(r))


def cmd_due(args):
    _, o = _parse_opts(args)
    cutoff = _resolve_date(o.get("date")) or _today()
    rows = [r for r in _load() if r["status"] == "pending" and (r.get("date") is None or r["date"] <= cutoff)]
    if not rows:
        print(f"(nothing due on/before {cutoff})"); return
    for r in sorted(rows, key=_key):
        print(_fmt(r))


def _set_status(id_, status):
    rows = _load()
    hit = False
    for r in rows:
        if r["id"] == id_:
            r["status"] = status; hit = True
    if not hit:
        print("no such id:", id_); sys.exit(1)
    _save(rows)
    print(f"{status}:", id_)


def cmd_done(args):
    _set_status(args[0], "done")


def cmd_drop(args):
    _set_status(args[0], "dropped")


def cmd_rm(args):
    rows = _load()
    new = [r for r in rows if r["id"] != args[0]]
    if len(new) == len(rows):
        print("no such id:", args[0]); sys.exit(1)
    _save(new)
    print("removed:", args[0])


def cmd_view(_):
    rows = _load()
    _write_view(rows)
    cmd_list(_)
    print(f"\nview -> {VIEW}")


CMDS = {"add": cmd_add, "list": cmd_list, "due": cmd_due, "done": cmd_done,
        "drop": cmd_drop, "rm": cmd_rm, "view": cmd_view}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__); sys.exit(0 if len(sys.argv) < 2 else 1)
    CMDS[sys.argv[1]](sys.argv[2:])
