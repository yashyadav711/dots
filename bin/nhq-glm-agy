#!/usr/bin/env bash
# nhq-glm-agy [omp-args...] — launch omp balancing z.ai GLM + agy (Claude + Gemini).
#
# ⚠️ THE Z.AI SUBSCRIPTION IS CANCELLED (2026-08-11) — the MAIN SEAT of this hybrid is dead.
# A live round-trip on 2026-08-11 returns `[1113] Insufficient balance or no resource package`,
# so the seat cannot answer even though the agy roles still can. KEPT, not removed, because a
# FREE z.ai tier is acceptable IF one works — VERIFY THE LANE ANSWERS first:
# `bash ~/Github/nhq-agentic-os/scripts/nhq-engine-selftest.sh`.
# There is currently NO reliable zero-Anthropic CODE lane (docs/references/agy-capabilities.md).
#
# Loads nhq-glm-agy-config.yml (sits next to this script). Split:
#   GLM (stable)         → default (main seat) + vision
#   agy/Claude (quality) → plan + slow + task (subagents) + designer
#   agy/Gemini (cheap)   → advisor + smol + commit + title
#   web search           → firecrawl
# Uses BOTH plans; burns ZERO Anthropic-direct quota. All agy routes verified
# live (rotator @ localhost:51200; agy provider in ~/.omp/agent/models.yml).
#
# Volatility: agy account health varies — the main seat stays on GLM so an agy
# hiccup degrades only the specialized roles (respawnable for task), not the seat.
#
# Usage: nhq-glm-agy                  # interactive omp, GLM + agy hybrid
#        nhq-glm-agy "fix the build"  # with an initial prompt
set -euo pipefail

# Loud pre-flight: the z.ai key still AUTHENTICATES (429, not 401), so a dead seat looks
# configured and nothing fails fast on its own.
echo "⚠️  nhq-glm-agy: the z.ai/GLM main seat was cancelled 2026-08-11 — the seat will likely fail" >&2
echo "    with 'insufficient balance'. Verify first: scripts/nhq-engine-selftest.sh" >&2
SRC="$(readlink -f "${BASH_SOURCE[0]:-$0}")"   # resolve the ~/.local/bin symlink
DIR="$(dirname "$SRC")"
exec omp --config "$DIR/nhq-glm-agy-config.yml" "$@"
