#!/usr/bin/env python3
"""hd-code — print the current HeyDaddy admin TOTP code (reads ~/.heydaddy-admin-totp)."""
import hmac, hashlib, base64, struct, time, pathlib, sys
p = pathlib.Path.home() / ".heydaddy-admin-totp"
if not p.exists():
    sys.exit("missing ~/.heydaddy-admin-totp (the admin TOTP secret)")
s = p.read_text().strip()
def totp(t):
    c = int(t // 30)
    kb = base64.b32decode(s + "=" * ((8 - len(s) % 8) % 8))
    h = hmac.new(kb, struct.pack(">Q", c), hashlib.sha1).digest()
    o = h[-1] & 0xF
    return f"{(struct.unpack('>I', h[o:o+4])[0] & 0x7fffffff) % 1000000:06d}"
now = time.time()
print(f"{totp(now)}   ({30 - int(now % 30)}s left)")
