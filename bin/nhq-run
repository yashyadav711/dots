#!/usr/bin/env python3
"""nhq-run — the autonomous-run queue: what the agents do tonight.

Yash drops tasks in through the day ("this one goes in the overnight run").
When he says go, the Director reads the day's run and dispatches agents at it.

A queued task is NOT a one-liner. It carries a full, self-contained spec,
because the thing that eventually executes it is a subagent that has never
seen the conversation the task came from. A row a blank agent cannot act on
is a broken row — `show` flags those as NOT DISPATCHABLE before the run
starts, rather than during it.

`nhq-calendar` holds Yash's tasks. `nhq-run` holds the agents' tasks.

Store : ~/.nhq/runs.jsonl               (source of truth, one JSON per line)
View  : ~/Obsidian/nHQ/Autonomous Run.md  (regenerated by `show`)

Usage:
  nhq-run add "<title>" [--date YYYY-MM-DD|today|tonight|tomorrow]
                        [--spec "<text>" | --spec-file <path>]
                        [--issue N] [--repo <name>] [--tag x] [--after <id>]
  nhq-run show     [--date ..]   # the day's run, human-readable (+ writes the vault note)
  nhq-run dispatch [--date ..]   # full specs, ready to paste into subagent tasks
  nhq-run list                   # everything pending, all dates, soonest first
  nhq-run done <id>              # ran and landed
  nhq-run drop <id>              # abandoned
  nhq-run rm   <id>              # delete the row
  nhq-run move <id> --date <d>   # re-date it
The run for a date = tasks dated on/before it, plus every undated task —
undated means "goes in whichever run Yash calls".
Dates: 'tonight'/'today' -> today; 'tomorrow' -> tomorrow (same as nhq-calendar).
--after <id> records an ordering dependency. show/dispatch order by it and
group everything independent into waves that are run in parallel.
"""
import sys, os, json, shutil, signal, datetime, uuid

# `nhq-run list | head` must not traceback on the closed pipe.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".nhq", "runs.jsonl")
VIEW = os.path.join(HOME, "Obsidian", "nHQ", "Autonomous Run.md")
os.makedirs(os.path.dirname(STORE), exist_ok=True)

FAR = "9999-12-31"  # undated sorts last

# name -> (github slug, local checkout). Unknown names pass through as-is.
REPOS = {
    "heydaddy":       ("yashyadav711/heydaddy",       "~/Github/Work/heydaddy"),
    "mirror":         ("yashyadav711/mirror",         "~/Github/Work/mirror"),
    "nhq-agentic-os": ("yashyadav711/nhq-agentic-os", "~/Github/nhq-agentic-os"),
    "dots":           ("yashyadav711/dots",           "~/Github/dots"),
    "envy":           ("yashyadav711/envy",           "~/Github/nHQ/envy"),
}

DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
MONTHS = ["January", "February", "March", "April", "May", "June", "July",
          "August", "September", "October", "November", "December"]


# ── dates ────────────────────────────────────────────────────────────────

def _today():
    return datetime.date.today().isoformat()


def _resolve_date(s):
    if not s:
        return None
    s = s.strip().lower()
    t = datetime.date.today()
    if s in ("today", "tonight"):
        return t.isoformat()
    if s == "tomorrow":
        return (t + datetime.timedelta(days=1)).isoformat()
    if s in ("none", "someday", "unscheduled"):
        return None
    datetime.date.fromisoformat(s)  # validate YYYY-MM-DD (raises on bad input)
    return s


def _long_date(date):
    d = datetime.date.fromisoformat(date)
    return f"{DAYS[d.weekday()]}, {d.day} {MONTHS[d.month - 1]} {d.year}"


# ── store ────────────────────────────────────────────────────────────────

def _load():
    if not os.path.exists(STORE):
        return []
    out = []
    for line in open(STORE, encoding="utf-8"):
        line = line.strip()
        if line:
            out.append(json.loads(line))
    return out


def _save(rows):
    with open(STORE, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def _key(r):
    return (r.get("date") or FAR, r.get("created") or "", r["id"])


def _pending(rows):
    return [r for r in rows if r["status"] == "pending"]


def _slug(name):
    return REPOS.get(name, (name, None))[0] if name else None


def _checkout(name):
    p = REPOS.get(name, (None, None))[1]
    return os.path.expanduser(p) if p else None


def _issue_url(r):
    slug = _slug(r.get("repo"))
    return f"https://github.com/{slug}/issues/{r['issue']}" if (slug and r.get("issue")) else None


def _dispatchable(r):
    return bool((r.get("spec") or "").strip())


# ── the shape of the run ─────────────────────────────────────────────────

def _run_set(rows, date):
    """Tasks in the run for `date`: pending, dated on/before it, plus undated."""
    return [r for r in _pending(rows)
            if r.get("date") is None or r["date"] <= date]


def _default_date(rows):
    """The current run if today has one, else the next dated run, else today."""
    t = _today()
    dated = sorted({r["date"] for r in _pending(rows) if r.get("date")})
    if any(d <= t for d in dated):
        return t
    return dated[0] if dated else t


def _waves(run, allrows):
    """Kahn layering over --after. Each wave is independent → run in parallel.

    Returns (waves, ext) where ext[id] lists dependencies that are NOT in this
    run, each as (dep_id, state): 'done' is satisfied, anything else blocks.
    """
    ids = {r["id"] for r in run}
    known = {r["id"]: r for r in allrows}
    deps, ext = {}, {}
    for r in run:
        inside, outside = [], []
        for d in r.get("after") or []:
            (inside if d in ids else outside).append(d)
        deps[r["id"]] = inside
        ext[r["id"]] = [(d, known[d]["status"] if d in known else "unknown") for d in outside]

    order = {r["id"]: _key(r) for r in run}
    waves, placed = [], set()
    while len(placed) < len(ids):
        layer = [i for i in ids if i not in placed and all(d in placed for d in deps[i])]
        if not layer:  # --after cycle; surface the rest rather than hang
            rest = sorted((i for i in ids if i not in placed), key=lambda i: order[i])
            waves.append((rest, True))
            break
        waves.append((sorted(layer, key=lambda i: order[i]), False))
        placed |= set(layer)
    return waves, deps, ext


def _blockers(rid, deps, ext):
    """Human phrases for what this task waits on."""
    out = [f"{d}" for d in deps[rid]]
    for d, state in ext[rid]:
        if state == "done":
            out.append(f"{d} (already done)")
        elif state == "unknown":
            out.append(f"{d} (⚠️ unknown id)")
        else:
            out.append(f"{d} (⚠️ not in this run — {state})")
    return out


# ── show ─────────────────────────────────────────────────────────────────

def _width():
    return max(60, min(shutil.get_terminal_size((100, 24)).columns, 100))


def _rule(label, w):
    head = f"── {label} "
    return head + "─" * max(3, w - len(head))


def _tagstr(r):
    return " ".join(f"#{t}" for t in r.get("tags") or [])


def _one_line(r, w):
    """id · title · issue · repo · tags, clipped to the terminal."""
    bits = [f"[{r['id']}]", r["title"]]
    if r.get("issue"):
        bits.append(f"#{r['issue']}")
    if r.get("repo"):
        bits.append(f"({r['repo']})")
    tags = _tagstr(r)
    if tags:
        bits.append(tags)
    line = "  " + " ".join(bits)
    return line if len(line) <= w else line[:w - 1] + "…"


def render_show(rows, date):
    w = _width()
    run = _run_set(rows, date)
    waves, deps, ext = _waves(run, rows)
    undisp = [r for r in run if not _dispatchable(r)]
    byid = {r["id"]: r for r in run}

    L = []
    L.append(f"🌙 Autonomous Run — {_long_date(date)}")
    par = max((len(ids) for ids, _ in waves), default=0)
    head = f"{len(run)} task{'' if len(run) == 1 else 's'}"
    if len(waves) > 1:
        head += f" · {len(waves)} waves · up to {par} in parallel"
    elif run:
        head += " · all independent, run in parallel"
    if undisp:
        head += f" · ⚠️ {len(undisp)} NOT dispatchable"
    L.append(head)
    L.append("")

    if not run:
        L.append("  (nothing queued — nhq-run add \"<title>\" --spec \"...\")")
        L.append("")
        return "\n".join(L)

    for n, (ids, cyclic) in enumerate(waves, 1):
        if cyclic:
            label = f"UNRESOLVED · {len(ids)} task(s) — --after cycle, order them by hand"
        elif n == 1:
            label = f"Wave {n} · {len(ids)} task(s) · start together, nothing blocks them"
        else:
            label = f"Wave {n} · {len(ids)} task(s) · waits for wave {n - 1}"
        L.append(_rule(label, w))
        for rid in ids:
            r = byid[rid]
            L.append(_one_line(r, w))
            blocks = _blockers(rid, deps, ext)
            if blocks:
                L.append(f"      ⤷ after {', '.join(blocks)}")
            if r.get("date") is None:
                L.append("      · undated — rides along in whichever run you call")
            elif r["date"] < date:
                L.append(f"      · carried over from {r['date']}")
            if not _dispatchable(r):
                L.append("      ⚠️ NO SPEC — NOT DISPATCHABLE, an agent cannot act on this")
        L.append("")

    if undisp:
        L.append(_rule("Before you start", w))
        L.append(f"  {len(undisp)} task(s) have no spec: " + ", ".join(r["id"] for r in undisp))
        L.append("  A subagent gets nothing but the spec — write one, or drop the row:")
        L.append("    nhq-run rm <id>   then re-add with --spec / --spec-file")
        L.append("")

    L.append(_rule("Next", w))
    L.append(f"  nhq-run dispatch --date {date}   # the full specs, for the agents")
    L.append("")
    return "\n".join(L)


# ── dispatch ─────────────────────────────────────────────────────────────

def render_dispatch(rows, date):
    run = _run_set(rows, date)
    waves, deps, ext = _waves(run, rows)
    byid = {r["id"]: r for r in run}
    seq = [(n, ids, rid) for n, (ids, _) in enumerate(waves, 1) for rid in ids]

    out = []
    out.append("=" * 78)
    out.append(f"AUTONOMOUS RUN · {date} · {len(seq)} task(s) · {len(waves)} wave(s)")
    out.append("Each block below is self-contained. Paste one block per subagent.")
    out.append("Tasks in the same wave have no dependency on each other and are")
    out.append("meant to be run at the same time.")
    out.append("=" * 78)
    out.append("")

    if not seq:
        out.append("(nothing queued for this run)")
        out.append("")
        return "\n".join(out)

    for i, (wave, ids, rid) in enumerate(seq, 1):
        r = byid[rid]
        siblings = [x for x in ids if x != rid]
        out.append("=" * 78)
        out.append(f"TASK {i}/{len(seq)}  ·  id {r['id']}  ·  wave {wave}")
        out.append("=" * 78)
        out.append(f"TITLE      : {r['title']}")
        repo = r.get("repo")
        if repo:
            co = _checkout(repo)
            out.append(f"REPO       : {repo}" + (f"   (checkout: {co})" if co else ""))
        else:
            out.append("REPO       : (not specified — ask before touching any repo)")
        url = _issue_url(r)
        if r.get("issue"):
            out.append(f"ISSUE      : #{r['issue']}" + (f"   {url}" if url else ""))
            out.append(f"             read it in full first: gh issue view {r['issue']}"
                       + (f" --repo {_slug(repo)}" if _slug(repo) else "") + " --comments")
        if r.get("tags"):
            out.append(f"TAGS       : {', '.join(r['tags'])}")
        blocks = _blockers(rid, deps, ext)
        if blocks:
            out.append(f"DEPENDS ON : {', '.join(blocks)} — do NOT start until that has landed.")
        else:
            out.append("DEPENDS ON : nothing. Start immediately.")
        if siblings:
            out.append(f"PARALLEL   : running alongside {', '.join(siblings)} — "
                       "assume those files are being edited too; use your own worktree.")
        out.append("")
        out.append("SPEC")
        out.append("-" * 78)
        spec = (r.get("spec") or "").strip()
        out.append(spec if spec else
                   "*** NO SPEC ON THIS ROW — NOT DISPATCHABLE. ***\n"
                   "Do not guess the intent. Return to Director for a spec.")
        out.append("-" * 78)
        out.append("")
    return "\n".join(out)


# ── vault ────────────────────────────────────────────────────────────────

def _md_esc(s):
    return (s or "").replace("|", "\\|").replace("\n", " ").strip()


def write_view(rows, date):
    d = os.path.dirname(VIEW)
    if not os.path.isdir(d):
        return None
    run = _run_set(rows, date)
    waves, deps, ext = _waves(run, rows)
    byid = {r["id"]: r for r in run}
    undisp = [r for r in run if not _dispatchable(r)]
    par = max((len(ids) for ids, _ in waves), default=0)

    L = ["---", 'title: "Autonomous Run"', "type: pointer", f"updated: {_today()}", "---", "",
         "# Autonomous Run", "",
         "> [!tip] What this is",
         "> The next autonomous run — what the agents do when Yash says go. This file never moves and never gets renamed: open it and you are looking at the run that is coming. Kept by `nhq-run`; the store is `~/.nhq/runs.jsonl`.",
         ">",
         "> Not to be confused with [[Calendar]], which is Yash's own task list. This one is the agents' queue.",
         ""]
    L.append(f"**Run:** {_long_date(date)} · **{len(run)} task"
             f"{'' if len(run) == 1 else 's'}** · {len(waves)} wave"
             f"{'' if len(waves) == 1 else 's'} · up to {par} in parallel"
             + (f" · ⚠️ **{len(undisp)} not dispatchable**" if undisp else ""))
    L.append("")

    if not run:
        L += ["_Nothing queued._", ""]
    for n, (ids, cyclic) in enumerate(waves, 1):
        if cyclic:
            L.append(f"## ⚠️ Unresolved — `--after` cycle ({len(ids)})")
        elif n == 1:
            L.append(f"## Wave {n} — start together ({len(ids)})")
        else:
            L.append(f"## Wave {n} — after wave {n - 1} ({len(ids)})")
        L.append("")
        L.append("| | Task | Issue | Repo | Waits on |")
        L.append("|---|---|---|---|---|")
        for rid in ids:
            r = byid[rid]
            mark = "⚠️" if not _dispatchable(r) else "☐"
            url = _issue_url(r)
            iss = f"[#{r['issue']}]({url})" if url else (f"#{r['issue']}" if r.get("issue") else "—")
            tags = _tagstr(r)
            title = f"**{_md_esc(r['title'])}**" + (f" {tags}" if tags else "") + f" · `{rid}`"
            if not _dispatchable(r):
                title += " · **no spec — not dispatchable**"
            blocks = _blockers(rid, deps, ext)
            L.append(f"| {mark} | {title} | {iss} | {r.get('repo') or '—'} | "
                     f"{', '.join(f'`{b}`' for b in blocks) if blocks else '—'} |")
        L.append("")

    if undisp:
        L += ["> [!warning] Not dispatchable",
              "> " + ", ".join(f"`{r['id']}` {_md_esc(r['title'])}" for r in undisp),
              "> A subagent is given nothing but the spec. No spec, no run.", ""]

    L += ["---", "", "## The specs", "",
          "_Full text, as handed to the agents. `nhq-run dispatch` prints the same thing for the terminal._", ""]
    for n, (ids, _c) in enumerate(waves, 1):
        for rid in ids:
            r = byid[rid]
            L.append(f"### `{rid}` — {_md_esc(r['title'])}")
            L.append("")
            meta = [f"wave {n}"]
            if r.get("repo"):
                meta.append(f"repo `{r['repo']}`")
            url = _issue_url(r)
            if r.get("issue"):
                meta.append(f"issue [#{r['issue']}]({url})" if url else f"issue #{r['issue']}")
            blocks = _blockers(rid, deps, ext)
            if blocks:
                meta.append("after " + ", ".join(f"`{b}`" for b in blocks))
            L.append("_" + " · ".join(meta) + "_")
            L.append("")
            spec = (r.get("spec") or "").strip()
            L.append(spec if spec else "> [!warning] No spec — this task cannot be dispatched.")
            L.append("")

    L += ["---", "",
          "| | |", "|---|---|",
          "| Today's session | [[Today]] |",
          "| The whole plan to the end | [[Build Calendar]] |",
          "| Yash's own tasks | [[Calendar]] |",
          "| Live threads | [[Threads and Issues]] |", ""]
    open(VIEW, "w", encoding="utf-8").write("\n".join(L))
    return VIEW


# ── options ──────────────────────────────────────────────────────────────

def _parse_opts(args):
    o = {"tags": [], "after": []}
    pos, i = [], 0
    while i < len(args):
        a = args[i]
        if a in ("--date", "--spec", "--spec-file", "--issue", "--repo"):
            if i + 1 >= len(args):
                print(f"{a} needs a value"); sys.exit(1)
            o[a[2:].replace("-", "_")] = args[i + 1]; i += 2
        elif a in ("--tag", "--after"):
            if i + 1 >= len(args):
                print(f"{a} needs a value"); sys.exit(1)
            o["tags" if a == "--tag" else "after"].append(args[i + 1]); i += 2
        else:
            pos.append(a); i += 1
    return pos, o


def _spec(o):
    if o.get("spec") and o.get("spec_file"):
        print("use --spec or --spec-file, not both"); sys.exit(1)
    if o.get("spec_file"):
        p = os.path.expanduser(o["spec_file"])
        if not os.path.exists(p):
            print("no such file:", p); sys.exit(1)
        return open(p, encoding="utf-8").read().strip()
    return (o.get("spec") or "").strip() or None


def _fmt(r):
    d = r.get("date") or "someday"
    iss = f" #{r['issue']}" if r.get("issue") else ""
    repo = f" ({r['repo']})" if r.get("repo") else ""
    tags = "  " + _tagstr(r) if r.get("tags") else ""
    after = "  ⤷ after " + ",".join(r["after"]) if r.get("after") else ""
    flag = "" if _dispatchable(r) else "  ⚠️ no spec"
    return f"[{r['id']}] {d}  {r['title']}{iss}{repo}{tags}{after}{flag}"


# ── commands ─────────────────────────────────────────────────────────────

def cmd_add(args):
    pos, o = _parse_opts(args)
    if not pos:
        print('usage: nhq-run add "<title>" [--date ..] [--spec ".." | --spec-file <path>] '
              '[--issue N] [--repo name] [--tag x] [--after <id>]')
        sys.exit(1)
    rows = _load()
    known = {r["id"] for r in rows}
    for dep in o["after"]:
        if dep not in known:
            print(f"--after {dep}: no such id (nhq-run list)"); sys.exit(1)
    issue = o.get("issue")
    r = {
        "id": uuid.uuid4().hex[:6],
        "title": pos[0],
        "date": _resolve_date(o.get("date")),
        "spec": _spec(o),
        "issue": int(str(issue).lstrip("#")) if issue else None,
        "repo": o.get("repo"),
        "tags": o["tags"],
        "after": o["after"],
        "status": "pending",
        "created": _today(),
    }
    rows.append(r)
    _save(rows)
    print("added:", _fmt(r))
    if not _dispatchable(r):
        print("  ⚠️ no spec — `show` will flag this as NOT dispatchable.")


def cmd_show(args):
    _, o = _parse_opts(args)
    rows = _load()
    date = _resolve_date(o.get("date")) or _default_date(rows)
    print(render_show(rows, date))
    v = write_view(rows, date)
    if v:
        print(f"vault -> {v}")


def cmd_dispatch(args):
    _, o = _parse_opts(args)
    rows = _load()
    date = _resolve_date(o.get("date")) or _default_date(rows)
    print(render_dispatch(rows, date))


def cmd_list(_):
    rows = _pending(_load())
    if not rows:
        print("(run queue empty)"); return
    for r in sorted(rows, key=_key):
        print(_fmt(r))


def _set_status(id_, status):
    rows = _load()
    if not any(r["id"] == id_ for r in rows):
        print("no such id:", id_); sys.exit(1)
    for r in rows:
        if r["id"] == id_:
            r["status"] = status
    _save(rows)
    print(f"{status}:", id_)


def cmd_done(args):
    if not args:
        print("usage: nhq-run done <id>"); sys.exit(1)
    _set_status(args[0], "done")


def cmd_drop(args):
    if not args:
        print("usage: nhq-run drop <id>"); sys.exit(1)
    _set_status(args[0], "dropped")


def cmd_rm(args):
    if not args:
        print("usage: nhq-run rm <id>"); sys.exit(1)
    rid = args[0]
    rows = _load()
    new = [r for r in rows if r["id"] != rid]
    if len(new) == len(rows):
        print("no such id:", rid); sys.exit(1)
    orphans = [r["id"] for r in new if rid in (r.get("after") or [])]
    for r in new:
        if rid in (r.get("after") or []):
            r["after"] = [d for d in r["after"] if d != rid]
    _save(new)
    print("removed:", rid)
    if orphans:
        print("  dropped that dependency from:", ", ".join(orphans))


def cmd_move(args):
    pos, o = _parse_opts(args)
    if not pos or "date" not in o:
        print("usage: nhq-run move <id> --date <YYYY-MM-DD|today|tonight|tomorrow|none>"); sys.exit(1)
    rows = _load()
    date = _resolve_date(o["date"])
    hit = None
    for r in rows:
        if r["id"] == pos[0]:
            r["date"] = date; hit = r
    if not hit:
        print("no such id:", pos[0]); sys.exit(1)
    _save(rows)
    print("moved:", _fmt(hit))


CMDS = {"add": cmd_add, "show": cmd_show, "dispatch": cmd_dispatch, "list": cmd_list,
        "done": cmd_done, "drop": cmd_drop, "rm": cmd_rm, "move": cmd_move}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h", "help") else 1)
    CMDS[sys.argv[1]](sys.argv[2:])
