#!/usr/bin/env python3
"""nhq-run — the autonomous-run queue: what the agents do tonight.

Yash drops tasks in through the day ("this one goes in the overnight run").
When he says go, the Director reads the day's run and dispatches agents at it.

A queued task is NOT a one-liner. It carries a full, self-contained spec,
because the thing that eventually executes it is a subagent that has never
seen the conversation the task came from. A row a blank agent cannot act on
is a broken row — `show` flags those as NOT DISPATCHABLE before the run
starts, rather than during it.

`nhq-calendar` holds Yash's tasks. `nhq-run` holds the agents' tasks.

Store : ~/.nhq/runs.jsonl               (source of truth, one JSON per line)
View  : ~/Obsidian/nHQ/Autonomous Run.md  (regenerated by `show`)

Usage:
  nhq-run add "<title>" [--date YYYY-MM-DD|today|tonight|tomorrow]
                        [--goal "<one sentence>"]
                        [--done-when "<text>" | --done-when-file <path>]
                        [--spec "<text>" | --spec-file <path>]
                        [--issue N] [--repo <name>] [--tag x] [--after <id>]
  nhq-run show     [--date ..]         # the day's run (+ writes the vault note)
  nhq-run dispatch [--date ..]         # full specs, ready to paste into subagent tasks
  nhq-run log      [--date ..] [--all] # the timeline: what ran when, for how long
  nhq-run list                         # everything pending, all dates, soonest first
  nhq-run start <id> [--note ".."]     # dispatched — an agent is on it
  nhq-run fail  <id> [--note "why"]    # it ran and did not land
  nhq-run done <id>                    # ran and landed
  nhq-run drop <id>                    # abandoned
  nhq-run rm   <id>                    # delete the row
  nhq-run move <id> --date <d>         # re-date it
The run for a date = tasks dated on/before it, plus every undated task —
undated means "goes in whichever run Yash calls".
Dates: 'tonight'/'today' -> today; 'tomorrow' -> tomorrow (same as nhq-calendar).
--after <id> records an ordering dependency. show/dispatch order by it and
group everything independent into waves that are run in parallel.

A row is DISPATCHABLE only with all three of --goal, --done-when and --spec.
A task with no definition of done is not runnable: it is finished when its goal
is met, not when an agent decides it has done enough. `show` flags such a row
and `dispatch` refuses it rather than handing an agent something open-ended.

Every state change appends to the row's append-only `events` list, so a task
that fails and is retried keeps its real history instead of overwriting it.
`log` flattens those events into one chronological timeline for a date.
Times display as `YYYY-MM-DD HH:MM IST` and are stored with the offset.
"""
import sys, os, json, shutil, signal, datetime, uuid

# `nhq-run list | head` must not traceback on the closed pipe.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".nhq", "runs.jsonl")
VIEW = os.path.join(HOME, "Obsidian", "nHQ", "Autonomous Run.md")
os.makedirs(os.path.dirname(STORE), exist_ok=True)

FAR = "9999-12-31"  # undated sorts last

# name -> (github slug, local checkout). Unknown names pass through as-is.
REPOS = {
    "heydaddy":       ("yashyadav711/heydaddy",       "~/Github/Work/heydaddy"),
    "mirror":         ("yashyadav711/mirror",         "~/Github/Work/mirror"),
    "nhq-agentic-os": ("yashyadav711/nhq-agentic-os", "~/Github/nhq-agentic-os"),
    "dots":           ("yashyadav711/dots",           "~/Github/dots"),
    "envy":           ("yashyadav711/envy",           "~/Github/nHQ/envy"),
}

DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
MONTHS = ["January", "February", "March", "April", "May", "June", "July",
          "August", "September", "October", "November", "December"]


# ── time ─────────────────────────────────────────────────────────────────
# DUPLICATED BYTE-IDENTICALLY in bin/nhq-run, bin/nhq-brief and bin/nhq-calendar.
# They are standalone scripts with no shared import — change one, change all three.

IST = datetime.timezone(datetime.timedelta(hours=5, minutes=30), "IST")


def _now_iso():
    """Now, ISO 8601 carrying the offset: 2026-08-10T07:39:12+05:30.

    Derived from IST explicitly rather than read off the ambient zone, so the
    value stays correct under any TZ and the offset survives into the store.
    """
    return datetime.datetime.now(IST).replace(microsecond=0).isoformat()


def _fmt_ts(ts):
    """The one display format, everywhere: '2026-08-10 07:39 IST'.

    A date-only value renders as the bare date. A clock time that was never
    recorded is never invented.
    """
    s = str(ts or "").strip()
    if not s:
        return ""
    if len(s) == 10:
        return s
    try:
        d = datetime.datetime.fromisoformat(s)
    except ValueError:
        return s
    if d.tzinfo is None:  # a naive wall-clock value is already IST
        d = d.replace(tzinfo=IST)
    return d.astimezone(IST).strftime("%Y-%m-%d %H:%M") + " IST"


# ── dates ────────────────────────────────────────────────────────────────

def _today():
    return datetime.datetime.now(IST).date().isoformat()


def _resolve_date(s):
    if not s:
        return None
    s = s.strip().lower()
    t = datetime.date.fromisoformat(_today())
    if s in ("today", "tonight"):
        return t.isoformat()
    if s == "tomorrow":
        return (t + datetime.timedelta(days=1)).isoformat()
    if s == "yesterday":
        return (t - datetime.timedelta(days=1)).isoformat()
    if s in ("none", "someday", "unscheduled"):
        return None
    datetime.date.fromisoformat(s)  # validate YYYY-MM-DD (raises on bad input)
    return s


def _long_date(date):
    d = datetime.date.fromisoformat(date)
    return f"{DAYS[d.weekday()]}, {d.day} {MONTHS[d.month - 1]} {d.year}"


# ── store ────────────────────────────────────────────────────────────────

def _load():
    if not os.path.exists(STORE):
        return []
    out = []
    for line in open(STORE, encoding="utf-8"):
        line = line.strip()
        if line:
            out.append(json.loads(line))
    return out


def _save(rows):
    with open(STORE, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def _key(r):
    return (r.get("date") or FAR, r.get("created") or "", r["id"])


def _pending(rows):
    return [r for r in rows if r["status"] == "pending"]


# ── events ──────────────────────────────────────────────────────────────
# Append-only. A task that fails and is retried has a real history; a mutable
# `started_at` would erase it. The events list is the source of truth for
# timing — `created` is kept only for backward compatibility.

TERMINAL = ("done", "failed", "dropped")
LIFECYCLE = ("started",) + TERMINAL


def _events(r):
    return r.get("events") or []


def _log_event(r, event, note=None):
    """Append one event to the row and hand it back."""
    e = {"at": _now_iso(), "event": event}
    if note:
        e["note"] = note
    r.setdefault("events", []).append(e)
    return e


def _last(r, *events):
    """The most recent event of any of these kinds, or None."""
    for e in reversed(_events(r)):
        if e.get("event") in events:
            return e
    return None


def _queued_at(r):
    """When it entered the queue. Rows written before events fall back to the
    date-only `created`, which renders as a bare date."""
    e = _last(r, "queued")
    return e["at"] if e else r.get("created")


def _state(r):
    """(state, at) — the lifecycle state and when the row entered it."""
    e = _last(r, *LIFECYCLE)
    return (e["event"], e.get("at")) if e else ("queued", _queued_at(r))


def _at(ts):
    """An ISO timestamp as an aware datetime; None when it has no clock time."""
    s = str(ts or "").strip()
    if len(s) <= 10:
        return None
    try:
        d = datetime.datetime.fromisoformat(s)
    except ValueError:
        return None
    return d if d.tzinfo else d.replace(tzinfo=IST)


def _dur(a, b):
    """Elapsed time between two ISO timestamps: '47s', '12m', '2h 14m', '1d 3h'."""
    da, db = _at(a), _at(b)
    if not (da and db):
        return None
    s = int((db - da).total_seconds())
    if s < 0:
        return None
    if s < 60:
        return f"{s}s"
    m = s // 60
    if m < 60:
        return f"{m}m"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h}h {m:02d}m"
    d, h = divmod(h, 24)
    return f"{d}d {h}h"


def _ran_for(r, e):
    """How long the task had been running when event `e` landed, measured from
    its own most recent `started` before that event."""
    started = None
    for x in _events(r):
        if x is e:
            break
        if x.get("event") == "started":
            started = x
    return _dur(started["at"], e.get("at")) if started else None


def _running_for(r):
    """How long it has been running right now, or None if it is not running."""
    state, at = _state(r)
    return _dur(at, _now_iso()) if state == "started" else None


def _slug(name):
    return REPOS.get(name, (name, None))[0] if name else None


def _checkout(name):
    p = REPOS.get(name, (None, None))[1]
    return os.path.expanduser(p) if p else None


def _issue_url(r):
    slug = _slug(r.get("repo"))
    return f"https://github.com/{slug}/issues/{r['issue']}" if (slug and r.get("issue")) else None


# A row is runnable only if an agent that has never seen the conversation can
# read what it is for (goal), when to stop (done_when) and how (spec).
REQUIRED = (("goal", "goal"), ("done_when", "done-when"), ("spec", "spec"))


def _missing(r):
    """Which of the three required fields this row is short of."""
    return [label for field, label in REQUIRED if not (r.get(field) or "").strip()]


def _dispatchable(r):
    return not _missing(r)


# ── the shape of the run ─────────────────────────────────────────────────

def _run_set(rows, date):
    """Tasks in the run for `date`: pending, dated on/before it, plus undated."""
    return [r for r in _pending(rows)
            if r.get("date") is None or r["date"] <= date]


def _default_date(rows):
    """The current run if today has one, else the next dated run, else today."""
    t = _today()
    dated = sorted({r["date"] for r in _pending(rows) if r.get("date")})
    if any(d <= t for d in dated):
        return t
    return dated[0] if dated else t


def _waves(run, allrows):
    """Kahn layering over --after. Each wave is independent → run in parallel.

    Returns (waves, ext) where ext[id] lists dependencies that are NOT in this
    run, each as (dep_id, state): 'done' is satisfied, anything else blocks.
    """
    ids = {r["id"] for r in run}
    known = {r["id"]: r for r in allrows}
    deps, ext = {}, {}
    for r in run:
        inside, outside = [], []
        for d in r.get("after") or []:
            (inside if d in ids else outside).append(d)
        deps[r["id"]] = inside
        ext[r["id"]] = [(d, known[d]["status"] if d in known else "unknown") for d in outside]

    order = {r["id"]: _key(r) for r in run}
    waves, placed = [], set()
    while len(placed) < len(ids):
        layer = [i for i in ids if i not in placed and all(d in placed for d in deps[i])]
        if not layer:  # --after cycle; surface the rest rather than hang
            rest = sorted((i for i in ids if i not in placed), key=lambda i: order[i])
            waves.append((rest, True))
            break
        waves.append((sorted(layer, key=lambda i: order[i]), False))
        placed |= set(layer)
    return waves, deps, ext


def _blockers(rid, deps, ext):
    """Human phrases for what this task waits on."""
    out = [f"{d}" for d in deps[rid]]
    for d, state in ext[rid]:
        if state == "done":
            out.append(f"{d} (already done)")
        elif state == "unknown":
            out.append(f"{d} (⚠️ unknown id)")
        else:
            out.append(f"{d} (⚠️ not in this run — {state})")
    return out


# ── show ─────────────────────────────────────────────────────────────────

def _width():
    return max(60, min(shutil.get_terminal_size((100, 24)).columns, 100))


def _rule(label, w):
    head = f"── {label} "
    return head + "─" * max(3, w - len(head))


def _tagstr(r):
    return " ".join(f"#{t}" for t in r.get("tags") or [])


def _one_line(r, w):
    """id · title · issue · repo · tags, clipped to the terminal."""
    bits = [f"[{r['id']}]", r["title"]]
    if r.get("issue"):
        bits.append(f"#{r['issue']}")
    if r.get("repo"):
        bits.append(f"({r['repo']})")
    tags = _tagstr(r)
    if tags:
        bits.append(tags)
    line = "  " + " ".join(bits)
    return line if len(line) <= w else line[:w - 1] + "…"


def _timing(r):
    """One line of clock: when it was queued, the state it is in and since when,
    and how long it has been running (or how long the last attempt took)."""
    bits = []
    q = _fmt_ts(_queued_at(r))
    if q:
        bits.append(f"queued {q}")
    state, at = _state(r)
    if state != "queued":
        bits.append(f"{state} {_fmt_ts(at)}".strip())
    running = _running_for(r)
    if running:
        bits.append(f"running {running}")
    else:
        e = _last(r, "done", "failed")
        took = _ran_for(r, e) if e else None
        if took:
            bits.append(f"took {took}")
    return "      🕐 " + " · ".join(bits) if bits else ""


def _no_fields(r):
    """'NO GOAL, NO DONE-WHEN' — what this row is short of, for a warning line."""
    return ", ".join(f"no {m}" for m in _missing(r)).upper()


def render_show(rows, date):
    w = _width()
    run = _run_set(rows, date)
    waves, deps, ext = _waves(run, rows)
    undisp = [r for r in run if not _dispatchable(r)]
    byid = {r["id"]: r for r in run}

    L = []
    L.append(f"🌙 Autonomous Run — {_long_date(date)}")
    par = max((len(ids) for ids, _ in waves), default=0)
    head = f"{len(run)} task{'' if len(run) == 1 else 's'}"
    if len(waves) > 1:
        head += f" · {len(waves)} waves · up to {par} in parallel"
    elif run:
        head += " · all independent, run in parallel"
    if undisp:
        head += f" · ⚠️ {len(undisp)} NOT dispatchable"
    L.append(head)
    L.append("")

    if not run:
        L.append("  (nothing queued — nhq-run add \"<title>\" "
                 "--goal \"...\" --done-when \"...\" --spec \"...\")")
        L.append("")
        return "\n".join(L)

    for n, (ids, cyclic) in enumerate(waves, 1):
        if cyclic:
            label = f"UNRESOLVED · {len(ids)} task(s) — --after cycle, order them by hand"
        elif n == 1:
            label = f"Wave {n} · {len(ids)} task(s) · start together, nothing blocks them"
        else:
            label = f"Wave {n} · {len(ids)} task(s) · waits for wave {n - 1}"
        L.append(_rule(label, w))
        for rid in ids:
            r = byid[rid]
            L.append(_one_line(r, w))
            blocks = _blockers(rid, deps, ext)
            if blocks:
                L.append(f"      ⤷ after {', '.join(blocks)}")
            if r.get("date") is None:
                L.append("      · undated — rides along in whichever run you call")
            elif r["date"] < date:
                L.append(f"      · carried over from {r['date']}")
            t = _timing(r)
            if t:
                L.append(t)
            if not _dispatchable(r):
                L.append(f"      ⚠️ {_no_fields(r)} — NOT DISPATCHABLE, "
                         "an agent cannot act on this")
        L.append("")

    if undisp:
        L.append(_rule("Before you start", w))
        L.append(f"  {len(undisp)} task(s) are not runnable:")
        for r in undisp:
            L.append(f"    {r['id']} — missing {', '.join(_missing(r))}")
        L.append("  A subagent is handed nothing but the goal, the done-when and the spec.")
        L.append("  A task with no definition of done is finished when the agent says so —")
        L.append("  write all three, or drop the row:")
        L.append("    nhq-run rm <id>   then re-add with --goal / --done-when / --spec")
        L.append("")

    L.append(_rule("Next", w))
    L.append(f"  nhq-run dispatch --date {date}   # the full specs, for the agents")
    L.append("")
    return "\n".join(L)


# ── dispatch ─────────────────────────────────────────────────────────────

def render_dispatch(rows, date):
    run = _run_set(rows, date)
    waves, deps, ext = _waves(run, rows)
    byid = {r["id"]: r for r in run}
    seq = [(n, ids, rid) for n, (ids, _) in enumerate(waves, 1) for rid in ids]

    out = []
    out.append("=" * 78)
    out.append(f"AUTONOMOUS RUN · {date} · {len(seq)} task(s) · {len(waves)} wave(s)")
    out.append("Each block below is self-contained. Paste one block per subagent.")
    out.append("Tasks in the same wave have no dependency on each other and are")
    out.append("meant to be run at the same time.")
    out.append("=" * 78)
    out.append("")

    if not seq:
        out.append("(nothing queued for this run)")
        out.append("")
        return "\n".join(out)

    for i, (wave, ids, rid) in enumerate(seq, 1):
        r = byid[rid]
        siblings = [x for x in ids if x != rid]
        out.append("=" * 78)
        out.append(f"TASK {i}/{len(seq)}  ·  id {r['id']}  ·  wave {wave}")
        out.append("=" * 78)
        if not _dispatchable(r):
            out.append(f"*** NOT DISPATCHABLE — this row is missing: {', '.join(_missing(r))}. ***")
            out.append(f"TITLE      : {r['title']}")
            out.append("")
            out.append("A task with no goal has nothing to aim at, and one with no done-when")
            out.append("is finished whenever the agent decides it has done enough. Do not guess")
            out.append("either. Return this row to Director:")
            out.append(f"  nhq-run rm {r['id']}   then re-add with --goal / --done-when / --spec")
            out.append("")
            continue
        out.append(f"TITLE      : {r['title']}")
        repo = r.get("repo")
        if repo:
            co = _checkout(repo)
            out.append(f"REPO       : {repo}" + (f"   (checkout: {co})" if co else ""))
        else:
            out.append("REPO       : (not specified — ask before touching any repo)")
        url = _issue_url(r)
        if r.get("issue"):
            out.append(f"ISSUE      : #{r['issue']}" + (f"   {url}" if url else ""))
            out.append(f"             read it in full first: gh issue view {r['issue']}"
                       + (f" --repo {_slug(repo)}" if _slug(repo) else "") + " --comments")
        if r.get("tags"):
            out.append(f"TAGS       : {', '.join(r['tags'])}")
        blocks = _blockers(rid, deps, ext)
        if blocks:
            out.append(f"DEPENDS ON : {', '.join(blocks)} — do NOT start until that has landed.")
        else:
            out.append("DEPENDS ON : nothing. Start immediately.")
        if siblings:
            out.append(f"PARALLEL   : running alongside {', '.join(siblings)} — "
                       "assume those files are being edited too; use your own worktree.")
        out.append("")
        out.append("GOAL")
        out.append("-" * 78)
        out.append(r["goal"].strip())
        out.append("-" * 78)
        out.append("")
        out.append("SPEC")
        out.append("-" * 78)
        out.append(r["spec"].strip())
        out.append("-" * 78)
        out.append("")
        out.append("DONE WHEN — the task is finished when every one of these is true,")
        out.append("not when you judge you have done enough.")
        out.append("-" * 78)
        out.append(r["done_when"].strip())
        out.append("-" * 78)
        out.append("")
    return "\n".join(out)


# ── log ──────────────────────────────────────────────────────────────────
# The morning view. An overnight run happened while Yash slept; he opens one
# thing and reads the timeline — what started when, what finished when, and
# how long each took.

ICON = {"queued": "＋", "started": "▶", "done": "✔", "failed": "✖",
        "dropped": "⊘", "moved": "→"}


def _ev_date(e):
    """The IST calendar date an event happened on."""
    d = _at(e.get("at"))
    return d.astimezone(IST).date().isoformat() if d else None


def _timeline(rows, date=None):
    """Every row's events flattened into one chronological list of
    (row, event) pairs. `date` filters to that IST day; None takes all."""
    flat = [(r, e) for r in rows for e in _events(r)
            if _at(e.get("at")) and (date is None or _ev_date(e) == date)]
    flat.sort(key=lambda p: (p[1]["at"], p[0]["id"]))
    return flat


def _log_lines(flat, w):
    """The timeline body, one line per event: time · event · task · duration."""
    L = []
    for r, e in flat:
        ev = e["event"]
        # The one display string, on every line — a bare clock would be the
        # ambiguity this whole change exists to remove.
        clock = _fmt_ts(e["at"])
        dur = _ran_for(r, e) if ev in ("done", "failed") else None
        head = f"  {clock}  {ICON.get(ev, '·')} {ev:<8} [{r['id']}] {r['title']}"
        tail = f"  {dur}" if dur else ""
        if len(head) + len(tail) > w:
            head = head[:w - len(tail) - 1] + "…"
        L.append(head + tail)
        if e.get("note"):
            L.append(f"      {' ' * len(clock)}↳ {e['note']}")
    return L


def _log_summary(flat):
    """How many ran, finished, failed, and the wall-clock span of the run."""
    started = {r["id"] for r, e in flat if e["event"] == "started"}
    done = [(r, e) for r, e in flat if e["event"] == "done"]
    failed = [(r, e) for r, e in flat if e["event"] == "failed"]
    first = next((e["at"] for _r, e in flat if e["event"] == "started"), None)
    last = next((e["at"] for _r, e in reversed(flat) if e["event"] in TERMINAL), None)

    L = [f"  {len(started)} ran · {len(done)} finished · {len(failed)} failed"]
    if first and last:
        span = _dur(first, last)
        L.append(f"  run span {_fmt_ts(first)} → {_fmt_ts(last)}" + (f"  ({span})" if span else ""))
    elif first:
        L.append(f"  started {_fmt_ts(first)} — nothing has finished yet"
                 + (f", running {_dur(first, _now_iso())}" if _dur(first, _now_iso()) else ""))
    return L


def render_log(rows, date=None):
    w = _width()
    flat = _timeline(rows, date)

    if not flat:
        when = _long_date(date) if date else "any date"
        return (f"🕐 Run log — {when}\n\n"
                f"  Nothing happened{'' if date else ' yet'} — no events recorded.\n"
                "  Events are written by add / start / done / fail / drop / move.\n")

    L = [f"🕐 Run log — {_long_date(date) if date else 'all dates'}", ""]
    if date is None:  # --all: keep the days apart, oldest first
        for day in sorted({_ev_date(e) for _r, e in flat}):
            L.append(_rule(_long_date(day), w))
            L += _log_lines([p for p in flat if _ev_date(p[1]) == day], w)
            L.append("")
    else:
        L += _log_lines(flat, w)
        L.append("")

    L.append(_rule("Summary", w))
    L += _log_summary(flat)
    L.append("")
    return "\n".join(L)


# ── vault ────────────────────────────────────────────────────────────────

def _md_esc(s):
    return (s or "").replace("|", "\\|").replace("\n", " ").strip()


def write_view(rows, date):
    d = os.path.dirname(VIEW)
    if not os.path.isdir(d):
        return None
    run = _run_set(rows, date)
    waves, deps, ext = _waves(run, rows)
    byid = {r["id"]: r for r in run}
    undisp = [r for r in run if not _dispatchable(r)]
    par = max((len(ids) for ids, _ in waves), default=0)

    L = ["---", 'title: "Autonomous Run"', "type: pointer",
         f'updated: "{_fmt_ts(_now_iso())}"', "---", "",
         "# Autonomous Run", "",
         "> [!tip] What this is",
         "> The next autonomous run — what the agents do when Yash says go. This file never moves and never gets renamed: open it and you are looking at the run that is coming. Kept by `nhq-run`; the store is `~/.nhq/runs.jsonl`.",
         ">",
         "> Not to be confused with [[Calendar]], which is Yash's own task list. This one is the agents' queue.",
         ""]
    L.append(f"**Run:** {_long_date(date)} · **{len(run)} task"
             f"{'' if len(run) == 1 else 's'}** · {len(waves)} wave"
             f"{'' if len(waves) == 1 else 's'} · up to {par} in parallel"
             + (f" · ⚠️ **{len(undisp)} not dispatchable**" if undisp else ""))
    L.append("")

    if not run:
        L += ["_Nothing queued._", ""]
    for n, (ids, cyclic) in enumerate(waves, 1):
        if cyclic:
            L.append(f"## ⚠️ Unresolved — `--after` cycle ({len(ids)})")
        elif n == 1:
            L.append(f"## Wave {n} — start together ({len(ids)})")
        else:
            L.append(f"## Wave {n} — after wave {n - 1} ({len(ids)})")
        L.append("")
        L.append("| | Task | Issue | Repo | Waits on |")
        L.append("|---|---|---|---|---|")
        for rid in ids:
            r = byid[rid]
            mark = "⚠️" if not _dispatchable(r) else "☐"
            url = _issue_url(r)
            iss = f"[#{r['issue']}]({url})" if url else (f"#{r['issue']}" if r.get("issue") else "—")
            tags = _tagstr(r)
            title = f"**{_md_esc(r['title'])}**" + (f" {tags}" if tags else "") + f" · `{rid}`"
            state, at = _state(r)
            when = _fmt_ts(at)
            title += f" · {state}" + (f" {when}" if when else "")
            running = _running_for(r)
            if running:
                title += f", running **{running}**"
            if not _dispatchable(r):
                title += f" · **missing {', '.join(_missing(r))} — not dispatchable**"
            blocks = _blockers(rid, deps, ext)
            L.append(f"| {mark} | {title} | {iss} | {r.get('repo') or '—'} | "
                     f"{', '.join(f'`{b}`' for b in blocks) if blocks else '—'} |")
        L.append("")

    if undisp:
        L += ["> [!warning] Not dispatchable",
              "> " + ", ".join(f"`{r['id']}` {_md_esc(r['title'])} — missing "
                               f"{', '.join(_missing(r))}" for r in undisp),
              "> A subagent is handed nothing but the goal, the done-when and the spec.",
              "> A task with no definition of done is finished when the agent says so.", ""]

    flat = _timeline(rows, date)
    L += ["---", "", "## Timeline", "",
          f"_Every state change on {_long_date(date)}, oldest first. "
          "`nhq-run log` prints the same thing for the terminal._", ""]
    if not flat:
        L += ["_Nothing has happened on this date yet._", ""]
    else:
        L += ["| Time | | Event | Task | Took |", "|---|---|---|---|---|"]
        for r, e in flat:
            ev = e["event"]
            dur = _ran_for(r, e) if ev in ("done", "failed") else None
            note = f" — {_md_esc(e['note'])}" if e.get("note") else ""
            L.append(f"| {_fmt_ts(e['at'])} "
                     f"| {ICON.get(ev, '·')} | {ev} "
                     f"| {_md_esc(r['title'])} · `{r['id']}`{note} | {dur or '—'} |")
        L += [""] + ["_" + s.strip() + "_" for s in _log_summary(flat)] + [""]

    L += ["---", "", "## The specs", "",
          "_Full text, as handed to the agents. `nhq-run dispatch` prints the same thing for the terminal._", ""]
    for n, (ids, _c) in enumerate(waves, 1):
        for rid in ids:
            r = byid[rid]
            L.append(f"### `{rid}` — {_md_esc(r['title'])}")
            L.append("")
            meta = [f"wave {n}"]
            if r.get("repo"):
                meta.append(f"repo `{r['repo']}`")
            url = _issue_url(r)
            if r.get("issue"):
                meta.append(f"issue [#{r['issue']}]({url})" if url else f"issue #{r['issue']}")
            blocks = _blockers(rid, deps, ext)
            if blocks:
                meta.append("after " + ", ".join(f"`{b}`" for b in blocks))
            L.append("_" + " · ".join(meta) + "_")
            L.append("")
            goal = (r.get("goal") or "").strip()
            L.append("**Goal**")
            L.append("")
            L.append(goal if goal else "> [!warning] No goal — this task has nothing to aim at.")
            L.append("")
            spec = (r.get("spec") or "").strip()
            L.append("**Spec**")
            L.append("")
            L.append(spec if spec else "> [!warning] No spec — this task cannot be dispatched.")
            L.append("")
            dw = (r.get("done_when") or "").strip()
            L.append("**Done when** — every one of these is true, not when the agent decides.")
            L.append("")
            L.append(dw if dw else "> [!warning] No done-when — this task has no definition of done.")
            L.append("")

    L += ["---", "",
          "| | |", "|---|---|",
          "| Today's session | [[Today]] |",
          "| The whole plan to the end | [[Build Calendar]] |",
          "| Yash's own tasks | [[Calendar]] |",
          "| Live threads | [[Threads and Issues]] |", ""]
    open(VIEW, "w", encoding="utf-8").write("\n".join(L))
    return VIEW


# ── options ──────────────────────────────────────────────────────────────

def _parse_opts(args):
    o = {"tags": [], "after": []}
    pos, i = [], 0
    while i < len(args):
        a = args[i]
        if a in ("--date", "--spec", "--spec-file", "--issue", "--repo",
                 "--goal", "--done-when", "--done-when-file", "--note"):
            if i + 1 >= len(args):
                print(f"{a} needs a value"); sys.exit(1)
            o[a[2:].replace("-", "_")] = args[i + 1]; i += 2
        elif a == "--all":
            o["all"] = True; i += 1
        elif a in ("--tag", "--after"):
            if i + 1 >= len(args):
                print(f"{a} needs a value"); sys.exit(1)
            o["tags" if a == "--tag" else "after"].append(args[i + 1]); i += 2
        else:
            pos.append(a); i += 1
    return pos, o


def _text(o, name):
    """--<name> or --<name>-file, never both. Returns the text, or None."""
    key = name.replace("-", "_")
    inline, path = o.get(key), o.get(key + "_file")
    if inline and path:
        print(f"use --{name} or --{name}-file, not both"); sys.exit(1)
    if path:
        p = os.path.expanduser(path)
        if not os.path.exists(p):
            print("no such file:", p); sys.exit(1)
        return open(p, encoding="utf-8").read().strip() or None
    return (inline or "").strip() or None


def _fmt(r):
    d = r.get("date") or "someday"
    iss = f" #{r['issue']}" if r.get("issue") else ""
    repo = f" ({r['repo']})" if r.get("repo") else ""
    tags = "  " + _tagstr(r) if r.get("tags") else ""
    after = "  ⤷ after " + ",".join(r["after"]) if r.get("after") else ""
    flag = "" if _dispatchable(r) else "  ⚠️ missing " + ", ".join(_missing(r))
    return f"[{r['id']}] {d}  {r['title']}{iss}{repo}{tags}{after}{flag}"


# ── commands ─────────────────────────────────────────────────────────────

def cmd_add(args):
    pos, o = _parse_opts(args)
    if not pos:
        print('usage: nhq-run add "<title>" [--date ..] [--goal "<one sentence>"] '
              '[--done-when ".." | --done-when-file <path>] '
              '[--spec ".." | --spec-file <path>] '
              '[--issue N] [--repo name] [--tag x] [--after <id>]')
        sys.exit(1)
    rows = _load()
    known = {r["id"] for r in rows}
    for dep in o["after"]:
        if dep not in known:
            print(f"--after {dep}: no such id (nhq-run list)"); sys.exit(1)
    issue = o.get("issue")
    r = {
        "id": uuid.uuid4().hex[:6],
        "title": pos[0],
        "date": _resolve_date(o.get("date")),
        "goal": _text(o, "goal"),
        "done_when": _text(o, "done-when"),
        "spec": _text(o, "spec"),
        "issue": int(str(issue).lstrip("#")) if issue else None,
        "repo": o.get("repo"),
        "tags": o["tags"],
        "after": o["after"],
        "status": "pending",
        "created": _today(),
        "events": [],
    }
    _log_event(r, "queued")
    rows.append(r)
    _save(rows)
    print("added:", _fmt(r))
    if not _dispatchable(r):
        print(f"  ⚠️ missing {', '.join(_missing(r))} — "
              "`show` will flag this as NOT dispatchable and `dispatch` will refuse it.")


def cmd_show(args):
    _, o = _parse_opts(args)
    rows = _load()
    date = _resolve_date(o.get("date")) or _default_date(rows)
    print(render_show(rows, date))
    v = write_view(rows, date)
    if v:
        print(f"vault -> {v}")


def cmd_dispatch(args):
    _, o = _parse_opts(args)
    rows = _load()
    date = _resolve_date(o.get("date")) or _default_date(rows)
    print(render_dispatch(rows, date))


def cmd_log(args):
    _, o = _parse_opts(args)
    rows = _load()
    date = None if o.get("all") else (_resolve_date(o.get("date")) or _today())
    print(render_log(rows, date))


def cmd_list(_):
    rows = _pending(_load())
    if not rows:
        print("(run queue empty)"); return
    for r in sorted(rows, key=_key):
        print(_fmt(r))


def _mark(id_, event, status=None, note=None):
    """Append the event; move `status` only when the row genuinely leaves the queue.
    start and fail keep it pending, so a failed task can be retried and the
    events list carries both attempts."""
    rows = _load()
    hit = None
    for r in rows:
        if r["id"] == id_:
            e = _log_event(r, event, note)
            if status:
                r["status"] = status
            hit = (r, e)
    if not hit:
        print("no such id:", id_); sys.exit(1)
    _save(rows)
    r, e = hit
    line = f"{event}: {id_}  {_fmt_ts(e['at'])}"
    took = _ran_for(r, e) if event in ("done", "failed") else None
    if took:
        line += f"  (ran {took})"
    print(line)
    if note:
        print(f"  ↳ {note}")


def _one(cmd, args, event, status=None):
    pos, o = _parse_opts(args)
    if not pos:
        print(f'usage: nhq-run {cmd} <id> [--note "..."]'); sys.exit(1)
    _mark(pos[0], event, status, o.get("note"))


def cmd_start(args):
    _one("start", args, "started")


def cmd_fail(args):
    _one("fail", args, "failed")


def cmd_done(args):
    _one("done", args, "done", "done")


def cmd_drop(args):
    _one("drop", args, "dropped", "dropped")


def cmd_rm(args):
    if not args:
        print("usage: nhq-run rm <id>"); sys.exit(1)
    rid = args[0]
    rows = _load()
    new = [r for r in rows if r["id"] != rid]
    if len(new) == len(rows):
        print("no such id:", rid); sys.exit(1)
    orphans = [r["id"] for r in new if rid in (r.get("after") or [])]
    for r in new:
        if rid in (r.get("after") or []):
            r["after"] = [d for d in r["after"] if d != rid]
    _save(new)
    print("removed:", rid)
    if orphans:
        print("  dropped that dependency from:", ", ".join(orphans))


def cmd_move(args):
    pos, o = _parse_opts(args)
    if not pos or "date" not in o:
        print("usage: nhq-run move <id> --date <YYYY-MM-DD|today|tonight|tomorrow|none>"); sys.exit(1)
    rows = _load()
    date = _resolve_date(o["date"])
    hit = None
    for r in rows:
        if r["id"] == pos[0]:
            was = r.get("date") or "someday"
            r["date"] = date
            _log_event(r, "moved", f"{was} → {date or 'someday'}")
            hit = r
    if not hit:
        print("no such id:", pos[0]); sys.exit(1)
    _save(rows)
    print("moved:", _fmt(hit))


CMDS = {"add": cmd_add, "show": cmd_show, "dispatch": cmd_dispatch, "log": cmd_log,
        "list": cmd_list, "start": cmd_start, "fail": cmd_fail, "done": cmd_done,
        "drop": cmd_drop, "rm": cmd_rm, "move": cmd_move}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h", "help") else 1)
    CMDS[sys.argv[1]](sys.argv[2:])
