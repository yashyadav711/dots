#!/usr/bin/env python3
"""nhq-stt-server — Hinglish speech-to-text on the GPU box, over HTTP.

    nhq-stt-server                  serve on 0.0.0.0:8128 with the Apex model
    nhq-stt-server --model DIR      a different CTranslate2 model directory
    nhq-stt-server --port N --host H

    POST /transcribe   body = 16-bit mono WAV   ->  {"text": …, "rtf": …, "model": …}
    GET  /health       ->  {"ok": true, "model": …, "loaded": bool, "device": "cuda"}

Why this exists: the laptop has no GPU, so it dictates through a 74M-parameter model
(whisper-base class) that measurably drops whole sentences. rig has an RTX 2070 doing
nothing most of the time. Measured on Yash's own recordings, the 809M Hinglish model
here fixed a sentence the small one silently swallowed and scored 0.000 WER on a
segment with known ground truth, at 25x realtime and 1.2 GB of VRAM.

Design notes that matter:

  The model stays RESIDENT. Loading Apex takes ~0.6 s from disk, which would be added
  to every single push-to-talk. A resident model makes a 6-second utterance land in
  ~0.3 s end to end.

  language="en" is deliberate, not a bug. It makes Whisper render Hindi PHONETICALLY
  IN LATIN SCRIPT — "helmet na pahnane se" — which is what gets dictated into code,
  chat and terminals. language="hi" would return Devanagari and need a transliteration
  step that costs accuracy and time.

  It answers on the LAN, because a laptop with no GPU is the entire point. Nothing
  authenticates: it transcribes audio you send it and returns text, holds no
  credentials, and cannot reach anything else. If that ever stops being an acceptable
  trade, bind it to loopback and tunnel with `nhq-tunnel rig stt`.
"""

from __future__ import annotations

import argparse
import io
import json
import os
import sys
import threading
import time
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

DEFAULT_MODEL = Path.home() / "ai/labs/stt-hinglish/ct2/Apex-int8f16"
MAX_BODY = 200 * 1024 * 1024          # ~100 minutes of 16 kHz mono; a dictation is seconds

_model = None
_model_lock = threading.Lock()        # CTranslate2 is thread-safe per call, but one
                                      # GPU model serving one user does not need
                                      # concurrent decodes competing for VRAM.
_cfg: argparse.Namespace


def log(msg: str) -> None:
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def get_model():
    global _model
    if _model is None:
        with _model_lock:
            if _model is None:
                from faster_whisper import WhisperModel
                t0 = time.time()
                _model = WhisperModel(str(_cfg.model), device=_cfg.device,
                                      compute_type=_cfg.compute_type)
                log(f"loaded {Path(_cfg.model).name} in {time.time()-t0:.2f}s "
                    f"({_cfg.device}/{_cfg.compute_type})")
    return _model


def wav_duration(raw: bytes) -> float:
    with wave.open(io.BytesIO(raw)) as w:
        return w.getnframes() / w.getframerate()


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):            # our own log lines are more useful
        pass

    def _json(self, code: int, payload: dict) -> None:
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.split("?")[0] != "/health":
            return self._json(404, {"error": "only /health and POST /transcribe"})
        # Deliberately does NOT load the model: health is asked on every dictation to
        # decide whether to use the GPU at all, and must stay instant.
        self._json(200, {"ok": True, "model": Path(_cfg.model).name,
                         "loaded": _model is not None, "device": _cfg.device})

    def do_POST(self):
        if self.path.split("?")[0] != "/transcribe":
            return self._json(404, {"error": "POST /transcribe"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return self._json(400, {"error": "bad Content-Length"})
        if n <= 0:
            return self._json(400, {"error": "empty body — send a 16-bit mono WAV"})
        if n > MAX_BODY:
            return self._json(413, {"error": f"body over {MAX_BODY} bytes"})

        raw = self.rfile.read(n)
        try:
            dur = wav_duration(raw)
        except Exception as e:
            return self._json(400, {"error": f"not a readable WAV: {e}"})

        lang = "en"
        if "?" in self.path:
            from urllib.parse import parse_qs
            lang = (parse_qs(self.path.split("?", 1)[1]).get("lang") or ["en"])[0]

        try:
            model = get_model()
            t0 = time.time()
            with _model_lock:
                segs, _info = model.transcribe(io.BytesIO(raw), language=lang,
                                               beam_size=5, vad_filter=True)
                text = " ".join(s.text.strip() for s in segs).strip()
            el = time.time() - t0
        except Exception as e:
            log(f"transcribe failed: {type(e).__name__}: {e}")
            return self._json(500, {"error": f"{type(e).__name__}: {e}"})

        log(f"{dur:5.1f}s audio -> {el:5.2f}s (rtf {el/dur if dur else 0:.3f})  {text[:60]}")
        self._json(200, {"text": text, "seconds": round(el, 3),
                         "audio_seconds": round(dur, 2),
                         "rtf": round(el / dur, 4) if dur else None,
                         "model": Path(_cfg.model).name, "lang": lang})


def main() -> int:
    global _cfg
    p = argparse.ArgumentParser(prog="nhq-stt-server", description="Hinglish STT on the GPU")
    p.add_argument("--model", default=str(DEFAULT_MODEL))
    p.add_argument("--host", default="0.0.0.0")
    p.add_argument("--port", type=int, default=8128)
    p.add_argument("--device", default="cuda")
    p.add_argument("--compute-type", dest="compute_type", default="int8_float16")
    p.add_argument("--preload", action="store_true",
                   help="load the model at startup instead of on the first request")
    _cfg = p.parse_args()

    if not Path(_cfg.model, "model.bin").exists():
        print(f"no CTranslate2 model at {_cfg.model}\n"
              f"convert one with:\n"
              f"  ct2-transformers-converter --model Oriserve/Whisper-Hindi2Hinglish-Apex \\\n"
              f"    --output_dir {_cfg.model} --quantization int8_float16", file=sys.stderr)
        return 1

    if _cfg.preload:
        get_model()

    srv = ThreadingHTTPServer((_cfg.host, _cfg.port), Handler)
    log(f"listening on {_cfg.host}:{_cfg.port}  model={Path(_cfg.model).name}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        log("stopping")
    return 0


if __name__ == "__main__":
    sys.exit(main())
