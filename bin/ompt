#!/usr/bin/env bash
# ompt — start omp inside tmux so Ctrl+Up genuinely scrolls the chat back to
# your previous message.
#
# Why this exists: omp already marks every user message with OSC 133 prompt
# marks, but only the thing that OWNS the scrollback can jump to them. Orca's
# terminal cannot (xterm.js with no prompt-jump action, and `orca terminal *`
# exposes no scroll command — checked 2026-08-11). tmux can, so running omp
# under tmux gives Ctrl+Up real scrolling in ANY terminal, Orca included.
#
# The binding lives in dots/tmux/tmux.conf.local:
#   bind -n C-Up copy-mode \; send-keys -X previous-prompt \; send-keys -X previous-prompt
#   bind -T copy-mode-vi C-Up send-keys -X previous-prompt
#
# Usage:  ompt              — omp in this directory, wrapped in tmux
#         ompt -c           — any omp flag is passed straight through
#         ompt usage        — a subcommand runs bare, in THIS terminal: a tmux
#                             session dies with its command and would take the
#                             output with it (2026-08-17)
set -euo pipefail

# The editor omp gets for Ctrl+E. SET, not inherited — and that distinction is
# the whole bug of 2026-08-13.
#
# There are three places a stale value can hide, and $VISUAL passed through from
# the caller loses to all three:
#   - the tmux SERVER, a daemon that may have started weeks ago and hands its
#     own frozen environment to every new pane;
#   - the login shell under the terminal, which is older than any config change
#     and keeps exporting what it was born with;
#   - an omp-spawned child, which is handed VISUAL=true on purpose.
# The first attempt here was `-e VISUAL=${VISUAL:-nhq-editor}`, which faithfully
# carried the stale `vim` out of a fish shell that predated the config change
# and pushed it into the new session. A default only fires when the variable is
# unset; it cannot help when the variable is set to the wrong thing.
#
# omp is the only consumer, and there is exactly one right answer for it, so
# state it. NHQ_OMP_EDITOR is the override for when there genuinely is another.
VISUAL="${NHQ_OMP_EDITOR:-nhq-editor}"

# `true` is not an editor. omp hands its own children EDITOR=true and VISUAL=true
# so a subagent can never sit waiting on one, and if ompt is ever launched from
# inside that environment the value would ride into the tmux session — where git
# would take it, open nothing, and write empty commit messages without a word of
# complaint. Anything that is not a real editor falls back to vim.
case "${EDITOR:-}" in
	""|true|/bin/true|/usr/bin/true) EDITOR=vim ;;
esac

# Resolve to an absolute path while we still have this shell's PATH. The tmux
# pane will not have it: a pane runs its command with the SERVER's PATH, and
# ~/.local/bin is on it only because an interactive shell put it there. A bare
# name would be one more thing that works here and quietly fails on a rebuilt
# machine, which is the exact shape of bug this file already exists to document.
VISUAL="$(command -v "$VISUAL" 2>/dev/null || echo "$VISUAL")"
export VISUAL EDITOR

# Already inside tmux (or a plain kitty+tmux window)? Nothing to wrap.
if [[ -n "${TMUX:-}" ]]; then
	exec omp "$@"
fi

# ── who actually wants tmux ───────────────────────────────────────────────────
# Only the chat TUI. A subcommand (`omp usage`, `omp stats`, `omp commit`) or
# print mode runs, prints, and exits — and a tmux session dies with the command
# it was created for. So `omp usage` opened a pane, printed the whole quota
# report into it, and closed to "[exited]" before a line of it could be read.
# Those invocations belong in the caller's terminal, where their output stays.
#
# The command name is looked for in $1 only, because that is where omp itself
# looks: a first argument starting with `-`, or none at all, is the TUI. The
# exit-immediately FLAGS are a separate check since they can sit anywhere in
# the line (`omp -p "..."`, `omp --export ~/session.jsonl`).
#
# The list is read out of `omp --help` rather than frozen here, and cached
# against the binary's mtime, so an omp release that adds a subcommand cannot
# quietly bring the flash-and-exit back. First run after an upgrade pays ~1s;
# every run after that reads one small file.
omp_commands() {
	local bin stamp cache tmp first
	bin="$(command -v omp 2>/dev/null)" || return 1
	stamp="$(stat -c %Y "$bin" 2>/dev/null || echo 0)"
	cache="${XDG_CACHE_HOME:-$HOME/.cache}/nhq/omp-commands"

	if [[ -s $cache ]]; then
		read -r first <"$cache" || first=""
		if [[ $first == "$stamp" ]]; then
			tail -n +2 "$cache"
			return 0
		fi
	fi

	mkdir -p "${cache%/*}"
	tmp="$cache.$$"
	# The COMMANDS block ends at the first blank line. Reading past it picks up
	# the tool names further down the help text — `read`, `write`, `task` — and
	# those are not subcommands.
	{
		printf '%s\n' "$stamp"
		omp --help 2>/dev/null |
			awk '/^COMMANDS$/ {f = 1; next}
			     f && /^[[:space:]]*$/ {exit}
			     f && $1 ~ /^[a-z][a-z0-9-]+$/ {print $1}'
	} >"$tmp" || { rm -f "$tmp"; return 1; }

	# Only the stamp came back: omp answered with nothing usable.
	if [[ $(wc -l <"$tmp") -lt 2 ]]; then
		rm -f "$tmp"
		return 1
	fi
	mv -f "$tmp" "$cache"
	tail -n +2 "$cache"
}

wants_tmux() {
	local arg
	for arg in "$@"; do
		case "$arg" in
		-p | --print | -h | --help | --version | --export | --export=* | --alias | --alias=*)
			return 1
			;;
		esac
	done
	case "${1:-}" in
	"" | -*) return 0 ;;
	esac
	# Unreadable command list falls through to wrapping, which is what this
	# script did before the check existed.
	if omp_commands | grep -qxF -- "$1"; then
		return 1
	fi
	return 0
}

if ! wants_tmux "$@"; then
	exec omp "$@"
fi

# One session per directory, reattached if it already exists, so closing the
# Orca tab and reopening it lands back in the same conversation.
#
# -e is still needed even now that the variables are exported: a tmux pane
# inherits the SERVER's environment, not the client's, so exporting alone does
# not reach it. tmux.conf.local also puts both names on update-environment;
# passing them here means a fresh session is right even on a server whose
# config predates that line.
slug=$(basename "$PWD" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-\+$//')
exec tmux new-session -A -s "omp-${slug:-home}" \
	-e "VISUAL=$VISUAL" -e "EDITOR=$EDITOR" \
	omp "$@"
