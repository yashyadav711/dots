#!/usr/bin/env python3
"""nhq-vault-home-index — install/refresh the LIVE doc-index block in the nHQ vault Home.md.

The vault Home is the first thing Yash opens, so it must NEVER be stale. Earlier
this script wrote a STATIC snapshot of recent files between the
`<!-- DOC-INDEX:START ... DOC-INDEX:END -->` markers — which rotted the moment any
new note was written after session-start. It now emits a **Dataview live query**
instead: Dataview recomputes `file.mtime` every time Home is opened, so the index
can never be stale, needs no file-watcher daemon, and catches EVERY write source
(agent, Syncthing from other devices, manual). Requires the Dataview plugin
(installed + enabled). Idempotent — re-running just rewrites the same live query.

Usage: nhq-vault-home-index            # install/refresh the live block + print a summary
"""
import datetime
import os
from pathlib import Path

VAULT = Path(os.environ.get("NHQ_VAULT", "/home/yash/Obsidian/nHQ"))
HOME = VAULT / "Home.md"
RECENT_N = 40
EXCLUDE_TOP = {".obsidian", "_Read"}

def excluded(rel: Path) -> bool:
    parts = rel.parts
    return (bool(parts) and parts[0] in EXCLUDE_TOP) or ("nhq-kit" in parts) or rel.name == "Home.md"

def _dv_query(limit: int | None) -> str:
    """A Dataview DQL table of notes by mtime desc. limit=None -> full vault."""
    rows = [
        "```dataview",
        'TABLE WITHOUT ID file.link AS "Note", dateformat(file.mtime, "yyyy-MM-dd HH:mm") AS "Updated", file.folder AS "Folder"',
        'FROM ""',
        'WHERE file.name != "Home" AND !contains(file.folder, "_Read") AND !contains(file.folder, "nhq-kit")',
        "SORT file.mtime DESC",
    ]
    if limit is not None:
        rows.append(f"LIMIT {limit}")
    rows.append("```")
    return "\n".join(rows)

def main() -> None:
    # Count notes for the info badge (Dataview renders the actual list; this is just the count).
    docs = 0
    for p in VAULT.rglob("*.md"):
        if not excluded(p.relative_to(VAULT)):
            docs += 1
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")

    # ONE top-level live Dataview table. No callout/<details> wrapper — Dataview
    # does not reliably render inside those, and a top-level fence always does.
    lines = [
        "<!-- DOC-INDEX:START — auto-generated by nhq-vault-home-index; the block below is a LIVE Dataview query. Do not hand-edit between the markers. -->",
        "## 🗂️ Documents — by date (newest first)",
        "",
        f"> [!info] **LIVE index** (Dataview) — this list recomputes every time you open Home, so it is NEVER stale (catches agent writes, Syncthing, manual edits). ~{docs} notes · last wired {now}.",
        "",
        f"**🔥 {RECENT_N} most recently updated** — raise the `LIMIT` in the query to see more:",
        _dv_query(RECENT_N),
        "",
        "<!-- DOC-INDEX:END -->",
    ]
    block = "\n".join(lines)

    txt = HOME.read_text(encoding="utf-8")
    START, END = "<!-- DOC-INDEX:START", "<!-- DOC-INDEX:END -->"
    if START in txt and END in txt:
        pre = txt[: txt.index(START)]
        post = txt[txt.index(END) + len(END):].lstrip("\n")
        HOME.write_text(pre + block + "\n" + post, encoding="utf-8")
        where = "replaced existing block"
    else:  # markers gone — insert before the first "## " section, else append
        anchor = "\n## "
        i = txt.find(anchor)
        if i == -1:
            HOME.write_text(txt.rstrip() + "\n\n" + block + "\n", encoding="utf-8")
            where = "appended (no markers found)"
        else:
            HOME.write_text(txt[:i] + "\n" + block + "\n" + txt[i:], encoding="utf-8")
            where = "inserted (markers were missing)"
    print(f"nhq-vault-home-index: {where}; live Dataview index installed (~{docs} notes, top {RECENT_N} shown)")

if __name__ == "__main__":
    main()
