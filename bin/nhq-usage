#!/usr/bin/env python3
"""nhq-usage — live Claude (Anthropic Max) plan usage: % REMAINING.

Source of truth: Anthropic's own OAuth usage endpoint (the same data Claude
Code's /usage shows) — NOT a local-log estimate. Reads the OAuth access token
from ~/.claude/.credentials.json at runtime; the token is never printed, logged,
or written anywhere.

Modes:
  nhq-usage              human summary (5-hour + weekly, with resets)
  nhq-usage --segment    compact one-liner for a status bar: "claude 5h 96% · 7d 91%"
  nhq-usage --json       raw endpoint JSON
  nhq-usage --block      markdown block for Director replies

Caches the endpoint response for 60s (~/.cache/nhq-usage.json) so a status
segment refreshing every turn doesn't hammer the API.
"""
import json
import os
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone

CREDS = os.path.expanduser("~/.claude/.credentials.json")
CACHE = os.path.expanduser("~/.cache/nhq-usage.json")
ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
CACHE_TTL = 60  # seconds


def _token() -> str:
    with open(CREDS) as f:
        return json.load(f)["claudeAiOauth"]["accessToken"]


def fetch() -> dict:
    """Return usage JSON, using a <60s disk cache to avoid hammering the API."""
    try:
        st = os.stat(CACHE)
        if time.time() - st.st_mtime < CACHE_TTL:
            with open(CACHE) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass

    req = urllib.request.Request(
        ENDPOINT,
        headers={
            "Authorization": f"Bearer {_token()}",
            "anthropic-beta": "oauth-2025-04-20",
        },
    )
    with urllib.request.urlopen(req, timeout=8) as r:
        data = json.loads(r.read().decode())

    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, CACHE)
    except OSError:
        pass
    return data


def _rem(block: dict | None) -> float | None:
    if not block or block.get("utilization") is None:
        return None
    return round(100.0 - float(block["utilization"]))


def _reset_in(block: dict | None) -> str:
    if not block or not block.get("resets_at"):
        return ""
    try:
        t = datetime.fromisoformat(block["resets_at"])
        delta = t - datetime.now(timezone.utc)
        secs = int(delta.total_seconds())
        if secs <= 0:
            return "now"
        h, m = divmod(secs // 60, 60)
        d, h = divmod(h, 24)
        if d:
            return f"{d}d {h}h"
        if h:
            return f"{h}h {m}m"
        return f"{m}m"
    except ValueError:
        return ""


def segment(data: dict) -> str:
    f = _rem(data.get("five_hour"))
    w = _rem(data.get("seven_day"))
    parts = []
    if f is not None:
        parts.append(f"5h {f:.0f}%")
    if w is not None:
        parts.append(f"7d {w:.0f}%")
    return "claude " + " · ".join(parts) if parts else "claude usage n/a"


def human(data: dict) -> str:
    fh, sd = data.get("five_hour"), data.get("seven_day")
    op, so = data.get("seven_day_opus"), data.get("seven_day_sonnet")
    lines = ["Claude plan — usage remaining (official Anthropic endpoint)", ""]
    fr = _rem(fh)
    if fr is not None:
        lines.append(f"  5-hour window : {fr:.0f}% left  (used {fh['utilization']:.0f}%, resets in {_reset_in(fh)})")
    wr = _rem(sd)
    if wr is not None:
        lines.append(f"  weekly (7-day): {wr:.0f}% left  (used {sd['utilization']:.0f}%, resets in {_reset_in(sd)})")
    if op and op.get("utilization") is not None:
        lines.append(f"    └ weekly Opus  : {_rem(op):.0f}% left")
    if so and so.get("utilization") is not None:
        lines.append(f"    └ weekly Sonnet: {_rem(so):.0f}% left")
    return "\n".join(lines)


def block(data: dict) -> str:
    fr, wr = _rem(data.get("five_hour")), _rem(data.get("seven_day"))
    fh, sd = data.get("five_hour"), data.get("seven_day")
    rows = ["| Window | Remaining | Resets in |", "|---|---|---|"]
    if fr is not None:
        rows.append(f"| 5-hour | **{fr:.0f}%** | {_reset_in(fh)} |")
    if wr is not None:
        rows.append(f"| Weekly | **{wr:.0f}%** | {_reset_in(sd)} |")
    return "\n".join(rows)


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        data = fetch()
    except urllib.error.HTTPError as e:
        msg = "claude usage: auth expired" if e.code == 401 else f"claude usage: http {e.code}"
        print(msg if mode == "--segment" else f"nhq-usage: {msg}", file=sys.stderr if mode != "--segment" else sys.stdout)
        return 0 if mode == "--segment" else 1
    except Exception as e:  # noqa: BLE001 - network/parse, degrade gracefully
        print("claude usage n/a" if mode == "--segment" else f"nhq-usage: {e}",
              file=sys.stdout if mode == "--segment" else sys.stderr)
        return 0 if mode == "--segment" else 1

    if mode == "--json":
        print(json.dumps(data, indent=2))
    elif mode == "--segment":
        print(segment(data))
    elif mode == "--block":
        print(block(data))
    else:
        print(human(data))
    return 0


if __name__ == "__main__":
    sys.exit(main())
