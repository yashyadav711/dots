#!/usr/bin/env bash
# nhq — the single entry point for every NHQ command: `nhq <subcommand> [args…]`.
#
# Consistent command structure (Yash 2026-07-19): every nhq capability is invoked
# as `nhq <sub>` and dispatches to the `nhq-<sub>` script in ~/.local/bin. The
# old per-script names (nhq-status, nhq-prep, …) keep working — this is a
# dispatcher, not a rename. Discovery stays automatic: new nhq-<sub> scripts
# appear as subcommands with zero registry.
#
#   nhq                    # launch the MAIN SEAT: omp on claude-opus-4-8 (agy workers)
#   nhq status             # fleet overview
#   nhq help [filter]      # list all subcommands (nhq-help)
#   nhq status             # fleet state        (nhq-status)
#   nhq spawn <agent> "…"  # spawn fleet agent  (nhq-spawn — omp/tmux path)
#   nhq jfleet spawn …     # jcode-native fleet (nhq-jfleet spawn/tell/status/…)
#   nhq ask <agent> "…"    # one-shot ask       (nhq-ask)
#   nhq prep <target>      # graphify+okf spine (nhq-prep)
#   nhq okf build <repo>   # knowledge layer    (nhq-okf)
#   nhq seat               # main-seat advice   (nhq-seat)
#   nhq omp-seat […]       # legacy omp Opus seat launcher (was plain `nhq`)
#
# Exit codes pass through from the dispatched script.
set -uo pipefail

BIN_DIR="$HOME/.local/bin"

if [[ $# -eq 0 ]]; then
  # Bare `nhq` = the main seat: omp on Claude Opus 4.8 (fleet workers on the free agy pool).
  # Reverted from jcode 2026-07-28 — jcode stays installed (steal audit); launch it
  # explicitly via the -j aliases (envy-j / heydaddy-j) if ever needed.
  exec "$HOME/.local/bin/nhq-omp-seat"
fi

SUB="$1"; shift

# `nhq help` → nhq-help; `nhq <sub>` → nhq-<sub>.
TARGET="$BIN_DIR/nhq-$SUB"
if [[ -x "$TARGET" ]]; then
  exec "$TARGET" "$@"
fi

echo "nhq: unknown subcommand '$SUB'" >&2
echo "closest matches:" >&2
ls "$BIN_DIR" | grep -E "^nhq-" | sed 's/^nhq-/  /' | grep -i -- "${SUB:0:4}" >&2 || true
echo "run 'nhq help' for the full list" >&2
exit 2
